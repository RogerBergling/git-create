class App:
    def __init__(self, dry_run: bool = False) -> None:
        # The current directory is the source of truth. This makes the tool
        # automatic when it is copied into a project root and run from there.
        # It also avoids silently selecting the tool's own repository when the
        # script is installed elsewhere and started from an unrelated folder.
        self.project = detect_git_root(Path.cwd())
        self.dry_run = dry_run

    def run_action(
        self,
        command: Sequence[object],
        cwd: Optional[Path] = None,
        timeout: int = 30,
        env_extra: Optional[Dict[str, str]] = None,
    ) -> CmdResult:
        if self.dry_run:
            info("DRY RUN: command not executed: " + shlex.join([str(item) for item in command]))
            return CmdResult([str(item) for item in command], 0, "", "")
        return run_cmd(command, cwd=cwd, timeout=timeout, env_extra=env_extra)

    # -- menu ---------------------------------------------------------------

    def run(self) -> int:
        print()
        print(col(f"{APP} {VERSION}", "bold") + col(" - safe Git/GitHub project assistant", "dim"))
        if self.project:
            print("Active project: " + col(str(self.project), "cyan"))
        else:
            print(col("No Git repository detected in the current directory.", "yellow"))
        print(col("New to Git? Option 12 explains the concepts, commands, and why they are used.", "dim"))
        print_quick_check(self.project)
        while True:
            try:
                self.refresh_project()
                self.print_menu()
                choice = ask("Choose an option", default="0", allow_empty=True)
                if choice in ("0", "q", "quit", "exit"):
                    print("Bye.")
                    return 0
                actions = {
                    "1": self.verify_current,
                    "2": self.scan_action,
                    "3": self.select_project,
                    "4": self.scenario_a,
                    "5": self.scenario_b,
                    "6": self.scenario_c,
                    "7": self.scenario_d,
                    "8": self.commit_and_push_action,
                    "9": self.rename_action,
                    "10": self.settings_action,
                    "11": self.files_action,
                    "12": self.help_action,
                    "13": self.history_secrets_action,
                    "14": self.branches_action,
                    "15": self.revert_action,
                    "16": self.docker_action,
                    "17": self.stash_action,
                    "18": self.merge_rebase_action,
                    "19": self.tags_action,
                    "20": self.inspector_action,
                    "21": self.github_collab_action,
                    "22": self.remotes_action,
                    "23": self.worktrees_action,
                    "24": self.toggle_dry_run,
                }
                action = actions.get(choice)
                if action is None:
                    warning("Unknown option.")
                else:
                    action()
            except KeyboardInterrupt:
                print("\nCancelled.")
                continue
            except EOFError:
                print("\nInput closed; exiting.")
                return 0

    def toggle_dry_run(self) -> None:
        self.dry_run = not self.dry_run
        if self.dry_run:
            warning("Dry-run mode ON: worktree, submodule, remote, and backup-cleanup changes will only be shown.")
        else:
            success("Dry-run mode OFF: commands will execute after confirmation.")

    def refresh_project(self) -> None:
        if self.project is None:
            return
        root = detect_git_root(self.project)
        if root is None:
            warning(f"Active project is no longer a Git repository: {self.project}")
            self.project = None
        else:
            self.project = root

    def project_summary(self) -> str:
        if not self.project:
            return "none"
        branch = git_out(self.project, "symbolic-ref", "--short", "-q", "HEAD") or "detached"
        entries = status_entries(self.project)
        state = "clean" if not entries else f"{len(entries)} change(s)"
        return f"{self.project} ({branch}, {state})"

