def detect_git_root(path: Path) -> Optional[Path]:
    try:
        candidate = path.expanduser()
        if candidate.is_file():
            candidate = candidate.parent
        if not candidate.exists():
            return None
    except OSError:
        return None
    result = run_cmd(["git", "-C", str(candidate), "rev-parse", "--show-toplevel"], timeout=10)
    if result.returncode != 0:
        return None
    value = result.out.strip()
    return Path(value).resolve() if value else None


def git_path(root: Path, name: str) -> Path:
    result = git(root, "rev-parse", "--git-path", name, timeout=10)
    if result.returncode != 0 or not result.out.strip():
        return root / ".git" / name
    path = Path(result.out.strip())
    return path if path.is_absolute() else root / path


def is_linked_worktree(root: Path) -> bool:
    git_dir = git_out(root, "rev-parse", "--absolute-git-dir")
    common_dir = git_out(root, "rev-parse", "--git-common-dir")
    if not git_dir or not common_dir:
        return False
    common_path = Path(common_dir)
    if not common_path.is_absolute():
        common_path = root / common_path
    try:
        return Path(git_dir).resolve() != common_path.resolve()
    except OSError:
        return False


def git_operation_kind(root: Path) -> Optional[str]:
    if git_path(root, "MERGE_HEAD").exists():
        return "merge"
    if git_path(root, "rebase-merge").exists() or git_path(root, "rebase-apply").exists():
        return "rebase"
    return None


def shared_commit_in_range(root: Path, target: str, max_commits: int = 200) -> Tuple[Optional[str], int]:
    result = git(root, "rev-list", f"{target}..HEAD", timeout=30)
    if result.returncode != 0:
        return None, 0
    commits = [line.strip() for line in result.out.splitlines() if line.strip()]
    if len(commits) > max_commits:
        return "LIMIT", len(commits)
    for commit in commits:
        refs = git(
            root,
            "for-each-ref",
            "--contains",
            commit,
            "--format=%(refname)",
            "refs/remotes",
            "refs/tags",
            timeout=15,
        )
        if refs.returncode == 0 and refs.out.strip():
            return commit, len(commits)
    return None, len(commits)


def in_progress_operations(root: Path) -> List[str]:
    markers = [
        ("MERGE_HEAD", "merge in progress"),
        ("CHERRY_PICK_HEAD", "cherry-pick in progress"),
        ("REVERT_HEAD", "revert in progress"),
        ("BISECT_LOG", "bisect in progress"),
        ("rebase-merge", "rebase in progress"),
        ("rebase-apply", "rebase/am in progress"),
    ]
    operations = []
    for name, label in markers:
        if git_path(root, name).exists():
            operations.append(label)
    return operations


@dataclass
class StatusEntry:
    code: str
    path: str
    original: Optional[str] = None

    @property
    def display(self) -> str:
        if self.original:
            return f"{self.code} {self.original} -> {self.path}"
        return f"{self.code} {self.path}"

    @property
    def stage_paths(self) -> List[str]:
        paths = [self.path]
        if self.original:
            paths.append(self.original)
        return paths


def status_entries(root: Path) -> List[StatusEntry]:
    result = git(root, "status", "--porcelain=v1", "-z", timeout=20)
    if result.returncode != 0:
        return []
    parts = result.out.split("\0")
    entries: List[StatusEntry] = []
    index = 0
    while index < len(parts):
        item = parts[index]
        index += 1
        if not item or len(item) < 4:
            continue
        code = item[:2]
        path = item[3:]
        original = None
        if code[0] in ("R", "C") and index < len(parts):
            original = parts[index]
            index += 1
        entries.append(StatusEntry(code, path, original))
    return entries


def status_counts(entries: Sequence[StatusEntry]) -> Dict[str, int]:
    counts = {"staged": 0, "unstaged": 0, "untracked": 0, "conflicts": 0}
    for entry in entries:
        code = entry.code
        if code == "??":
            counts["untracked"] += 1
            continue
        if code[0] not in (" ", "?"):
            counts["staged"] += 1
        if code[1] not in (" ", "?"):
            counts["unstaged"] += 1
        if code[0] == "U" or code[1] == "U" or code in ("AA", "DD"):
            counts["conflicts"] += 1
    return counts


def tracked_files(root: Path) -> List[str]:
    result = git(root, "ls-files", "-z", timeout=20)
    if result.returncode != 0:
        return []
    return [item for item in result.out.split("\0") if item]


def untracked_files(root: Path) -> List[str]:
    result = git(root, "ls-files", "--others", "--exclude-standard", "-z", timeout=20)
    if result.returncode != 0:
        return []
    return [item for item in result.out.split("\0") if item]


def effective_identity(root: Path) -> Tuple[str, str]:
    return (
        git_out(root, "config", "--get", "user.name"),
        git_out(root, "config", "--get", "user.email"),
    )


def identity_ready(root: Path) -> bool:
    name, email = effective_identity(root)
    if name and email and EMAIL_RE.match(email):
        return True
    failure("Git identity is not configured for this repository.")
    print("  Set it globally (option 10) or locally:")
    print('    git config --global user.name "Your Name"')
    print('    git config --global user.email "you@example.com"')
    return False


def remote_urls(root: Path) -> Dict[str, str]:
    names = [line.strip() for line in git_out(root, "remote").splitlines() if line.strip()]
    remotes: Dict[str, str] = {}
    for name in names:
        url = git_out(root, "remote", "get-url", name)
        if url:
            remotes[name] = url
    return remotes


def local_branch_names(root: Path) -> List[str]:
    result = git(root, "branch", "--format=%(refname:short)", timeout=15)
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.out.splitlines() if line.strip()]


def remote_branch_names(root: Path) -> List[str]:
    result = git(root, "branch", "-r", "--format=%(refname:short)", timeout=15)
    if result.returncode != 0:
        return []
    return [
        line.strip()
        for line in result.out.splitlines()
        if line.strip() and "/" in line.strip() and not line.strip().endswith("/HEAD")
    ]


def valid_branch_name(root: Path, name: str) -> bool:
    if not name or name.startswith("-"):
        return False
    result = git(root, "check-ref-format", "--branch", name, timeout=10)
    return result.returncode == 0


def tag_names(root: Path) -> List[str]:
    result = git(root, "tag", "--list", "--sort=-creatordate", timeout=15)
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.out.splitlines() if line.strip()]


def valid_tag_name(root: Path, name: str) -> bool:
    if not name or name.startswith("-"):
        return False
    result = git(root, "check-ref-format", f"refs/tags/{name}", timeout=10)
    return result.returncode == 0


def remote_default_branch(root: Path) -> Optional[str]:
    value = git_out(root, "symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD")
    if value and "/" in value:
        return value.split("/", 1)[1]
    return None


def unique_suffix() -> str:
    """Return a timestamp plus random suffix so backups never collide."""
    return f"{time.strftime('%Y%m%d-%H%M%S')}-{secrets.token_hex(3)}"


def create_backup_ref(root: Path, label: str, revision: str = "HEAD") -> Optional[str]:
    sha = git_out(root, "rev-parse", revision)
    if not sha:
        return None
    safe_label = re.sub(r"[^A-Za-z0-9._/-]+", "-", label).strip("-") or "backup"
    ref = f"refs/git-create-backups/{safe_label}-{unique_suffix()}"
    result = git(root, "update-ref", ref, sha, timeout=10)
    return ref if result.returncode == 0 else None


def create_worktree_backup(root: Path, label: str = "working-tree") -> Optional[Path]:
    git_dir_raw = git_out(root, "rev-parse", "--git-dir")
    if not git_dir_raw:
        return None
    git_dir = Path(git_dir_raw)
    if not git_dir.is_absolute():
        git_dir = root / git_dir
    backup_dir = git_dir / "git-create-backups"
    try:
        backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(backup_dir, 0o700)
    except OSError:
        return None
    patch = backup_dir / f"{label}-{unique_suffix()}.patch"
    result = git(root, "diff", "--binary", "--no-color", "--", timeout=30)
    if result.returncode != 0:
        return None
    if not write_exclusive_text(patch, result.out, 0o600):
        return None
    return patch


def check_remote_access(root: Path) -> Tuple[bool, Optional[str], str]:
    if "origin" not in remote_urls(root):
        return False, None, "no origin remote"
    result = git(root, "ls-remote", "--symref", "origin", "HEAD", timeout=20, env_extra=remote_env())
    if result.returncode != 0:
        return False, None, one_line(result.err or result.out, 240)
    default_branch = None
    for line in result.out.splitlines():
        match = re.match(r"ref:\s+refs/heads/(\S+)\s+HEAD", line)
        if match:
            default_branch = match.group(1)
            break
    return True, default_branch, ""


def is_sensitive_name(path: str) -> bool:
    name = Path(path).name.lower()
    if name in (".env.example", ".env.sample", ".env.template"):
        return False
    if name == ".env" or name.startswith(".env."):
        return True
    for pattern in SENSITIVE_NAME_PATTERNS:
        if pattern.startswith(".env"):
            continue
        if fnmatch.fnmatch(name, pattern.lower()):
            return True
    return False


def scan_bytes_for_secrets(data: bytes, max_findings: int = 50) -> Tuple[List[Tuple[int, str, bool]], bool]:
    """Return (line, kind, high_risk) hits for a byte string."""
    findings: List[Tuple[int, str, bool]] = []
    if b"\0" in data[:8192]:
        return findings, False
    for line_number, line in enumerate(data.splitlines(), 1):
        for pattern, kind, high_risk in CONTENT_PATTERNS:
            if pattern.search(line):
                findings.append((line_number, kind, high_risk))
                if len(findings) >= max_findings:
                    return findings, True
                break
    return findings, False


def scan_secret_content(
    root: Path,
    paths: Sequence[str],
    max_files: int = 2500,
    max_bytes: int = 12 * 1024 * 1024,
) -> Tuple[List[Tuple[str, int, str, bool]], bool]:
    findings: List[Tuple[str, int, str, bool]] = []
    total = 0
    scanned = 0
    truncated = False
    for relative in paths:
        if scanned >= max_files or total >= max_bytes:
            truncated = True
            break
        rel_path = Path(relative)
        if rel_path.name in SKIP_CONTENT_SCAN:
            continue
        absolute = root / rel_path
        try:
            if absolute.is_symlink() or not absolute.is_file():
                continue
            size = absolute.stat().st_size
        except OSError:
            continue
        if size == 0 or size > 1024 * 1024 or size > max_bytes - total:
            continue
        try:
            data = absolute.read_bytes()
        except OSError:
            continue
        scanned += 1
        total += len(data)
        hits, hit_truncated = scan_bytes_for_secrets(data, max_findings=max(1, 50 - len(findings)))
        for line_number, kind, high_risk in hits:
            findings.append((relative, line_number, kind, high_risk))
        if hit_truncated or len(findings) >= 50:
            return findings, True
    return findings, truncated


def scan_history_secrets(
    root: Path,
    max_commits: int = 500,
    max_blobs: int = 2000,
    max_bytes: int = 64 * 1024 * 1024,
) -> Dict[str, object]:
    """Scan unique blobs reachable from all refs for common secret patterns."""
    max_commits = max(1, min(max_commits, 10000))
    max_blobs = max(1, min(max_blobs, 20000))
    total_commits_result = git(root, "rev-list", "--all", "--count", timeout=30)
    try:
        total_commits = int(total_commits_result.out.strip()) if total_commits_result.returncode == 0 else 0
    except ValueError:
        total_commits = 0
    commits_result = git(root, "rev-list", "--all", "--max-count", str(max_commits), timeout=60)
    commits = [line for line in commits_result.out.splitlines() if line.strip()] if commits_result.returncode == 0 else []

    blob_paths: Dict[str, str] = {}
    for commit in commits:
        tree_result = git(root, "ls-tree", "-r", "-z", commit, timeout=60)
        if tree_result.returncode != 0:
            continue
        for item in tree_result.out.split("\0"):
            if not item:
                continue
            meta, separator, path = item.partition("\t")
            if not separator:
                continue
            parts = meta.split()
            if len(parts) != 3 or parts[1] != "blob":
                continue
            blob_paths.setdefault(parts[2], path)

    total_blobs = len(blob_paths)
    truncated = total_commits > len(commits) or total_blobs > max_blobs
    findings: List[Dict[str, object]] = []
    total = 0
    scanned = 0
    for oid, path in list(blob_paths.items())[:max_blobs]:
        if total >= max_bytes or len(findings) >= 50:
            truncated = True
            break
        if is_sensitive_name(path):
            findings.append(
                {
                    "path": path,
                    "line": 0,
                    "kind": "sensitive filename",
                    "high_risk": True,
                    "object": oid[:12],
                }
            )
            continue
        size_result = git(root, "cat-file", "-s", oid, timeout=15)
        try:
            size = int(size_result.out.strip()) if size_result.returncode == 0 else -1
        except ValueError:
            size = -1
        if size <= 0 or size > 2 * 1024 * 1024 or size > max_bytes - total:
            if size > 2 * 1024 * 1024:
                truncated = True
            continue
        data = run_cmd_bytes(["git", "-C", str(root), "cat-file", "-p", oid], timeout=30)
        if data is None:
            continue
        scanned += 1
        total += len(data)
        hits, hit_truncated = scan_bytes_for_secrets(data, max_findings=max(1, 50 - len(findings)))
        for line_number, kind, high_risk in hits:
            findings.append(
                {
                    "path": path,
                    "line": line_number,
                    "kind": kind,
                    "high_risk": high_risk,
                    "object": oid[:12],
                }
            )
        if hit_truncated or len(findings) >= 50:
            truncated = True
            break

    return {
        "commits_total": total_commits,
        "commits_scanned": len(commits),
        "blobs_total": total_blobs,
        "blobs_scanned": scanned,
        "bytes_scanned": total,
        "max_commits": max_commits,
        "max_blobs": max_blobs,
        "truncated": truncated,
        "findings": findings,
    }


def large_tracked_files(root: Path, paths: Sequence[str]) -> List[Tuple[str, int]]:
    files: List[Tuple[str, int]] = []
    for relative in paths:
        absolute = root / relative
        try:
            if absolute.is_symlink() or not absolute.is_file():
                continue
            files.append((relative, absolute.stat().st_size))
        except OSError:
            continue
    files.sort(key=lambda item: item[1], reverse=True)
    return files


def format_size(size: int) -> str:
    value = float(size)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if value < 1024 or unit == "GiB":
            return f"{value:.1f} {unit}" if unit != "B" else f"{int(value)} B"
        value /= 1024
    return f"{size} B"


def find_readme(root: Path) -> Optional[Path]:
    try:
        for item in root.iterdir():
            if item.is_file() and item.name.lower().startswith("readme"):
                return item
    except OSError:
        return None
    return None


def find_license(root: Path) -> Optional[Path]:
    try:
        for item in root.iterdir():
            if item.is_file() and (
                item.name.upper().startswith("LICENSE") or item.name.upper().startswith("COPYING")
            ):
                return item
    except OSError:
        return None
    return None


def dockerfile_present(root: Path) -> bool:
    try:
        for item in root.iterdir():
            if item.is_file() and (
                item.name.lower().startswith("dockerfile") or item.name.lower().endswith(".dockerfile")
            ):
                return True
    except OSError:
        return False
    return False


def read_text(path: Path, limit: int = 512 * 1024) -> str:
    try:
        data = path.read_bytes()[:limit]
        return data.decode("utf-8", "replace")
    except OSError:
        return ""


def pattern_matches(pattern: str, candidate: str) -> bool:
    normalized = pattern.strip()
    if not normalized:
        return False
    normalized = normalized.lstrip("/")
    if normalized.endswith("/"):
        normalized += "**"
    if "/" in normalized:
        return fnmatch.fnmatch(candidate, normalized) or fnmatch.fnmatch(
            candidate, normalized.rstrip("/") + "/*"
        )
    return fnmatch.fnmatch(Path(candidate).name, normalized) or fnmatch.fnmatch(candidate, normalized)


def text_ignored_by_gitignore(root: Path, candidate: str) -> bool:
    path = root / ".gitignore"
    if not path.exists():
        return False
    ignored = False
    for raw in read_text(path).splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        negated = line.startswith("!")
        if negated:
            line = line[1:].strip()
        if pattern_matches(line, candidate):
            ignored = not negated
    return ignored


def is_ignored(root: Path, candidate: str) -> bool:
    result = git(root, "check-ignore", "--no-index", "-q", "--", candidate, timeout=10)
    if result.returncode in (0, 1):
        return result.returncode == 0
    return text_ignored_by_gitignore(root, candidate)


def gitignore_missing(root: Path) -> List[str]:
    if not (root / ".gitignore").exists():
        return [pattern for pattern, _ in GITIGNORE_REQUIRED]
    missing = []
    for pattern, test_path in GITIGNORE_REQUIRED:
        if not is_ignored(root, test_path):
            missing.append(pattern)
    return missing


DOCKERIGNORE_REQUIRED = [
    (".git/config", ".git"),
    (".env", ".env"),
    ("node_modules/x", "node_modules"),
    (".venv/x", ".venv"),
    ("secret.pem", "*.pem"),
    ("secret.key", "*.key"),
]


def dockerignore_missing(root: Path) -> List[str]:
    path = root / ".dockerignore"
    if not path.exists():
        return [pattern for _, pattern in DOCKERIGNORE_REQUIRED]
    text = read_text(path)
    return [pattern for candidate, pattern in DOCKERIGNORE_REQUIRED if not dockerignore_covers(text, candidate)]


def dockerignore_covers(text: str, candidate: str) -> bool:
    matched = False
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        negated = line.startswith("!")
        if negated:
            line = line[1:].strip()
        if not line:
            continue
        line = line.lstrip("/")
        patterns = [line]
        if line.endswith("/"):
            patterns.append(line.rstrip("/") + "/*")
            patterns.append(line.rstrip("/") + "/**")
        hit = any(pattern_matches(pattern, candidate) for pattern in patterns)
        if not hit:
            directory = line.rstrip("/")
            hit = candidate == directory or candidate.startswith(directory + "/")
        if hit:
            matched = not negated
    return matched


