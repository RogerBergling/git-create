                    if not backup:
                        failure("Could not create a backup patch; pop cancelled.")
                        continue
                    info(f"Backup patch: {backup}")
                command = ["git", "stash", "apply" if choice == "4" else "pop", ref]
                explain(
                    f"Runs {'git stash apply' if choice == '4' else 'git stash pop'} {ref}.",
                    "Apply restores the changes and keeps the stash. Pop restores them and "
                    "drops the stash only if applying succeeds.",
                    "Conflicts leave the operation in your working tree. The stash is not "
                    "discarded on a failed pop.",
                )
                print("Command: " + col(shlex.join(command), "dim"))
                if not confirm("Restore this stash?", True):
                    continue
                result = run_cmd(command, cwd=path, timeout=60)
                if result.combined:
                    print(result.combined)
                if result.returncode == 0:
                    success("Stash restored.")
                else:
                    failure("Stash restore did not complete; check git status for conflicts.")
            elif choice == "6":
                ref = resolve_stash_ref(ask("Stash number or stash@{N}", default="0"))
                if not ref:
                    failure("Invalid stash reference.")
                    continue
                backup = create_stash_backup(path, ref, "stash-drop")
                if not backup:
                    failure("Could not create a backup patch; stash drop cancelled.")
                    continue
                info(f"Backup patch: {backup}")
                explain(
                    f"Runs git stash drop {ref}. This removes the stash entry from the local stack.",
                    "The backup patch preserves the diff so you can re-apply it with git apply. "
                    "The operation is local and does not touch remotes.",
                    "A typed confirmation is required.",
                )
                phrase = "DROP STASH"
                typed = ask(f'Type "{phrase}" to drop {ref}', allow_empty=True)
                if typed != phrase:
                    info("Stash drop cancelled.")
                    continue
                result = run_cmd(["git", "stash", "drop", ref], cwd=path, timeout=30)
                if result.combined:
                    print(result.combined)
                if result.returncode == 0:
                    success("Stash dropped; backup patch was kept.")
                else:
                    failure("Stash drop failed.")
            else:
                warning("Unknown option.")

