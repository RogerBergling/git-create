@dataclass
class CmdResult:
    args: List[str]
    returncode: int
    out: str
    err: str
    timed_out: bool = False

    @property
    def combined(self) -> str:
        return (self.out + ("\n" if self.out and self.err else "") + self.err).strip()


def run_cmd(
    args: Sequence[object],
    cwd: Optional[Path] = None,
    timeout: int = 30,
    env_extra: Optional[Dict[str, str]] = None,
    input_text: Optional[str] = None,
) -> CmdResult:
    cmd = [str(arg) for arg in args]
    env = os.environ.copy()
    env.setdefault("GIT_TERMINAL_PROMPT", "0")
    if env_extra:
        env.update(env_extra)
    try:
        result = subprocess.run(
            cmd,
            cwd=str(cwd) if cwd else None,
            env=env,
            input=input_text,
            stdin=None if input_text is not None else subprocess.DEVNULL,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=timeout,
        )
        return CmdResult(cmd, result.returncode, result.stdout or "", result.stderr or "")
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout or ""
        err = exc.stderr or ""
        if isinstance(out, bytes):
            out = out.decode("utf-8", "replace")
        if isinstance(err, bytes):
            err = err.decode("utf-8", "replace")
        return CmdResult(cmd, 124, out, (err + "\ncommand timed out").strip(), True)
    except FileNotFoundError:
        return CmdResult(cmd, 127, "", f"command not found: {cmd[0]}")
    except OSError as exc:
        return CmdResult(cmd, 126, "", str(exc))


def run_interactive(args: Sequence[object], cwd: Optional[Path] = None) -> int:
    cmd = [str(arg) for arg in args]
    try:
        return subprocess.run(cmd, cwd=str(cwd) if cwd else None, env=os.environ.copy()).returncode
    except FileNotFoundError:
        failure(f"Command not found: {cmd[0]}")
        return 127
    except OSError as exc:
        failure(str(exc))
        return 126


def git(path: Path, *args: object, timeout: int = 30, env_extra: Optional[Dict[str, str]] = None) -> CmdResult:
    return run_cmd(["git", "-C", str(path), *args], timeout=timeout, env_extra=env_extra)


def git_out(path: Path, *args: object) -> str:
    result = git(path, *args)
    return result.out.strip() if result.returncode == 0 else ""


def remote_env() -> Dict[str, str]:
    ssh_command = os.environ.get("GIT_SSH_COMMAND", "ssh")
    return {"GIT_SSH_COMMAND": f"{ssh_command} -o BatchMode=yes -o ConnectTimeout=10"}


