def cli_check(args: argparse.Namespace) -> int:
    path = ask_path_from_arg(args.path)
    root = detect_git_root(path)
    if root is None:
        message = f"Not a Git repository: {path}"
        if args.json:
            print(json.dumps({"error": message}, indent=2))
        else:
            failure(message)
        return 2
    config = read_global_config()
    report = combined_report(root, deep=not args.offline, scan_content=True, config=config)
    report.meta.update(
        {
            "command": "check",
            "path": str(root),
            "offline": bool(args.offline),
            "strict": bool(args.strict),
        }
    )
    if args.json:
        print(json.dumps(report.as_dict(), indent=2, ensure_ascii=False))
    else:
        print_report(report)
    if report.has_failures():
        return 1
    if args.strict and any(check.level == "WARN" for check in report.checks()):
        return 1
    return 0


def collect_github_audit(root: Path) -> Dict[str, object]:
    parsed = parse_github_url(remote_urls(root).get("origin", ""))
    if not parsed:
        return {"error": "No GitHub origin remote found"}
    owner, repo = parsed
    branch = git_out(root, "symbolic-ref", "--short", "-q", "HEAD")
    if not branch:
        return {"error": "Detached HEAD"}
    gh = which_gh()
    if not gh:
        return {"error": "gh is not installed", "owner": owner, "repo": repo, "branch": branch}
    endpoint = f"repos/{owner}/{repo}/branches/{quote(branch, safe='')}/protection"
    protection = run_cmd([gh, "api", endpoint], cwd=root, timeout=60)
    secrets_result = run_cmd(
        [gh, "api", f"repos/{owner}/{repo}/actions/secrets", "--jq", ".secrets[].name"],
        cwd=root,
        timeout=60,
    )
    runs_result = run_cmd(
        [gh, "run", "list", "--limit", "10", "--json", "databaseId,status,conclusion,displayTitle,workflowName,url"],
        cwd=root,
        timeout=60,
    )
    ghcr_result = run_cmd(
        [gh, "run", "list", "--workflow", "ghcr.yml", "--limit", "5", "--json", "databaseId,status,conclusion,displayTitle,url"],
        cwd=root,
        timeout=60,
    )
    def parse_json(result: CmdResult) -> object:
        if result.returncode != 0:
            return None
        try:
            return json.loads(result.out)
        except json.JSONDecodeError:
            return None
    return {
        "owner": owner,
        "repo": repo,
        "branch": branch,
        "branch_protection": parse_json(protection) if protection.returncode == 0 else None,
        "branch_protection_error": None if protection.returncode == 0 else one_line(protection.combined, 200),
        "actions_secret_names": [
            line for line in secrets_result.out.splitlines() if line.strip()
        ] if secrets_result.returncode == 0 else [],
        "actions_secrets_error": None if secrets_result.returncode == 0 else one_line(secrets_result.combined, 200),
        "workflow_runs": parse_json(runs_result) or [],
        "ghcr_runs": parse_json(ghcr_result) or [],
    }


def cli_audit(args: argparse.Namespace) -> int:
    path = ask_path_from_arg(args.path)
    root = detect_git_root(path)
    if root is None:
        message = f"Not a Git repository: {path}"
        if args.json:
            print(json.dumps({"error": message}, indent=2))
        else:
            failure(message)
        return 2
    data = collect_github_audit(root)
    data.update({"app": APP, "version": VERSION, "path": str(root)})
    error = data.get("error")
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 1 if error else 0
    else:
        heading(f"GitHub audit: {root}")
        if error:
            failure(str(error))
            return 1
        print(f"  Repository: {data['owner']}/{data['repo']}  Branch: {data['branch']}")
        if data["branch_protection"] is not None:
            success("Branch protection is enabled.")
        else:
            warning("Branch protection is not readable or not enabled.")
            info(str(data["branch_protection_error"] or "unknown error"))
        if data["actions_secret_names"]:
            info("Actions secret names: " + ", ".join(data["actions_secret_names"]))
        elif data["actions_secrets_error"]:
            warning("Could not read Actions secret names: " + str(data["actions_secrets_error"]))
        else:
            info("No Actions repository secrets found.")
        runs = data["workflow_runs"]
        print(f"  Recent workflow runs: {len(runs) if isinstance(runs, list) else 0}")
        ghcr = data["ghcr_runs"]
        print(f"  GHCR workflow runs: {len(ghcr) if isinstance(ghcr, list) else 0}")
    return 0


def cli_info(args: argparse.Namespace) -> int:
    path = ask_path_from_arg(args.path)
    root = detect_git_root(path)
    if root is None:
