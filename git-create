def gh_auth_status() -> Tuple[bool, Optional[str], str]:
    gh = which_gh()
    if not gh:
        return False, None, "gh is not installed"
    result = run_cmd([gh, "auth", "status", "--hostname", "github.com"], timeout=12)
    text = result.combined
    match = re.search(r"account\s+([^\s(]+)", text)
    account = match.group(1) if match else None
    return result.returncode == 0, account, text


def fetch_github_signing_keys() -> Tuple[Optional[List[dict]], str]:
    gh = which_gh()
    if not gh:
        return None, "gh is not installed"
    result = run_cmd([gh, "api", "user/ssh_signing_keys"], timeout=20)
    if result.returncode != 0:
        return None, one_line(result.combined, 240)
    try:
        data = json.loads(result.out)
    except json.JSONDecodeError as exc:
        return None, f"could not parse GitHub response: {exc}"
    if not isinstance(data, list):
        return None, "unexpected GitHub response"
    return [item for item in data if isinstance(item, dict)], ""


def gh_repo_info(root: Path) -> Tuple[Optional[dict], str]:
    gh = which_gh()
    if not gh:
        return None, "gh is not installed"
    result = run_cmd(
        [gh, "repo", "view", "--json", "nameWithOwner,visibility,defaultBranchRef,url"],
        cwd=root,
        timeout=20,
    )
    if result.returncode != 0:
        return None, one_line(result.combined, 240)
    try:
        data = json.loads(result.out)
    except json.JSONDecodeError as exc:
        return None, f"could not parse gh response: {exc}"
    return data if isinstance(data, dict) else None, ""


def parse_github_url(url: str) -> Optional[Tuple[str, str]]:
    clean = url.strip().rstrip("/")
    if clean.endswith(".git"):
        clean = clean[:-4]
    match = re.match(r"^git@github\.com:([^/]+)/([^/]+)$", clean)
    if match:
        return match.group(1), match.group(2)
    match = re.match(r"^(?:https?|ssh)://(?:[^@/]+@)?github\.com/([^/]+)/([^/]+)$", clean)
    if match:
        return match.group(1), match.group(2)
    return None


def ensure_gh(require_auth: bool = True, offer_login: bool = True) -> bool:
    gh = which_gh()
    if not gh:
        failure("GitHub CLI 'gh' is not installed.")
        info("Install it from https://cli.github.com/ and run: gh auth login --hostname github.com --git-protocol ssh")
        return False
    if not require_auth:
        return True
    ok, account, text = gh_auth_status()
    if ok:
        success(f"GitHub CLI authenticated{f' as {account}' if account else ''}.")
        return True
    warning("GitHub CLI is not authenticated for github.com.")
    if text:
        print(col(text, "dim"))
    if offer_login and sys.stdin.isatty():
        if confirm("Run 'gh auth login' now?", True):
            code = run_interactive(
                [gh, "auth", "login", "--hostname", "github.com", "--web", "--git-protocol", "ssh"]
            )
            if code == 0:
                ok, account, _ = gh_auth_status()
                if ok:
                    success(f"Authenticated{f' as {account}' if account else ''}.")
                    return True
    info("Run: gh auth login --hostname github.com --git-protocol ssh")
    return False


