    def change_identity(self, config: Dict[str, List[str]]) -> None:
        current_name = cfg_get(config, "user.name")
        current_email = cfg_get(config, "user.email")
        name = ask("Git user.name", default=current_name or None)
        email = ask_email("Git user.email", default=current_email or None)
        if not confirm(f'Set global identity to "{name} <{email}>"?', True):
            return
        set_global_config("user.name", name)
        set_global_config("user.email", email)

    def choose_signing_key(self, config: Dict[str, List[str]]) -> Optional[str]:
        current = cfg_get(config, "user.signingkey")
        ssh_dir = HOME / ".ssh"
        candidates = sorted(ssh_dir.glob("*.pub")) if ssh_dir.exists() else []
        if current:
            current_path = find_existing_path(current)
            if current_path and current_path not in candidates:
                candidates.insert(0, current_path)
        if not candidates:
            warning("No SSH public keys found in ~/.ssh.")
            print(
                textwrap.dedent(
                    """\
                    Create one with:
                      ssh-keygen -t ed25519 -C "your@email"
                      eval "$(ssh-agent -s)" && ssh-add ~/.ssh/id_ed25519
                      gh ssh-key add ~/.ssh/id_ed25519.pub --type signing
                    """
                )
            )
            return None
        print()
        for index, path in enumerate(candidates, 1):
            fingerprint = key_fingerprint(path)
            print(f"  {index}) {path}" + (f"  {fingerprint}" if fingerprint else ""))
        default_index = "1"
        if current:
            current_path = find_existing_path(current)
            if current_path in candidates:
                default_index = str(candidates.index(current_path) + 1)
        choice = ask("Choose a public key number or enter a path", default=default_index)
        try:
            index = int(choice)
            if 1 <= index <= len(candidates):
                return str(candidates[index - 1])
        except ValueError:
            pass
        path = Path(os.path.expanduser(choice))
        _, text, error = resolve_public_key(str(path))
        if error or text is None:
            failure(error or "invalid public key")
            return None
        return str(path)

    def configure_signing_key(self, config: Dict[str, List[str]]) -> Optional[str]:
        key = self.choose_signing_key(config)
        if not key:
            return None
        print()
        explain(
            "Sets gpg.format=ssh, user.signingkey to the selected public key, and "
            "commit.gpgsign=true in your global Git config.",
            "Git can then reuse your existing SSH key to sign every new commit instead "
            "of setting up a separate GPG key.",
            "Only the public key path is stored in Git config. The private key stays in "
            "~/.ssh or ssh-agent and is never uploaded by this app.",
        )
        if not confirm(f"Configure SSH commit signing with {key}?", True):
            return None
        set_global_config("gpg.format", "ssh")
        set_global_config("user.signingkey", key)
        set_global_config("commit.gpgsign", "true")
        if confirm("Also configure allowed_signers for local signature verification?", True):
            email = cfg_get(config, "user.email")
            if not email or not EMAIL_RE.match(email):
                email = ask_email("Email principal for allowed_signers")
            self.ensure_allowed_signers(key, email, confirm_write=True)
        return key

    def configure_allowed_signers_action(self, config: Dict[str, List[str]]) -> None:
        key_value = cfg_get(config, "user.signingkey")
        if not key_value:
            key_value = self.choose_signing_key(config) or ""
        if not key_value:
            return
        email = cfg_get(config, "user.email")
        if not email or not EMAIL_RE.match(email):
            email = ask_email("Email principal for allowed_signers")
        self.ensure_allowed_signers(key_value, email, confirm_write=True)

    def ensure_allowed_signers(self, key_value: str, email: str, confirm_write: bool = True) -> Optional[Path]:
        key_path, key_text, error = resolve_public_key(key_value)
        if error or not key_text:
            failure("Cannot use signing key for allowed_signers: " + (error or "empty key"))
            return None
        config = read_global_config()
        configured = cfg_get(config, "gpg.ssh.allowedSignersFile")
        if configured:
            path = find_existing_path(configured)
            if path is None:
                path = Path(os.path.expanduser(configured))
                if not path.is_absolute():
                    path = HOME / path
        else:
            path = HOME / ".config" / "git" / "allowed_signers"
        wanted = key_data(key_text)
        existing = read_text(path) if path.exists() else ""
        if any(
            allowed_signers_key_data(line) == wanted
            for line in existing.splitlines()
            if line.strip() and not line.strip().startswith("#")
        ):
            if not configured:
                set_global_config("gpg.ssh.allowedSignersFile", str(path))
            success(f"allowed_signers already contains this key: {path}")
            return path
        line = f"{email} {wanted}"
        explain(
            "Adds one line to an allowed-signers file: an email principal followed by "
            f"the public key ({wanted.split()[0]}).",
            "Git uses this file to decide whether an SSH signature is trusted. It is "
            "the local equivalent of GitHub showing a Verified badge.",
            "Only public key material and the email principal are written. The private "
            "key remains in ~/.ssh or ssh-agent.",
        )
        print(f"File: {path}")
        print(f"Line: {line}")
        if confirm_write and not confirm("Append this key and configure gpg.ssh.allowedSignersFile?", True):
            return None
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            prefix = ""
            if path.exists():
                current = path.read_text(encoding="utf-8", errors="replace")
                if current and not current.endswith("\n"):
                    prefix = "\n"
            with path.open("a", encoding="utf-8") as handle:
                handle.write(prefix + line + "\n")
        except OSError as exc:
            failure(f"Could not update {path}: {exc}")
            return None
        success(f"updated {path}")
        set_global_config("gpg.ssh.allowedSignersFile", str(path))
        return path

    def add_signing_key_to_github(self, config: Dict[str, List[str]]) -> None:
        if not ensure_gh(require_auth=True, offer_login=True):
            return
        key_value = cfg_get(config, "user.signingkey")
        if not key_value:
            key_value = self.choose_signing_key(config) or ""
        if not key_value:
            return
        key_path, key_text, error = resolve_public_key(key_value)
        if error or key_path is None:
            failure("gh ssh-key add needs a public-key file: " + (error or "inline key cannot be uploaded"))
            return
        keys, api_error = fetch_github_signing_keys()
        if not api_error:
            wanted = key_data(key_text or "")
            if any(key_data(str(item.get("key", ""))) == wanted for item in keys or []):
                success("This signing key is already registered on GitHub.")
                return
        elif api_error:
            info("Could not read existing signing keys: " + api_error)
        explain(
            "Uploads the selected public key to GitHub as a signing key, using the "
            "admin:ssh_signing_key OAuth scope.",
            "GitHub can then mark commits signed with the matching private key as "
            "Verified. The private key never leaves this machine.",
            "Only the public key is uploaded. If the token lacks the scope, the app "
            "offers the gh auth refresh command.",
        )
        print("Commands:")
        print(f"  gh auth refresh -h github.com -s admin:ssh_signing_key")
        print(f"  gh ssh-key add {key_path} --type signing")
        if not confirm("Add this key to GitHub now?", True):
            return
        gh = which_gh() or "gh"
        result = run_cmd([gh, "ssh-key", "add", str(key_path), "--type", "signing", "--title", "git-create signing key"], timeout=60)
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success("Signing key added to GitHub.")
            return
        warning("Adding the key failed. This commonly means the gh token lacks the admin:ssh_signing_key scope.")
        if sys.stdin.isatty() and confirm("Run 'gh auth refresh -h github.com -s admin:ssh_signing_key' now?", True):
            code = run_interactive([gh, "auth", "refresh", "-h", "github.com", "-s", "admin:ssh_signing_key"])
            if code == 0:
                retry = run_cmd(
                    [gh, "ssh-key", "add", str(key_path), "--type", "signing", "--title", "git-create signing key"],
                    timeout=60,
                )
                if retry.combined:
                    print(retry.combined)
                if retry.returncode == 0:
                    success("Signing key added to GitHub.")
                else:
                    failure("Retry failed. Check gh auth status.")

