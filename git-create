                    f"Runs git submodule deinit -- {target}.",
                    "Deinitialization removes the submodule's working-tree contents and local configuration, "
                    "but keeps the .gitmodules entry and the parent repository's recorded commit.",
                    "Git refuses if the submodule worktree has local changes. The app never forces deinit or removes submodule history.",
                )
                result = self.run_action(["git", "submodule", "deinit", "--", target], cwd=path, timeout=60)
                if result.combined:
                    print(result.combined)
                if self.dry_run:
                    info("DRY RUN: submodule was not deinitialized.")
                elif result.returncode == 0:
                    success("Submodule deinitialized.")
                else:
                    failure("Submodule deinit failed; it may contain local changes.")
            elif choice == "10":
                if not (path / ".gitmodules").exists():
                    info("No .gitmodules file found.")
                    continue
                configured = run_cmd(
                    ["git", "-C", str(path), "config", "-f", ".gitmodules", "--get-regexp", r"^submodule\..*\.path$"],
                    timeout=15,
                )
                submodules: Dict[str, str] = {}
                for line in configured.out.splitlines():
                    key, _, value = line.partition(" ")
                    if key.startswith("submodule.") and key.endswith(".path") and value.strip():
                        submodules[value.strip()] = key[len("submodule.") : -len(".path")]
                if not submodules:
                    info("No submodule paths found.")
                    continue
                for submodule_path, submodule_name in submodules.items():
                    print(f"  {submodule_path}  (name: {submodule_name})")
                target = ask("Submodule path to remove")
                if target not in submodules:
                    failure("Choose one of the configured submodule paths.")
                    continue
                submodule_name = submodules[target]
                phrase = f"REMOVE SUBMODULE {target}"
                typed = ask(f'Type "{phrase}" to remove it', allow_empty=True)
                if typed != phrase:
                    info("Submodule removal cancelled.")
                    continue
                if self.dry_run:
                    info("DRY RUN: safety ref would be created.")
                else:
                    backup = create_backup_ref(path, f"before-submodule-remove-{submodule_name}")
                    if not backup:
                        failure("Could not create a safety ref; submodule removal cancelled.")
                        continue
                    info(f"Safety ref: {backup}")
                explain(
                    f"Runs git submodule deinit, git rm, removes the local .git/modules entry, and removes "
                    f"submodule.{submodule_name} config for {target}.",
                    "Full removal deletes the submodule working tree and local clone. The parent commit "
                    "still records the old gitlink until you commit the removal.",
                    "Git refuses dirty submodules; the app never uses force. A typed confirmation is required.",
                )
                deinit = self.run_action(["git", "submodule", "deinit", "--", target], cwd=path, timeout=60)
                if deinit.returncode != 0:
                    failure("Submodule deinit failed; removal cancelled.")
                    print(deinit.combined)
                    continue
                removed = self.run_action(["git", "rm", "--", target], cwd=path, timeout=60)
                if removed.returncode != 0:
                    failure("git rm failed; submodule files may remain.")
                    print(removed.combined)
                    continue
                self.run_action(
                    ["git", "-C", str(path), "config", "-f", ".gitmodules", "--remove-section", f"submodule.{submodule_name}"],
                    timeout=30,
                )
                self.run_action(["git", "config", "--remove-section", f"submodule.{submodule_name}"], cwd=path, timeout=30)
                self.run_action(["git", "add", "--", ".gitmodules"], cwd=path, timeout=30)
                if self.dry_run:
                    info("DRY RUN: local .git/modules cleanup skipped.")
                    info("DRY RUN: submodule was not removed.")
                    continue
                modules_root = (path / ".git" / "modules").resolve()
                module_path = (modules_root / submodule_name).resolve()
                try:
                    module_path.relative_to(modules_root)
                except ValueError:
                    warning("Submodule name escapes .git/modules; local module directory was not removed.")
                else:
                    if module_path.exists():
                        try:
                            shutil.rmtree(module_path)
                        except OSError as exc:
                            warning(f"Could not remove {module_path}: {exc}")
                success("Submodule removed from the working tree and index.")
                info("Review and commit the .gitmodules/index changes with option 8.")

    def branches_action(self) -> None:
        path = self.require_project()
        if path is None:
            return
        explain(
            "A branch is a movable name pointing at a line of commits. This menu lists, "
            "creates, switches, renames, and deletes branches.",
            "Branches let you isolate work and keep main stable. Switching changes which "
            "line of history your next commit extends.",
            "Deleting a local branch backs up its tip as a hidden ref. Remote deletion asks "
            "for a typed confirmation and never uses force or rewrites history.",
        )
        while True:
            refresh = detect_git_root(path)
            if refresh is None:
                failure("The active project is no longer a Git repository.")
                return
            path = refresh
            current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD") or "(detached HEAD)"
            local = local_branch_names(path)
            remote = remote_branch_names(path)
            upstream = git_out(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
            heading("Branch management")
            print(f"  Current: {col(current, 'cyan')}")
            print(f"  Local:   {', '.join(local) if local else '(none)'}")
            print(f"  Remote:  {', '.join(remote) if remote else '(none)'}")
            print(f"  Upstream: {upstream or '(not set)'}")
            print()
            print("  1) Show detailed branch list")
            print("  2) Create a branch")
            print("  3) Switch branch")
            print("  4) Rename current branch")
            print("  5) Delete local branch")
            print("  6) Delete remote origin branch")
            print("  7) Set upstream for current branch")
            print("  8) Show branch graph")
            print("  9) Rename an origin branch")
            print("  0) Back")
            choice = ask("Choose an option", default="0", allow_empty=True)
            if choice in ("0", ""):
                return
            if choice == "1":
                print(git_out(path, "branch", "-vv"))
            elif choice == "2":
                self.create_branch(path)
            elif choice == "3":
                self.switch_branch(path)
            elif choice == "4":
                self.rename_branch(path)
            elif choice == "5":
                self.delete_local_branch(path)
            elif choice == "6":
                self.delete_remote_branch(path)
            elif choice == "7":
                self.set_upstream(path)
            elif choice == "8":
                print(git_out(path, "log", "--oneline", "--graph", "--decorate", "--all", "-n", "40"))
            elif choice == "9":
                self.rename_remote_branch(path)
            else:
                warning("Unknown option.")

    def rename_remote_branch(self, path: Path) -> None:
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        if "origin" not in remote_urls(path):
            failure("No origin remote.")
            return
        remote = remote_branch_names(path)
        if not remote:
            warning("No remote-tracking branches found. Fetch first.")
            return
        print("  Remote branches: " + ", ".join(remote))
        old_target = ask("Remote branch to rename (for example origin/feature)")
        if old_target not in remote or not old_target.startswith("origin/"):
            failure("Choose an origin branch from the list.")
            return
        old_name = old_target.split("/", 1)[1]
        default = remote_default_branch(path)
        if not default:
            _, default, _ = check_remote_access(path)
        if default and old_name == default:
            failure("Refusing to rename the remote default branch here; change the GitHub default branch first.")
            return
        new_name = ask("New remote branch name")
        if not valid_branch_name(path, new_name):
            failure("Invalid branch name.")
            return
        if f"origin/{new_name}" in remote:
            failure(f"Remote branch already exists: origin/{new_name}")
            return
        info(f"Fetching the latest origin/{old_name} before renaming...")
        fetch = run_cmd(["git", "fetch", "origin", old_name], cwd=path, timeout=60, env_extra=remote_env())
        if fetch.returncode != 0:
            failure("Could not fetch the remote branch; rename cancelled.")
            print(fetch.combined)
            return
        backup = create_backup_ref(path, f"before-remote-rename-{old_name}", old_target)
        if not backup:
            failure("Could not create a local safety ref; rename cancelled.")
            return
        info(f"Local safety ref: {backup}")
        explain(
            f"Pushes {old_target} to the new remote branch origin/{new_name}.",
            "A branch rename on a remote is a new branch push followed by deletion of the old "
            "name. Git does not rename remote branches in place.",
            "The old branch is only deleted after a separate typed confirmation. No force is used "
            "and other clones must update their tracking branches.",
        )
        command = [
            "git",
            "push",
            "origin",
            f"refs/remotes/origin/{old_name}:refs/heads/{new_name}",
        ]
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm(f"Create remote branch origin/{new_name}?", True):
            return
        result = run_cmd(command, cwd=path, timeout=120, env_extra=remote_env())
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Remote branch creation failed. The old remote branch was not touched.")
            return
        success(f"Created origin/{new_name}.")
        phrase = f"DELETE REMOTE {old_target}"
        typed = ask(f'Type "{phrase}" to delete the old remote branch', allow_empty=True)
        if typed != phrase:
            info("Old remote branch kept. Finish the rename manually if needed.")
            return
        delete = run_cmd(["git", "push", "origin", "--delete", old_name], cwd=path, timeout=120, env_extra=remote_env())
        if delete.combined:
            print(delete.combined)
        if delete.returncode == 0:
            success(f"Renamed remote branch to origin/{new_name}.")
            run_cmd(["git", "fetch", "--prune", "origin"], cwd=path, timeout=60, env_extra=remote_env())
            info("Local branches and other clones may still track the old name; set upstream explicitly.")
        else:
            failure("Old remote branch deletion failed; both names may exist.")
            info("No force was used.")

    def create_branch(self, path: Path) -> None:
        name = ask("New branch name")
        if not valid_branch_name(path, name):
            failure("That is not a valid Git branch name.")
            return
        if name in local_branch_names(path):
            failure(f"Local branch already exists: {name}")
            return
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        switch_now = confirm(f"Switch to '{name}' after creating it?", True)
        if switch_now and status_entries(path) and not confirm(
            "The working tree has changes; switch and carry them to the new branch?", True
        ):
            return
        command = ["git", "switch", "-c", name] if switch_now else ["git", "branch", name]
        explain(
            f"Creates branch '{name}' at the current commit"
            + (" and switches to it." if switch_now else " without switching."),
            "A new branch is just another name for the current commit. Switching makes "
            "future commits belong to the new line of work.",
            "Existing commits are not changed. If switching is blocked by conflicting local "
            "changes, Git refuses and the app stops.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        result = run_cmd(command, cwd=path, timeout=30)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Branch creation failed.")
            return
        success(f"Branch '{name}' created.")
        if switch_now and "origin" in remote_urls(path) and confirm(
            "Push this branch and set upstream now?", False
        ):
            self.push_current(path)

    def switch_branch(self, path: Path) -> None:
        local = local_branch_names(path)
        remote = remote_branch_names(path)
        candidates = local + [item for item in remote if item not in local]
        if not candidates:
            warning("No branches available to switch to.")
            return
        print("  Local: " + (", ".join(local) if local else "(none)"))
        print("  Remote: " + (", ".join(remote) if remote else "(none)"))
        target = ask("Branch to switch to")
        current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        if target == current:
            info("That branch is already current.")
            return
        if target in local:
            command = ["git", "switch", target]
        elif target in remote:
            local_name = target.split("/", 1)[1] if "/" in target else target
            if local_name in local:
                failure(f"Local branch already exists: {local_name}")
                return
            command = ["git", "switch", "-c", local_name, "--track", target]
            info(f"Will create local branch '{local_name}' tracking '{target}'.")
        else:
            failure("Unknown branch. Choose a name from the lists above.")
            return
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        if status_entries(path) and not confirm(
            "The working tree has changes; attempt the switch and carry them?", True
        ):
            return
        explain(
            "Runs git switch. Git updates the working tree and HEAD to point at the "
            "selected branch.",
            "This is how you move between independent lines of work without merging them.",
            "Uncommitted changes may prevent the switch. Git will refuse rather than lose them.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        result = run_cmd(command, cwd=path, timeout=60)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Branch switch failed; working-tree changes were not discarded.")
        else:
            success(f"Switched to branch '{target}'.")

    def rename_branch(self, path: Path) -> None:
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        if not current:
            failure("Detached HEAD; check out a branch before renaming.")
            return
        new_name = ask("New name for current branch", default=current)
        if new_name == current:
            info("Branch name unchanged.")
            return
        if not valid_branch_name(path, new_name):
            failure("That is not a valid Git branch name.")
            return
        if new_name in local_branch_names(path):
            failure(f"Local branch already exists: {new_name}")
            return
        backup = create_backup_ref(path, f"before-rename-{current}")
        if backup:
            info(f"Backup ref: {backup}")
        command = ["git", "branch", "-m", new_name]
        explain(
            "Runs git branch -m to rename the current local branch.",
            "The commits stay exactly the same; only the branch name changes. This does not "
            "rename the branch on the remote.",
            "Git does not rewrite history. If the old remote branch exists, update it or set "
            "a new upstream deliberately.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        result = run_cmd(command, cwd=path, timeout=30)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Branch rename failed.")
            return
        success(f"Branch renamed to '{new_name}'.")
        info("The remote branch was not renamed. Push the new name and update the upstream if needed.")

    def delete_local_branch(self, path: Path) -> None:
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        branches = [item for item in local_branch_names(path) if item != current]
        if not branches:
            warning("There is no other local branch to delete.")
            return
        print("  Deletable local branches: " + ", ".join(branches))
        target = ask("Local branch to delete")
        if target == current:
            failure("Refusing to delete the current branch. Switch away first.")
            return
        if target not in local_branch_names(path):
            failure(f"Unknown local branch: {target}")
            return
        if not confirm(f"Delete local branch '{target}'? A safety ref will preserve its tip.", True):
            return
        backup = create_backup_ref(path, f"deleted-branch-{target}", target)
        if not backup:
            failure("Could not create a safety ref; deletion cancelled.")
            return
        info(f"Backup ref saved: {backup}")
        explain(
            f"First tries git branch -d {target}, which refuses if the branch is not merged. "
            "If it is unmerged, a second typed confirmation enables -D.",
            "Deleting a branch removes only the name. The safety ref keeps the commits "
            "reachable locally until you decide to clean it up.",
            "The current branch is refused, and a remote branch is not deleted here.",
        )
        print("Command: " + col(f"git branch -d {target}", "dim"))
        result = run_cmd(["git", "branch", "-d", target], cwd=path, timeout=30)
        if result.returncode == 0:
            success(f"Deleted local branch '{target}'.")
            return
        warning("Safe delete refused; the branch may contain unmerged commits.")
        print(result.combined)
        typed = ask(f'Type "DELETE BRANCH {target}" to force-delete the local ref', allow_empty=True)
        if typed != f"DELETE BRANCH {target}":
            info("Deletion cancelled; the branch remains.")
            return
        forced = run_cmd(["git", "branch", "-D", target], cwd=path, timeout=30)
        if forced.combined:
            print(forced.combined)
        if forced.returncode == 0:
            success(f"Deleted local branch '{target}'. Backup ref remains: {backup}")
        else:
            failure("Local branch deletion failed.")

    def delete_remote_branch(self, path: Path) -> None:
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        if "origin" not in remote_urls(path):
            failure("No origin remote.")
            return
        remote = remote_branch_names(path)
        if not remote:
            warning("No remote-tracking branches found. Run fetch first.")
            return
        print("  Remote branches: " + ", ".join(remote))
        target = ask("Remote branch to delete (for example origin/feature)")
        if target not in remote:
            failure(f"Unknown remote branch: {target}")
            return
        if not target.startswith("origin/"):
            failure("Only origin branches are supported by this action.")
            return
        branch_name = target.split("/", 1)[1]
        default = remote_default_branch(path)
        if not default:
            _, default, _ = check_remote_access(path)
        if not default:
            failure("Could not determine the remote default branch; deletion cancelled for safety.")
            return
        if branch_name == default:
            failure(f"Refusing to delete the remote default branch '{branch_name}'.")
            return
        backup = create_backup_ref(path, f"deleted-remote-{branch_name}", target)
        if not backup:
            failure("Could not create a local safety ref; remote branch deletion cancelled.")
            return
        info(f"Local safety ref for the remote tip: {backup}")
        explain(
            f"Runs git push origin --delete {branch_name}. This removes the branch name from "
            "the remote; it does not rewrite other branches or force-push.",
            "Remote branches are shared. Deleting one needs a deliberate confirmation because "
            "other clones may be tracking it.",
            "The remote default branch is refused. The local safety ref preserves the tip "
            "until you clean it up.",
        )
        phrase = f"DELETE REMOTE {target}"
        typed = ask(f'Type "{phrase}" to continue', allow_empty=True)
        if typed != phrase:
            info("Remote deletion cancelled.")
            return
        result = run_cmd(["git", "push", "origin", "--delete", branch_name], cwd=path, timeout=120, env_extra=remote_env())
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"Deleted remote branch '{target}'.")
            run_cmd(["git", "fetch", "--prune", "origin"], cwd=path, timeout=60, env_extra=remote_env())
        else:
            failure("Remote branch deletion failed. No force was used.")

    def set_upstream(self, path: Path) -> None:
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        if not current:
            failure("Detached HEAD; check out a branch first.")
            return
        remote = remote_branch_names(path)
        if not remote:
            warning("No remote-tracking branches found. Fetch first.")
            return
        default = f"origin/{current}"
        target = ask("Upstream branch", default=default if default in remote else None)
        if target not in remote:
            failure(f"Unknown remote branch: {target}")
            return
        explain(
            f"Runs git branch --set-upstream-to={target} {current}.",
            "Upstream tells plain git pull and git push which remote branch this local "
            "branch corresponds to.",
            "This only changes local branch configuration; it does not push or fetch.",
        )
        command = ["git", "branch", f"--set-upstream-to={target}", current]
        print("Command: " + col(shlex.join(command), "dim"))
        result = run_cmd(command, cwd=path, timeout=30)
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"Upstream for '{current}' is now '{target}'.")
        else:
            failure("Could not set upstream.")

    def github_collab_action(self) -> None:
        path = self.require_project()
        if path is None:
            return
        origin = remote_urls(path).get("origin", "")
        if not parse_github_url(origin):
            failure("No GitHub origin remote found. This menu supports github.com repositories only.")
            return
        if not ensure_gh(require_auth=True, offer_login=True):
            return
        explain(
            "This menu uses authenticated gh commands for pull requests, issues, and reviews.",
            "Collaboration happens on GitHub, not in local Git history. Reads are safe; creating "
            "a PR, issue, or review publishes an action under your account.",
            "Every write is confirmed first. The app does not merge, close, or delete anything "
            "from this menu.",
        )
        while True:
            heading("GitHub collaboration")
            print("  1) List pull requests")
            print("  2) View a pull request")
            print("  3) Create a pull request")
            print("  4) List issues")
            print("  5) View an issue")
            print("  6) Create an issue")
            print("  7) Review a pull request")
            print("  8) Security and workflow audit (read-only)")
            print("  9) Manage branch protection")
            print(" 10) Manage Actions secrets")
            print("  0) Back")
            choice = ask("Choose an option", default="0", allow_empty=True)
            if choice in ("0", ""):
                return
            gh = which_gh() or "gh"
            if choice == "1":
                result = run_cmd([gh, "pr", "list", "--limit", "20"], cwd=path, timeout=60)
                print(result.combined or "(no pull requests)")
            elif choice == "2":
                number = ask("Pull request number")
                if not number.isdigit():
                    failure("Enter a numeric pull request number.")
                    continue
                result = run_cmd([gh, "pr", "view", number], cwd=path, timeout=60)
                print(result.combined)
            elif choice == "3":
                current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
                if not current:
                    failure("Detached HEAD; check out a branch first.")
                    continue
                upstream = git_out(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
                if not upstream:
                    failure("Current branch has no upstream. Push it first with option 8.")
                    continue
                base_default = remote_default_branch(path) or "main"
                base = ask("Base branch", default=base_default)
                if base == current:
                    failure("Base and head branch must differ.")
                    continue
                title = ask("Pull request title")
                body = ask("Pull request body (optional)", allow_empty=True)
                command = [gh, "pr", "create", "--base", base, "--head", current, "--title", title]
                if body:
                    command.extend(["--body", body])
                else:
                    command.extend(["--body", ""])
                explain(
                    f"Runs gh pr create from '{current}' into '{base}'.",
                    "A pull request publishes a reviewable branch comparison on GitHub.",
                    "The app does not merge the pull request. The repository and branch are "
                    "unchanged until you act on GitHub.",
                )
                print("Command: " + col(shlex.join(command), "dim"))
                if not confirm("Create this pull request?", True):
                    continue
                result = run_cmd(command, cwd=path, timeout=120)
                print(result.combined)
                if result.returncode == 0:
                    success("Pull request created.")
                else:
                    failure("Pull request creation failed.")
            elif choice == "4":
                result = run_cmd([gh, "issue", "list", "--limit", "20"], cwd=path, timeout=60)
                print(result.combined or "(no issues)")
            elif choice == "5":
                number = ask("Issue number")
                if not number.isdigit():
                    failure("Enter a numeric issue number.")
                    continue
                result = run_cmd([gh, "issue", "view", number], cwd=path, timeout=60)
                print(result.combined)
            elif choice == "6":
                title = ask("Issue title")
                body = ask("Issue body (optional)", allow_empty=True)
                command = [gh, "issue", "create", "--title", title, "--body", body]
                explain(
                    "Runs gh issue create.",
                    "An issue records a bug, task, or discussion on GitHub.",
                    "The app does not close, edit, or delete issues.",
                )
                print("Command: " + col(shlex.join(command), "dim"))
                if not confirm("Create this issue?", True):
                    continue
                result = run_cmd(command, cwd=path, timeout=120)
                print(result.combined)
                if result.returncode == 0:
                    success("Issue created.")
                else:
                    failure("Issue creation failed.")
            elif choice == "7":
                number = ask("Pull request number")
                if not number.isdigit():
                    failure("Enter a numeric pull request number.")
                    continue
                review_type = ask("[a]pprove, [c]omment, or [r]equest changes", default="c").lower()
                flags = {
                    "a": "--approve",
                    "approve": "--approve",
                    "c": "--comment",
                    "comment": "--comment",
                    "r": "--request-changes",
                    "request": "--request-changes",
                    "request-changes": "--request-changes",
                }
                flag = flags.get(review_type)
                if not flag:
                    failure("Choose approve, comment, or request changes.")
                    continue
                body = ask("Review body (optional)", allow_empty=True)
                if flag in ("--comment", "--request-changes") and not body:
                    failure("A review body is required for comments and change requests.")
                    continue
                command = [gh, "pr", "review", number, flag]
                if body:
                    command.extend(["--body", body])
                explain(
                    f"Runs gh pr review {number} {flag}.",
                    "This submits a review under your GitHub account and may notify the author.",
                    "The app does not merge, close, or dismiss reviews.",
                )
                print("Command: " + col(shlex.join(command), "dim"))
                if not confirm("Submit this review?", True):
                    continue
                result = run_cmd(command, cwd=path, timeout=120)
                print(result.combined)
                if result.returncode == 0:
                    success("Review submitted.")
                else:
                    failure("Review submission failed.")
            elif choice == "8":
                self.github_security_audit(path)
            elif choice == "9":
