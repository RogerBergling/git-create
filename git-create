            "Stashes are local and are not part of normal commit history. This menu can "
            "save, list, inspect, apply, pop, and drop them.",
            "Applying keeps the stash. Popping removes it only when Git succeeds. Dropping "
            "requires a typed confirmation and a patch backup when possible.",
        )
        while True:
            stashes = git_out(path, "stash", "list")
            heading("Stash helpers")
            print(stashes if stashes else "  (no stashes)")
            status = git_out(path, "status", "--short")
            if status:
                print(col("Working tree:", "bold"))
                print(status)
            print()
            print("  1) Save current changes to a new stash")
            print("  2) Show stash list")
            print("  3) Show a stash diff")
            print("  4) Apply a stash (keep it)")
            print("  5) Pop a stash (apply and remove on success)")
            print("  6) Drop a stash (typed confirmation)")
            print("  0) Back")
            choice = ask("Choose an option", default="0", allow_empty=True)
            if choice in ("0", ""):
                return
            if choice == "1":
                if in_progress_operations(path):
                    failure("A Git operation is in progress; finish or abort it before stashing.")
                    continue
                entries = status_entries(path)
                if not entries:
                    info("The working tree has no changes to stash.")
                    continue
                message = ask("Stash message (optional)", allow_empty=True)
                include_untracked = confirm("Include untracked files in the stash?", False)
                command = ["git", "stash", "push"]
                if include_untracked:
                    command.append("--include-untracked")
                if message:
                    command.extend(["-m", message])
                explain(
                    "Runs git stash push. The selected working-tree changes are saved on the "
                    "local stash stack and removed from the working tree.",
                    "This is useful when you need a clean tree for a switch, pull, or merge "
                    "without making a commit.",
                    "Untracked files are included only if you chose that option. Ignored files "
                    "are never included.",
                )
                print("Command: " + col(shlex.join(command), "dim"))
                if not confirm("Stash the current changes?", True):
                    continue
                result = run_cmd(command, cwd=path, timeout=60)
                if result.combined:
                    print(result.combined)
                if result.returncode == 0:
                    success("Changes saved to a new stash.")
                else:
                    failure("Stash save failed.")
            elif choice == "2":
                print(stashes if stashes else "No stashes.")
            elif choice == "3":
                ref = resolve_stash_ref(ask("Stash number or stash@{N}", default="0"))
                if not ref:
