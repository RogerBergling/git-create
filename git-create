    def upload_release_asset(self, path: Path) -> None:
        if not ensure_gh(require_auth=True, offer_login=True):
            return
        tag = ask("Release tag")
        if tag not in tag_names(path):
            failure(f"Local tag not found: {tag}")
            return
        filename = ask("Asset file path")
        asset = Path(os.path.expanduser(filename))
        if not asset.is_absolute():
            asset = path / asset
        if not asset.is_file():
            failure(f"Asset file not found: {asset}")
            return
        command = [which_gh() or "gh", "release", "upload", tag, str(asset)]
        explain(
            f"Runs gh release upload {tag} <asset>. The file is attached to an existing "
            "GitHub release.",
            "Release assets distribute binaries, archives, or documentation alongside a tag.",
            "The app does not use --clobber: an existing asset with the same name is not "
            "overwritten. The file is sent to GitHub; no Git history changes.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm(f"Upload '{asset.name}' to release '{tag}'?", True):
            return
        result = run_cmd(command, cwd=path, timeout=300)
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"Uploaded {asset.name}.")
        else:
            failure("Release asset upload failed. No existing asset was overwritten.")

    def show_changelog(self, path: Path) -> None:
        end = ask("End ref (tag/commit)", default="HEAD")
        if git(path, "rev-parse", "--verify", "--quiet", f"{end}^{{commit}}").returncode != 0:
            failure(f"Unknown end ref: {end}")
            return
        previous = git_out(path, "describe", "--tags", "--abbrev=0", f"{end}^")
        start = ask("Start ref (exclusive; leave empty for all history)", default=previous, allow_empty=True)
        if start:
            if git(path, "rev-parse", "--verify", "--quiet", f"{start}^{{commit}}").returncode != 0:
                failure(f"Unknown start ref: {start}")
                return
            revision_range = f"{start}..{end}"
        else:
            revision_range = end
        result = git(
            path,
            "log",
            "--no-merges",
            "--date=short",
            "--pretty=format:- %s (%h, %ad)",
            revision_range,
            timeout=60,
        )
        if result.returncode != 0:
            failure("Could not generate changelog.")
            return
        text = result.out.strip()
        heading(f"Changelog: {revision_range}")
        print(text or "(no commits in that range)")
        if text and confirm("Save this as CHANGELOG.generated.md?", False):
            write_new_file(path / "CHANGELOG.generated.md", text + "\n", "generated changelog")

    def create_tag(self, path: Path) -> None:
        name = ask("Tag name (for example v1.2.3)")
        if not valid_tag_name(path, name):
            failure("That is not a valid Git tag name.")
            return
        if name in tag_names(path):
            failure(f"Tag already exists: {name}")
            return
        target = ask("Commit to tag (hash, branch, or HEAD)", default="HEAD")
        if git(path, "rev-parse", "--verify", "--quiet", f"{target}^{{commit}}").returncode != 0:
            failure(f"Unknown commit: {target}")
            return
        config = read_global_config()
        signed_default = "s" if cfg_get(config, "tag.gpgsign").lower() == "true" else "a"
        tag_type = ask("Tag type [s]igned/[a]nnotated/[l]ightweight", default=signed_default).lower()
        if tag_type not in ("s", "signed", "a", "annotated", "l", "lightweight"):
            failure("Choose signed, annotated, or lightweight.")
            return
        message = ask("Tag message", default=name)
        if tag_type in ("s", "signed"):
            command = ["git", "tag", "-s", name, "-m", message, target]
            why = "A signed tag carries your SSH signature and can be verified by others."
        elif tag_type in ("a", "annotated"):
            command = ["git", "tag", "-a", name, "-m", message, target]
            why = "An annotated tag stores a message, author, and date as a Git object."
        else:
            command = ["git", "tag", name, target]
            why = "A lightweight tag is just a ref pointing directly at the commit."
        explain(
            f"Creates tag '{name}' at {target}.",
            why,
            "A tag is local until you push it. The app never overwrites an existing tag.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm(f"Create tag '{name}'?", True):
            return
        result = run_cmd(command, cwd=path, timeout=180)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Tag creation failed.")
            if "s" in tag_type:
                print_signing_help()
            return
        success(f"Tag '{name}' created.")
        if "origin" in remote_urls(path) and confirm("Push this tag to origin now?", False):
            self.push_tag(path, name)

    def push_tag(self, path: Path, tag: str) -> bool:
        if "origin" not in remote_urls(path):
            failure("No origin remote.")
            return False
        explain(
            f"Runs git push origin refs/tags/{tag}. Tag pushes are normal pushes and never force.",
            "Other clones and GitHub do not see a local tag until it is pushed.",
            "If the remote already has a different tag with this name, Git rejects the push. "
            "The app does not overwrite it with force.",
        )
        command = ["git", "push", "origin", f"refs/tags/{tag}"]
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm(f"Push tag '{tag}'?", True):
            return False
        result = run_cmd(command, cwd=path, timeout=120, env_extra=remote_env())
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"Tag '{tag}' pushed.")
            return True
        failure("Tag push failed. No force was used.")
        return False

    def delete_local_tag(self, path: Path) -> None:
        tag = ask("Local tag to delete")
        if tag not in tag_names(path):
            failure(f"Unknown local tag: {tag}")
            return
        backup = create_backup_ref(path, f"deleted-tag-{tag}", f"refs/tags/{tag}")
        if not backup:
            failure("Could not create a safety ref; tag deletion cancelled.")
            return
        info(f"Safety ref: {backup}")
        explain(
            f"Runs git tag -d {tag}.",
            "This removes the local tag name. A safety ref preserves the tag object/commit "
            "locally until you clean it up.",
            "The remote tag is not deleted. A typed confirmation is required.",
        )
        phrase = f"DELETE TAG {tag}"
        typed = ask(f'Type "{phrase}" to continue', allow_empty=True)
        if typed != phrase:
            info("Tag deletion cancelled.")
            return
        result = run_cmd(["git", "tag", "-d", tag], cwd=path, timeout=30)
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"Local tag '{tag}' deleted. Safety ref: {backup}")
        else:
            failure("Tag deletion failed.")

    def delete_remote_tag(self, path: Path) -> None:
        if "origin" not in remote_urls(path):
            failure("No origin remote.")
            return
        tag = ask("Remote tag to delete")
        if not valid_tag_name(path, tag):
            failure("Invalid tag name.")
            return
        if tag not in tag_names(path):
            if not confirm(f"Fetch tag '{tag}' from origin first?", True):
                return
            fetched = run_cmd(["git", "fetch", "origin", f"refs/tags/{tag}:refs/tags/{tag}"], cwd=path, timeout=120, env_extra=remote_env())
            if fetched.returncode != 0:
                failure("Could not fetch that tag from origin.")
                return
        backup = create_backup_ref(path, f"deleted-remote-tag-{tag}", f"refs/tags/{tag}")
        if not backup:
            failure("Could not create a local safety ref; remote tag deletion cancelled.")
            return
        info(f"Local safety ref: {backup}")
        explain(
            f"Runs git push origin --delete refs/tags/{tag}.",
            "The remote tag is removed for everyone who fetches it. The local tag and safety "
            "ref remain.",
            "This is a normal delete, not a force-push. A typed confirmation is required.",
        )
        phrase = f"DELETE REMOTE TAG {tag}"
        typed = ask(f'Type "{phrase}" to continue', allow_empty=True)
        if typed != phrase:
            info("Remote tag deletion cancelled.")
            return
        result = run_cmd(
            ["git", "push", "origin", "--delete", f"refs/tags/{tag}"],
            cwd=path,
            timeout=120,
            env_extra=remote_env(),
        )
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"Remote tag '{tag}' deleted.")
        else:
            failure("Remote tag deletion failed. No force was used.")

    def create_github_release(self, path: Path) -> None:
        if not ensure_gh(require_auth=True, offer_login=True):
            return
        tag = ask("Tag for the GitHub release")
        if tag not in tag_names(path):
            failure(f"Local tag not found: {tag}")
            info("Create the tag with option 2 first.")
            return
        remote_tag = git(path, "ls-remote", "origin", f"refs/tags/{tag}", timeout=60, env_extra=remote_env())
        if remote_tag.returncode != 0:
            failure("Could not check the remote tag.")
            return
        local_oid = git_out(path, "rev-parse", f"refs/tags/{tag}")
        if not remote_tag.out.strip():
            if not confirm(f"Tag '{tag}' is not on origin. Push it first?", True):
                return
            if not self.push_tag(path, tag):
                return
        else:
            remote_oid = remote_tag.out.splitlines()[0].split()[0] if remote_tag.out.split() else ""
            if remote_oid and local_oid and remote_oid != local_oid:
                failure("The local and remote tags point to different objects.")
                info("Fetch and inspect the tag before creating a release; no release was created.")
                return
        title = ask("Release title", default=tag)
        notes = ask("Release notes (leave empty to generate notes)", allow_empty=True)
        draft = confirm("Create as a draft release?", False)
        command = [which_gh() or "gh", "release", "create", tag, "--title", title, "--verify-tag"]
        if notes:
            command.extend(["--notes", notes])
        else:
            command.append("--generate-notes")
        if draft:
            command.append("--draft")
        explain(
            f"Runs gh release create {tag}. This creates a GitHub release associated with "
            "the existing remote tag.",
            "A release gives the tag a title, notes, and a place for downloadable assets. "
            "It does not change Git history.",
            "The app refuses to overwrite an existing release and never modifies tags with "
            "force.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm(f"Create GitHub release '{tag}'?", True):
            return
        result = run_cmd(command, cwd=path, timeout=120)
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"GitHub release '{tag}' created.")
        else:
            failure("GitHub release creation failed.")

    def remotes_action(self) -> None:
        path = self.require_project()
        if path is None:
            return
        explain(
            "Remotes are named URLs for other copies of the repository, usually origin on "
            "GitHub.",
            "This menu lists, adds, edits, renames, removes, and prunes remotes without "
            "changing commits or deleting anything on the remote server.",
            "Removing a remote only removes the local name and tracking refs. It does not "
            "delete the remote repository or branches.",
        )
        if self.dry_run:
            warning("Dry-run mode is ON: remote changes are shown but not executed.")
        while True:
            heading("Remotes")
            print(git_out(path, "remote", "-v") or "  (no remotes)")
            print()
            print("  1) List remotes")
            print("  2) Add a remote")
            print("  3) Change a remote URL")
            print("  4) Rename a remote")
            print("  5) Remove a local remote")
            print("  6) Fetch with prune for a remote")
            print("  0) Back")
            choice = ask("Choose an option", default="0", allow_empty=True)
            if choice in ("0", ""):
                return
            remotes = remote_urls(path)
            if choice == "1":
                print(git_out(path, "remote", "-v") or "No remotes.")
            elif choice in ("2", "3", "4", "5", "6"):
                if choice == "2":
                    name = ask("New remote name", default="origin")
                    if not re.fullmatch(r"[A-Za-z0-9._-]+", name) or name in remotes:
                        failure("Use a new remote name with letters, numbers, dot, dash, or underscore.")
                        continue
                    url = ask("Remote URL")
                    if not url or url.startswith("-"):
                        failure("A valid URL is required.")
                        continue
                    if re.match(r"^https?://[^/@\s]+@", url):
                        failure("Refusing to store credentials in a remote URL. Use SSH or gh authentication.")
                        continue
                    command = ["git", "remote", "add", name, url]
                    why = "Adds a name and URL to .git/config. Git does not contact the remote yet."
                elif choice == "3":
                    name = ask("Remote to edit", default="origin" if "origin" in remotes else "")
                    if name not in remotes:
                        failure(f"Unknown remote: {name}")
                        continue
                    url = ask("New remote URL")
                    if not url or url.startswith("-"):
                        failure("A valid URL is required.")
                        continue
                    if re.match(r"^https?://[^/@\s]+@", url):
                        failure("Refusing to store credentials in a remote URL.")
                        continue
                    command = ["git", "remote", "set-url", name, url]
                    why = "Changes only the stored URL; branches, commits, and the server are untouched."
                elif choice == "4":
                    old = ask("Remote to rename", default="origin" if "origin" in remotes else "")
                    if old not in remotes:
                        failure(f"Unknown remote: {old}")
                        continue
                    new = ask("New remote name")
                    if not re.fullmatch(r"[A-Za-z0-9._-]+", new) or new in remotes:
                        failure("Use a new remote name with letters, numbers, dot, dash, or underscore.")
                        continue
                    command = ["git", "remote", "rename", old, new]
                    why = "Renames the local remote and updates tracking refs/config. The server is untouched."
                elif choice == "5":
                    name = ask("Remote to remove", default="origin" if "origin" in remotes else "")
                    if name not in remotes:
                        failure(f"Unknown remote: {name}")
                        continue
                    phrase = f"REMOVE REMOTE {name}"
                    typed = ask(f'Type "{phrase}" to remove the local remote', allow_empty=True)
                    if typed != phrase:
                        info("Remote removal cancelled.")
                        continue
                    command = ["git", "remote", "remove", name]
                    why = "Removes the local remote name and tracking refs. The remote server and branches remain."
                else:
                    name = ask("Remote to fetch with prune", default="origin" if "origin" in remotes else "")
                    if name not in remotes:
                        failure(f"Unknown remote: {name}")
                        continue
                    command = ["git", "fetch", "--prune", name]
                    why = "Downloads remote updates and removes stale remote-tracking refs; local branches are untouched."
                explain(
                    "Runs " + shlex.join(command) + ".",
                    why,
                    "No force is used. Remote servers are never rewritten by this menu.",
                )
                print("Command: " + col(shlex.join(command), "dim"))
                if not confirm("Run this remote operation?", True):
                    continue
                result = self.run_action(
                    command,
                    cwd=path,
                    timeout=120 if choice == "6" else 30,
                    env_extra=remote_env() if choice == "6" else None,
                )
                if result.combined:
                    print(result.combined)
                if self.dry_run:
                    info("DRY RUN: remote configuration was not changed.")
                elif result.returncode == 0:
                    success("Remote configuration updated.")
                else:
                    failure("Remote operation failed.")
            else:
                warning("Unknown option.")

