    def choose_signing_key(self, config: Dict[str, List[str]]) -> Optional[str]:
        current = cfg_get(config, "user.signingkey")
        ssh_dir = HOME / ".ssh"
        candidates = sorted(ssh_dir.glob("*.pub")) if ssh_dir.exists() else []
        if current:
            current_path = find_existing_path(current)
            if current_path and current_path not in candidates:
                candidates.insert(0, current_path)
        if not candidates:
            warning("No SSH public keys found in ~/.ssh.")
            print(
                textwrap.dedent(
                    """\
                    Create one with:
                      ssh-keygen -t ed25519 -C "your@email"
                      eval "$(ssh-agent -s)" && ssh-add ~/.ssh/id_ed25519
                      gh ssh-key add ~/.ssh/id_ed25519.pub --type signing
                    """
                )
            )
            return None
        print()
        for index, path in enumerate(candidates, 1):
            fingerprint = key_fingerprint(path)
            print(f"  {index}) {path}" + (f"  {fingerprint}" if fingerprint else ""))
        default_index = "1"
        if current:
            current_path = find_existing_path(current)
            if current_path in candidates:
                default_index = str(candidates.index(current_path) + 1)
        choice = ask("Choose a public key number or enter a path", default=default_index)
        try:
            index = int(choice)
            if 1 <= index <= len(candidates):
                return str(candidates[index - 1])
        except ValueError:
            pass
        path = Path(os.path.expanduser(choice))
        _, text, error = resolve_public_key(str(path))
        if error or text is None:
            failure(error or "invalid public key")
            return None
        return str(path)

