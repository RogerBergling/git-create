def stage_changes(root: Path) -> bool:
    entries = status_entries(root)
    if not entries:
        info("No changes to stage.")
        return False
    explain(
        "git add copies the selected working-tree changes into the staging area (also "
        "called the index). The next commit will record exactly that staged snapshot.",
        "Staging is the review step between editing files and saving a commit. It lets "
        "you exclude unfinished work, generated files, or anything suspicious.",
        "Ignored files such as .env are not staged. The app shows the list before adding "
        "anything and scans the staged content before committing.",
    )
    heading("Changes")
    for index, entry in enumerate(entries, 1):
        print(f"  {index:>3}) {entry.display}")
    print()
    mode = ask("Stage [a]ll, [s]elect, [p]atch, or [c]ancel", default="a").lower()
    if mode in ("c", "cancel", "n", "no"):
        info("Cancelled; nothing was staged.")
        return False
    if mode in ("p", "patch", "interactive"):
        if not sys.stdin.isatty():
            failure("Interactive hunk staging requires a terminal.")
            return False
        explain(
            "Runs git add -p. Git shows each hunk and asks whether to stage it.",
            "Hunk-level staging gives precise control over a commit without external tools.",
            "Untracked files are not included by git add -p; stage them separately if needed.",
        )
        code = run_interactive(["git", "add", "-p"], cwd=root)
        if code != 0:
            failure("Interactive staging did not complete.")
            return False
        staged = git_out(root, "diff", "--cached", "--name-only")
        if not staged:
            warning("No staged files.")
            return False
        success(f"Staged {len(staged.splitlines())} path(s).")
        return True
    if mode in ("a", "all", ""):
        command = ["git", "add", "-A"]
    elif mode in ("s", "select"):
        selection = ask("Path numbers (examples: 1,3,5-7)")
        chosen: List[StatusEntry] = []
        for part in selection.split(","):
            part = part.strip()
            if not part:
                continue
            if "-" in part:
                start_text, end_text = part.split("-", 1)
                try:
                    start, end = int(start_text), int(end_text)
                except ValueError:
                    warning(f"Invalid range: {part}")
                    return False
                chosen.extend(entries[index - 1] for index in range(start, end + 1) if 1 <= index <= len(entries))
            else:
                try:
                    index = int(part)
                except ValueError:
                    warning(f"Invalid number: {part}")
                    return False
                if 1 <= index <= len(entries):
                    chosen.append(entries[index - 1])
        if not chosen:
            warning("Nothing selected.")
            return False
        paths: List[str] = []
        for entry in chosen:
            paths.extend(entry.stage_paths)
        command = ["git", "add", "-A", "--", *paths]
    else:
        warning("Unknown choice.")
        return False
    print()
    print("Command: " + col(shlex.join(command), "dim"))
    if not confirm("Stage these changes?", True):
        return False
    result = run_cmd(command, cwd=root, timeout=60)
    if result.combined:
        print(result.combined)
    if result.returncode != 0:
        failure("Staging failed.")
        return False
    staged = git_out(root, "diff", "--cached", "--name-only")
    if not staged:
        warning("No staged files.")
        return False
    success(f"Staged {len(staged.splitlines())} path(s).")
    return True


def staged_paths(root: Path, added_only: bool = True) -> List[str]:
    args = ["diff", "--cached", "--name-only", "-z"]
    if added_only:
        args.append("--diff-filter=ACMRT")
    result = git(root, *args, timeout=20)
    if result.returncode != 0:
        return []
    return [item for item in result.out.split("\0") if item]


def worktree_mismatch(root: Path, paths: Sequence[str]) -> List[str]:
    """Paths whose index content differs from the working tree."""
    if not paths:
        return []
    result = git(root, "diff", "--name-only", "-z", "--", *paths, timeout=20)
    if result.returncode != 0:
        return []
    return [item for item in result.out.split("\0") if item]


def show_diff(root: Path, cached: bool = False, max_lines: int = 200) -> None:
    """Print a bounded diff of staged or unstaged changes."""
    args = ["git", "diff", "--no-color"]
    if cached:
        args.append("--cached")
    result = run_cmd(args, cwd=root, timeout=30)
    label = "Staged diff" if cached else "Unstaged diff"
    if result.returncode != 0:
        warning(f"Could not display the {label.lower()}: " + one_line(result.combined))
        return
    lines = result.out.splitlines()
    if not lines:
        info(f"The {label.lower()} is empty.")
        return
    print(col(label + ":", "bold"))
    for line in lines[:max_lines]:
        print(line)
    if len(lines) > max_lines:
        info(f"Diff truncated after {max_lines} lines. Use 'git diff' manually to view the rest.")


def show_staged_diff(root: Path, max_lines: int = 200) -> None:
    """Print a bounded reviewable diff of what will be committed."""
    show_diff(root, cached=True, max_lines=max_lines)


def resolve_stash_ref(value: str) -> Optional[str]:
    value = value.strip()
    if value.isdigit():
        return f"stash@{{{value}}}"
    if re.fullmatch(r"stash@\{\d+\}", value):
        return value
    return None


def create_stash_backup(root: Path, stash_ref: str, label: str = "stash") -> Optional[Path]:
    git_dir_raw = git_out(root, "rev-parse", "--git-dir")
    if not git_dir_raw:
        return None
    git_dir = Path(git_dir_raw)
    if not git_dir.is_absolute():
        git_dir = root / git_dir
    backup_dir = git_dir / "git-create-backups"
    result = git(root, "stash", "show", "-p", "--include-untracked", stash_ref, timeout=30)
    if result.returncode != 0:
        return None
    try:
        backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(backup_dir, 0o700)
    except OSError:
        return None
    patch = backup_dir / f"{label}-{unique_suffix()}.patch"
    if not write_exclusive_text(patch, result.out, 0o600):
        return None
    return patch


def unstage_paths(root: Path, paths: Sequence[str]) -> bool:
    """Remove paths from the index without touching working-tree files."""
    if not paths:
        return True
    has_head = git(root, "rev-parse", "--verify", "--quiet", "HEAD").returncode == 0
    if has_head:
        command = ["git", "restore", "--staged", "--", *paths]
    else:
        command = ["git", "rm", "--cached", "-r", "-q", "--", *paths]
    result = run_cmd(command, cwd=root, timeout=60)
    if result.returncode != 0:
        warning("Could not unstage automatically: " + one_line(result.combined))
        print("Unstage manually with: git restore --staged -- " + " ".join(shlex.quote(path) for path in paths))
        return False
    return True


def review_staged_safety(root: Path) -> bool:
    paths = staged_paths(root, added_only=True)
    if not paths:
        warning("No added/modified files are staged.")
        return False
    mismatch = worktree_mismatch(root, paths)
    if mismatch:
        failure("The index differs from the working tree for:")
        for path in mismatch[:12]:
            print("  - " + path)
        print("Stage the current content again before committing, or unstage the paths.")
        info("This prevents a secret scan of the working tree from approving different staged content.")
        return False
    sensitive = [path for path in paths if is_sensitive_name(path)]
    findings, truncated = scan_secret_content(root, paths)
    problems = []
    large_warning: List[Tuple[str, int]] = []
    for path in paths:
        absolute = root / path
        try:
            if absolute.is_symlink() or not absolute.is_file():
                continue
            size = absolute.stat().st_size
        except OSError:
            continue
        if size >= 50 * 1024 * 1024:
            large_warning.append((path, size))
    if sensitive:
        problems.append("Sensitive filenames: " + ", ".join(sensitive[:8]))
    if large_warning:
        info(
            "Large staged files (no app limit; the remote may reject them): "
            + ", ".join(f"{path} ({format_size(size)})" for path, size in large_warning[:5])
        )
    if findings:
        problems.append(
            "Possible secrets: "
            + ", ".join(f"{path}:{line} ({kind})" for path, line, kind, _ in findings[:8])
            + (" ..." if len(findings) > 8 else "")
        )
    if truncated:
        problems.append("Secret scan limit reached; review large/binary files manually.")
    if not problems:
        success("Staged files passed the sensitive-name and common-secret scan.")
        return True
    failure("Staged content needs review before committing:")
    for problem in problems:
        print("  - " + problem)
    print()
    print("If any value is real: remove it from the index, rotate the credential, and use .env or a secret manager.")
    print("If these are safe test fixtures and you truly intend to commit them, type COMMIT below.")
    warning("This can permanently publish secrets.")
    try:
        answer = ask('Type "COMMIT" to continue, or press Enter to cancel', allow_empty=True)
    except EOFError:
        answer = ""
    if answer == "COMMIT":
        return True
    risky_paths = sorted(set(sensitive + [path for path, _, _, _ in findings]))
    if risky_paths and unstage_paths(root, risky_paths):
        info("Risky paths were unstaged; working-tree files were not changed.")
    return False


