    def worktrees_action(self) -> None:
        path = self.require_project()
        if path is None:
            return
        explain(
            "A linked worktree is a second checkout that shares this repository's .git "
            "history. A submodule is a separate repository embedded at a path.",
            "Worktrees let you work on two branches at once. Submodules let a project "
            "reference a pinned commit from another repository.",
            "Worktree removal refuses dirty directories. Submodule deinit and removal are "
            "explicit, confirmed, and never forced.",
        )
        if self.dry_run:
            warning("Dry-run mode is ON: commands are shown but not executed.")
        while True:
            heading("Worktrees and submodules")
            print("  1) List worktrees")
            print("  2) Add a worktree")
            print("  3) Remove a worktree")
            print("  4) Prune stale worktree metadata")
            print("  5) List submodules")
            print("  6) Initialize/update submodules")
            print("  7) Sync submodule URLs")
            print("  8) Add a submodule")
            print("  9) Deinitialize a submodule")
            print(" 10) Remove a submodule (typed confirmation)")
            print("  0) Back")
            choice = ask("Choose an option", default="0", allow_empty=True)
            if choice in ("0", ""):
                return
            if choice == "1":
                print(git_out(path, "worktree", "list") or "(no worktrees)")
            elif choice == "2":
                default_path = path.parent / f"{path.name}-worktree"
                target = ask_path("New worktree path", default=default_path)
                if target.exists():
                    failure(f"Target already exists: {target}")
                    continue
                current_branch = git_out(path, "symbolic-ref", "--short", "-q", "HEAD") or "main"
                branch = ask("Branch for the new worktree", default=f"{current_branch}-worktree")
                if not valid_branch_name(path, branch):
                    failure("Invalid branch name.")
                    continue
                if branch in local_branch_names(path):
                    command = ["git", "worktree", "add", str(target), branch]
                    why = "Checks out the existing branch in a separate directory."
                else:
                    command = ["git", "worktree", "add", "-b", branch, str(target)]
                    why = "Creates a new branch at the current commit and checks it out in a separate directory."
                explain(
                    "Runs git worktree add.",
                    why,
                    "The worktree shares history but has its own working files and index. "
                    "Nothing is copied or overwritten.",
                )
                print("Command: " + col(shlex.join(command), "dim"))
                if not confirm("Create this worktree?", True):
                    continue
                result = self.run_action(command, cwd=path, timeout=60)
                if result.combined:
                    print(result.combined)
                if self.dry_run:
                    info("DRY RUN: worktree was not created.")
                elif result.returncode == 0:
                    success(f"Worktree created: {target}")
                else:
                    failure("Worktree creation failed.")
            elif choice == "3":
                listing = git_out(path, "worktree", "list", "--porcelain")
                worktrees: List[str] = []
                current: Dict[str, str] = {}
                for line in listing.splitlines() + [""]:
                    if not line:
                        if current.get("worktree"):
                            worktrees.append(current["worktree"])
                        current = {}
                    elif line.startswith("worktree "):
                        current["worktree"] = line[len("worktree "):]
                if len(worktrees) < 2:
                    warning("There is no linked worktree to remove.")
                    continue
                print("  Worktrees: " + ", ".join(worktrees))
                target_text = ask("Worktree path to remove")
                target = Path(os.path.expanduser(target_text))
                if not target.is_absolute():
                    target = (path / target).resolve()
                if str(target) not in worktrees:
                    failure("Choose one of the listed worktrees.")
                    continue
                if target.resolve() == path.resolve():
                    failure("Refusing to remove the main worktree.")
                    continue
                phrase = f"REMOVE WORKTREE {target}"
                typed = ask(f'Type "{phrase}" to remove it', allow_empty=True)
                if typed != phrase:
                    info("Worktree removal cancelled.")
                    continue
                explain(
                    f"Runs git worktree remove {target}.",
                    "This deletes that checkout's working files and removes its worktree metadata.",
                    "Dirty worktrees are refused by Git; the app never uses --force. Branches and commits remain.",
                )
                result = self.run_action(["git", "worktree", "remove", str(target)], cwd=path, timeout=60)
                if result.combined:
                    print(result.combined)
                if self.dry_run:
                    info("DRY RUN: worktree was not removed.")
                elif result.returncode == 0:
                    success("Worktree removed.")
                else:
                    failure("Worktree removal failed; it may contain uncommitted changes.")
            elif choice == "4":
                dry = git_out(path, "worktree", "prune", "--dry-run")
                print(dry or "(nothing to prune)")
                if confirm("Prune stale worktree metadata?", True):
                    result = self.run_action(["git", "worktree", "prune"], cwd=path, timeout=30)
                    if self.dry_run:
                        info("DRY RUN: worktree metadata was not pruned.")
                    elif result.returncode == 0:
                        success("Worktree metadata pruned.")
                    else:
                        failure("Worktree prune failed.")
            elif choice == "5":
                print(git_out(path, "submodule", "status", "--recursive") or "(no submodules)")
            elif choice == "6":
                if not (path / ".gitmodules").exists():
                    info("No .gitmodules file found.")
                    continue
                explain(
                    "Runs git submodule update --init --recursive.",
                    "Clones missing submodules and checks each one out at the commit recorded by the parent repository.",
                    "This contacts submodule remotes and does not update parent history by itself.",
                )
                if not confirm("Initialize/update all submodules?", True):
                    continue
                result = self.run_action(["git", "submodule", "update", "--init", "--recursive"], cwd=path, timeout=600, env_extra=remote_env())
                if result.combined:
                    print(result.combined)
                if self.dry_run:
                    info("DRY RUN: submodules were not updated.")
                elif result.returncode == 0:
