    def apply_recommended_settings(self) -> None:
        config = read_global_config()
        changes: List[Tuple[str, str, bool]] = []
        name = cfg_get(config, "user.name")
        email = cfg_get(config, "user.email")
        if not name.strip():
            name = ask("Git user.name")
            changes.append(("user.name", name, False))
        if not email.strip() or not EMAIL_RE.match(email.strip()):
            email = ask_email("Git user.email", default=email or None)
            changes.append(("user.email", email, False))

        if cfg_get(config, "init.defaultbranch").lower() != "main":
            changes.append(("init.defaultBranch", "main", False))
        if cfg_get(config, "pull.ff").lower() != "only":
            changes.append(("pull.ff", "only", False))
        if cfg_get(config, "push.default").lower() != "simple":
            changes.append(("push.default", "simple", False))
        if cfg_get(config, "fetch.prune").lower() != "true":
            changes.append(("fetch.prune", "true", False))
        if not cfg_get(config, "core.editor"):
            changes.append(("core.editor", os.environ.get("EDITOR") or "nano", False))

        key_value = cfg_get(config, "user.signingkey")
        _, key_text, key_error = resolve_public_key(key_value) if key_value else (None, None, "not set")
        if not key_text or key_error:
            key_value = self.choose_signing_key(config) or ""
            if key_value:
                _, key_text, key_error = resolve_public_key(key_value)
                changes.append(("gpg.format", "ssh", False))
                changes.append(("user.signingkey", key_value, False))
                changes.append(("commit.gpgsign", "true", False))
        else:
            if cfg_get(config, "gpg.format").lower() != "ssh":
                changes.append(("gpg.format", "ssh", False))
            if cfg_get(config, "commit.gpgsign").lower() != "true":
                changes.append(("commit.gpgsign", "true", False))

        if not signing_url_rewrite(config):
            changes.append(("url.git@github.com:.insteadOf", "https://github.com/", True))

        allowed_value = cfg_get(config, "gpg.ssh.allowedSignersFile")
        allowed_path = find_existing_path(allowed_value) if allowed_value else None
        configure_allowed = False
        if key_text and email:
            if not allowed_path or not allowed_path.is_file():
                configure_allowed = True
            else:
                wanted = key_data(key_text)
                configure_allowed = not any(
                    allowed_signers_key_data(line) == wanted
                    for line in read_text(allowed_path).splitlines()
                    if line.strip() and not line.strip().startswith("#")
                )

        if not changes and not configure_allowed:
            success("Recommended settings are already in place.")
            return
        print()
        print(col("Planned changes:", "bold"))
        for key, value, add in changes:
            print(f"  + {key} = {value}" + (" (add)" if add else ""))
            _, why = SETTING_HELP.get(key.lower(), ("", ""))
            if why:
                print(wrap("    Why: " + why, indent="      "))
        if configure_allowed:
            print("  + create/update allowed_signers and set gpg.ssh.allowedSignersFile")
            print(wrap("    Why: " + SETTING_HELP["gpg.ssh.allowedsignersfile"][1], indent="      "))
        print()
        if not confirm("Apply these changes to the global Git config?", True):
            return
        for key, value, add in changes:
            set_global_config(key, value, add=add)
        if configure_allowed and key_text:
            self.ensure_allowed_signers(key_value, email, confirm_write=False)
        print()
        print_report(build_global_report(read_global_config(), deep=False), only_problems=True)

