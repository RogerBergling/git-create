    # -- verification -------------------------------------------------------

    def verify_path(self, path: Path, deep: Optional[bool] = None) -> Report:
        root = detect_git_root(path)
        if root is None:
            failure(f"Not a Git repository: {path}")
            return Report("Verification")
        if deep is None:
            deep = confirm("Include network checks (remote, GitHub, signing-key registration)?", True)
        info("Verification is read-only: it does not change config, files, commits, or remotes.")
        if deep:
            info("Deep checks also contact the remote and GitHub, run git fsck, and verify signing-key registration.")
        print(col("Running verification...", "dim"))
        sys.stdout.flush()
        report = combined_report(root, deep=deep, scan_content=True)
        print_report(report)
        self.offer_fixes(report)
        return report

    def verify_current(self) -> None:
        project = self.require_project()
        if project:
            self.verify_path(project)

    def offer_fixes(self, report: Report) -> None:
        checks = report.checks()
        if any(check.level in ("FAIL", "WARN") for check in checks if "tracked files" in check.label and "Sensitive" in check.label):
            failure("Sensitive files are already tracked. Fix this before making another commit; if they were pushed, rotate the credentials.")
        global_problem = any(
            check.level in ("FAIL", "WARN")
            for section in report.sections
            if section.title.startswith("Global")
            for check in section.checks
        )
        files_problem = any(
            check.level in ("FAIL", "WARN")
            for section in report.sections
            if section.title in ("Important files", "Ignore rules")
            for check in section.checks
        )
        if global_problem and confirm("Open the global settings wizard now?", False):
            self.settings_action()
        if files_problem and confirm("Open the project-files wizard now?", False):
            self.files_action()

    # -- project selection and scanning ------------------------------------

    def select_project(self) -> None:
        default = self.project
        if default is None:
            default = DEFAULT_PROJECTS if DEFAULT_PROJECTS.exists() else Path.cwd()
        path = ask_path("Project directory", default=default)
        root = detect_git_root(path)
        if root is None:
            failure(f"No Git repository found at or above {path}.")
            info("Use option 2 to scan a folder, or option 6 to publish a local project.")
            return
        self.project = root
        success(f"Active project: {root}")

    def scan_action(self) -> None:
        if self.project:
            default = self.project.parent
        elif DEFAULT_PROJECTS.exists():
            default = DEFAULT_PROJECTS
        else:
            default = Path.cwd()
        path = ask_path("Folder to scan", default=default)
        if not path.exists() or not path.is_dir():
            failure(f"Not a directory: {path}")
            return
        depth_text = ask("Maximum depth", default=str(DEFAULT_DEPTH))
        try:
            depth = max(1, min(int(depth_text), 10))
        except ValueError:
            depth = DEFAULT_DEPTH
        explain(
            "Walks the selected folder down to the requested depth and looks for .git "
            "repositories, then reads their branch, status, upstream, and last commit.",
            "A quick overview helps you find projects, notice dirty worktrees, and choose "
            "the right repository before running dangerous or remote-changing actions.",
            "Scanning is read-only. It does not fetch, commit, modify, or push anything.",
        )
        repos = scan_repositories(path, depth)
        print_scan_results(path, repos, depth)
        if not repos:
            return
        choice = ask("Number to make active and verify (Enter to return)", allow_empty=True)
        if not choice:
            return
        try:
            index = int(choice)
            if not 1 <= index <= len(repos):
                raise IndexError
            selected = repos[index - 1]
        except (ValueError, IndexError):
            warning("Invalid selection.")
            return
        self.project = Path(selected["path"])
        success(f"Active project: {self.project}")
        if confirm("Run verification now?", True):
            self.verify_path(self.project)

    def scenario_a(self) -> None:
        heading("Scenario A - new GitHub repository and clone")
        if not ensure_gh(require_auth=True, offer_login=True):
            return
        default_parent = DEFAULT_PROJECTS if DEFAULT_PROJECTS.exists() else Path.cwd()
        parent = ask_path("Parent folder", default=default_parent)
        if not parent.exists():
            if not confirm(f"Create parent folder {parent}?", True):
                return
            try:
                parent.mkdir(parents=True, exist_ok=True)
            except OSError as exc:
                failure(f"Could not create {parent}: {exc}")
                return
        name = ask_repo_name("Repository name", default="my-project")
        target = parent / name
        if target.exists():
            failure(f"Destination already exists: {target}")
            info("Choose another name, or use scenario B/C/D for the existing directory.")
            return
        visibility = ask_visibility("private")
        description = ask("Description (optional)", allow_empty=True)
        command = [which_gh() or "gh", "repo", "create", name, f"--{visibility}", "--add-readme", "--clone"]
        if description:
            command.extend(["--description", description])
        explain(
            "Creates a new GitHub repository, adds an initial README commit on GitHub, "
            "and clones it into the chosen parent folder.",
            "Starting from a remote README gives you a known-good first commit and an "
            "origin remote already connected, so the local project starts in a safe state.",
            "The app refuses to run if the destination folder already exists. Nothing is overwritten.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm("Create the repository and clone it?", True):
            return
        result = run_cmd(command, cwd=parent, timeout=300)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("GitHub repository creation/clone failed.")
            info("If the repository was created but the clone failed, clone it with scenario B.")
            return
        if not target.exists():
            warning(f"Command succeeded, but {target} was not found.")
            return
        self.project = target
        success(f"Created and cloned: {target}")
        if confirm("Run a full verification now?", True):
            self.verify_path(target, deep=True)

    def scenario_b(self) -> None:
        heading("Scenario B - clone an existing GitHub repository")
        gh = which_gh()
        spec = ask("Repository (OWNER/REPO or full URL)")
        is_url = "://" in spec or spec.startswith("git@")
        if spec.startswith("-"):
            failure("Repository argument must not start with '-'.")
            return
        if not is_url and not GH_REPO_SPEC_RE.match(spec):
            failure("Use OWNER/REPO or a full git URL.")
            return
        if not is_url and not ensure_gh(require_auth=True, offer_login=True):
            return
        default_parent = DEFAULT_PROJECTS if DEFAULT_PROJECTS.exists() else Path.cwd()
        parent = ask_path("Parent folder", default=default_parent)
        if not parent.exists():
            if not confirm(f"Create parent folder {parent}?", True):
                return
            try:
                parent.mkdir(parents=True, exist_ok=True)
            except OSError as exc:
                failure(f"Could not create {parent}: {exc}")
                return
        clean = spec.rstrip("/")
        if clean.endswith(".git"):
            clean = clean[:-4]
        target_name = clean.rsplit("/", 1)[-1].split(":")[-1]
        target = parent / target_name
        if target.exists():
            failure(f"Destination already exists: {target}")
            info("Refusing to clone over an existing directory. Choose another parent or use scenario D.")
            return
        if is_url:
            command = ["git", "clone", spec]
        else:
            command = [gh or "gh", "repo", "clone", spec]
        explain(
            "Downloads the repository and checks out its default branch into a new local folder.",
            "Cloning gives you the full commit history and an origin remote, so your local "
            "copy can fetch, compare, commit, and push correctly.",
            "The app refuses to clone over an existing directory. It will not merge into local work.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm("Clone the repository?", True):
            return
        result = run_cmd(command, cwd=parent, timeout=300)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Clone failed.")
            info("Check the repository name, permissions, gh authentication, and SSH key/agent.")
            return
        if not target.exists():
            warning(f"Clone completed, but expected directory was not found: {target}")
            return
        self.project = target
        success(f"Cloned: {target}")
        if confirm("Run a full verification now?", True):
            self.verify_path(target, deep=True)

    def scenario_c(self) -> None:
        heading("Scenario C - publish an existing local project")
        default = self.project or Path.cwd()
        path = ask_path("Project directory", default=default)
        if not path.exists():
            failure(f"Directory does not exist: {path}")
            return
        if not path.is_dir():
            failure(f"Not a directory: {path}")
            return
        existing_root = detect_git_root(path)
        if existing_root is not None:
            if existing_root == path:
                warning("This directory is already a Git repository.")
                info("Use scenario D to compare it with a remote, or option 8 to commit/push.")
            else:
                warning(f"This directory is inside an existing repository: {existing_root}")
                info("Refusing to create a nested repository. Select the actual project folder or move it out.")
            return
        if not ensure_gh(require_auth=True, offer_login=True):
            return
        try:
            is_empty = not any(path.iterdir())
        except OSError as exc:
            failure(f"Could not read directory: {exc}")
            return
        if is_empty:
            warning("The directory is empty.")
            info("Scenario A is usually better for a brand-new empty project because it creates a README on GitHub.")
            if not confirm("Continue with scenario C anyway?", False):
                return
        explain(
            "Runs git init -b main, which creates the hidden .git repository and makes "
            "main the first branch.",
            "Git cannot track, stage, commit, or push anything until the folder is a "
            "repository. main is used consistently as the default branch.",
            "This only creates .git; it does not modify, delete, or upload your project files.",
        )
        if not confirm(f"Initialize Git in {path}?", True):
            return
        init_result = run_cmd(["git", "init", "-b", "main"], cwd=path, timeout=30)
        if init_result.returncode != 0:
            fallback = run_cmd(["git", "init"], cwd=path, timeout=30)
            if fallback.returncode == 0:
                run_cmd(["git", "symbolic-ref", "HEAD", "refs/heads/main"], cwd=path, timeout=10)
            else:
                failure("git init failed.")
                print(init_result.combined or fallback.combined)
                return
        success(f"Initialized repository: {path}")
        self.project = path

        ensure_gitignore(path)
        ensure_readme(path)
        if dockerfile_present(path):
            ensure_dockerignore(path)
        if (path / ".env").exists():
            ensure_env_example(path)

        if not identity_ready(path):
            info("The repository was initialized but no commit was created.")
            return
        if not stage_changes(path):
            info("No files were staged. Nothing was committed or published.")
            return
        if not review_staged_safety(path):
            return
        print()
        print(col("Staged changes:", "bold"))
        print(git_out(path, "diff", "--cached", "--stat"))
        explain(
            "git commit records the staged snapshot as the first commit in local history.",
            "This is the checkpoint that will be pushed to GitHub. Creating it locally "
            "first means a GitHub failure cannot lose your work.",
            "Nothing is uploaded yet. If signing fails, the repository and staged files remain intact.",
        )
        message = ask("Initial commit message", default="Initial commit")
        commit_result = run_cmd(["git", "commit", "-m", message], cwd=path, timeout=180)
        if commit_result.combined:
            print(commit_result.combined)
        if commit_result.returncode != 0:
            failure("Commit failed. The local repository remains intact; fix the error and use option 8.")
            print_signing_help()
            return
        success("Initial commit created.")

        remotes = remote_urls(path)
        if remotes:
            failure(f"Remote(s) already exist: {', '.join(remotes)}")
            info("Use scenario D instead. No remote was changed.")
            return
        default_name = re.sub(r"[^A-Za-z0-9._-]+", "-", path.name).strip("-") or "project"
        repo_name = ask_repo_name("GitHub repository name", default=default_name)
        visibility = ask_visibility("private")
        description = ask("Description (optional)", allow_empty=True)
        command = [
            which_gh() or "gh",
            "repo",
            "create",
            repo_name,
            f"--{visibility}",
            "--source",
            ".",
            "--remote",
            "origin",
            "--push",
        ]
        if description:
            command.extend(["--description", description])
        explain(
            "gh repo create creates the GitHub repository, adds it as the origin remote, "
            "and pushes the local initial commit.",
            "Publishing connects the verified local history to a remote backup that can be "
            "cloned from another machine.",
            "If creation or push fails, the local repository and commit stay safe. The app never force-pushes.",
        )
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm("Create the GitHub repository and push the initial commit?", True):
            info("Local repository and commit were kept. You can publish later with option 8 after adding a remote.")
            return
        result = run_cmd(command, cwd=path, timeout=300)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("GitHub repository creation or push failed.")
            info("The local repository and commit are safe. No force was used. Fix the error and retry.")
            return
        success("Published to GitHub.")
        if confirm("Run a full verification now?", True):
            self.verify_path(path, deep=True)

    def scenario_d(self) -> None:
        heading("Scenario D - local and remote history diagnosis")
        path = self.require_project()
        if path is None:
            return
        remotes = remote_urls(path)
        if "origin" not in remotes:
            warning("No origin remote. This looks like a local-only project.")
            info("Use scenario C to publish it, or add a remote manually.")
            return
        branch = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        if not branch:
            failure("Detached HEAD. Check out a branch before diagnosing or syncing.")
            return
        warning("No force push will be used. A force push can destroy remote history.")
        print("Origin: " + origin_display(path))
        print("Local branch: " + branch)
        explain(
            "Runs git fetch --prune origin. Fetch downloads remote commits and branch "
            "information, then removes local remote-tracking refs for branches that no "
            "longer exist on origin.",
            "You need an up-to-date picture of the remote before deciding whether local is "
            "ahead, behind, or diverged. Fetch does not change your working files.",
            "Fetch is read-only for your branch and files. It does not merge or push.",
        )
        if not confirm("Fetch origin (read-only) now?", True):
            return
        fetch_result = git(path, "fetch", "--prune", "origin", timeout=120, env_extra=remote_env())
        if fetch_result.combined:
            print(fetch_result.combined)
        if fetch_result.returncode != 0:
            failure("Fetch failed. Check network, SSH agent/key, and remote URL.")
            return

        remote_ref = git_out(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
        if not remote_ref:
            candidate = f"origin/{branch}"
            if git(path, "rev-parse", "--verify", "--quiet", candidate).returncode == 0:
                remote_ref = candidate
        if not remote_ref:
            warning(f"Remote branch origin/{branch} does not exist yet.")
            info("A normal 'git push -u origin " + branch + "' would create it safely; it would not force anything.")
            if confirm("Push this branch and set upstream now?", False):
                self.push_current(path)
            return
        print("Tracking reference: " + remote_ref)

        backup_name = f"backup/{branch}-{time.strftime('%Y%m%d-%H%M%S')}"
        explain(
            f"Runs git branch {backup_name} HEAD, creating another local name for the "
            "current commit.",
            "A branch is a cheap safety bookmark. If a later merge or rebase is confusing, "
            "the backup branch still points at the exact pre-sync state.",
            "The backup branch stays local. It is not pushed and can be deleted later.",
        )
        if confirm(f"Create local backup branch '{backup_name}' before any sync?", True):
            result = git(path, "branch", backup_name, "HEAD", timeout=10)
            if result.returncode == 0:
                success(f"Backup branch created: {backup_name}")
            else:
                warning("Could not create backup branch: " + one_line(result.combined))

        merge_base = git(path, "merge-base", "HEAD", remote_ref, timeout=20)
        counts_result = git(path, "rev-list", "--left-right", "--count", f"HEAD...{remote_ref}", timeout=20)
        ahead = behind = 0
        if counts_result.returncode == 0:
            values = counts_result.out.split()
            if len(values) == 2:
                ahead, behind = int(values[0]), int(values[1])

        heading("History")
        if merge_base.returncode == 0 and merge_base.out.strip():
            print("Common ancestor: " + merge_base.out.strip())
        else:
            print(col("No common ancestor found.", "red"))
        print()
        print(git_out(path, "log", "--oneline", "--graph", "--decorate", "--all", "-n", "30"))
        print()
        print(git_out(path, "branch", "-avv"))
        print()
        print(f"Local is {col(str(ahead), 'cyan')} commit(s) ahead and {col(str(behind), 'cyan')} commit(s) behind {remote_ref}.")

        if merge_base.returncode != 0:
            warning("The histories appear to be unrelated (no common base).")
            print(
                "Do not force. Decide which history is canonical, keep the backup branch, and merge with "
                "'git merge --allow-unrelated-histories' only after reviewing both trees."
            )
            return
        if ahead == 0 and behind == 0:
            success("Local and remote histories are in sync.")
            return
        if ahead and not behind:
            info("Local is ahead only. A normal push is safe.")
            if confirm("Push now (normal push, no force)?", False):
                self.push_current(path)
            return
        if behind and not ahead:
            entries = status_entries(path)
            if entries:
                warning("Local is behind, but the working tree has changes.")
                info("Commit or stash your work first. Then use 'git pull --ff-only'.")
                return
            info("Local is behind only. A fast-forward pull is safe and will not create a merge commit.")
            explain(
                "Runs git pull --ff-only origin <branch>. This fetches and then moves the "
                "local branch pointer forward to the remote commit.",
                "Because local has no unique commits, the branch can advance without a merge "
                "commit. --ff-only makes Git refuse if that is not possible.",
                "The working tree must be clean. The backup branch remains available.",
            )
            if confirm("Run 'git pull --ff-only' now?", False):
                result = git(path, "pull", "--ff-only", "origin", branch, timeout=180, env_extra=remote_env())
                if result.combined:
                    print(result.combined)
                if result.returncode == 0:
                    success("Fast-forward pull completed. Backup branch kept locally.")
                else:
                    failure("Fast-forward pull failed. Nothing was forced.")
            return
        warning("The branches have diverged (both ahead and behind).")
        print(
            "Recommended: keep the backup branch, inspect the log and diff, then choose merge or rebase manually. "
            "This tool intentionally does not auto-merge, auto-rebase, or force-push diverged histories."
        )
        print("Useful next commands:")
        print(f"  git log --oneline --graph --decorate --all")
        print(f"  git diff HEAD...{remote_ref}")
        print(f"  git switch {branch}")
        print(f"  # then merge/rebase deliberately, run tests, and push normally")

    # -- commit and push ----------------------------------------------------

    def commit_and_push_action(self) -> None:
        path = self.require_project()
        if path is None:
            return
        if not git_out(path, "symbolic-ref", "--short", "-q", "HEAD"):
            failure("Detached HEAD. Check out a branch before committing; the current commit would not belong to a branch.")
            return
        operations = in_progress_operations(path)
        if operations:
            failure("A Git operation is in progress: " + ", ".join(operations))
            info("Finish or safely abort it before using the commit workflow.")
            return
        entries = status_entries(path)
        if not entries:
            success("Working tree is clean; nothing to commit.")
            if confirm("Push existing commits now?", False):
                self.push_current(path)
            return
        if not identity_ready(path):
            return
        if not stage_changes(path):
            return
        if not review_staged_safety(path):
            return
        print()
        print(col("Staged changes:", "bold"))
        print(git_out(path, "diff", "--cached", "--stat"))
        explain(
            "git commit saves the staged snapshot as a new local commit with your message.",
            "The commit is a checkpoint you can review, sign, and push. It does not upload "
            "anything, so a signing or message problem does not affect the remote.",
            "Only staged content is included. The secret scan already checked that content.",
        )
        message = ask("Commit message (leave empty to open editor)", default="", allow_empty=True)
        if not message and not sys.stdin.isatty():
            failure("A commit message is required in a non-interactive session.")
            return
        if message:
            result = run_cmd(["git", "commit", "-m", message], cwd=path, timeout=180)
            if result.combined:
                print(result.combined)
            if result.returncode != 0:
                failure("Commit failed. Nothing was pushed.")
                print_signing_help()
                return
        else:
            code = run_interactive(["git", "commit"], cwd=path)
            if code != 0:
                failure("Commit failed or was cancelled. Nothing was pushed.")
                print_signing_help()
                return
        success("Commit created.")
        if confirm("Push now (normal push, no force)?", True):
            self.push_current(path)

    def push_current(self, path: Path) -> bool:
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or safely abort it before pushing.")
            return False
        branch = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        if not branch:
            failure("Detached HEAD; check out a branch before pushing.")
            return False
        remotes = remote_urls(path)
        if "origin" not in remotes:
            failure("No origin remote.")
            info("Publish the project with scenario C, or add a remote manually.")
            return False
        explain(
            "git push uploads local commits to the remote branch. On the first push, -u "
            "also records that remote branch as the upstream for this local branch.",
            "Pushing creates the shared copy on GitHub and lets other machines clone or "
            "fetch your work. Upstream lets later pushes and pulls use the right branch.",
            "The app uses a normal push only. If the remote has commits you do not have, "
            "Git rejects the push and the app directs you to scenario D instead of forcing.",
        )
        upstream = git_out(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
        if upstream:
            counts = git(path, "rev-list", "--left-right", "--count", f"HEAD...{upstream}", timeout=15)
            if counts.returncode == 0:
                values = counts.out.split()
                if len(values) == 2:
                    ahead, behind = int(values[0]), int(values[1])
                    if behind:
                        warning(f"Local is {behind} commit(s) behind {upstream}; a normal push may be rejected.")
                        info("Use option 7 (scenario D) to diagnose, or pull --ff-only after committing/stashing local work.")
                        if not confirm("Attempt a normal (non-force) push anyway?", False):
                            return False
        command = ["git", "push"]
        if not upstream:
            command = ["git", "push", "-u", "origin", branch]
        print()
        print("Command: " + col(shlex.join(command), "dim"))
        result = run_cmd(command, cwd=path, timeout=300, env_extra=remote_env())
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"Pushed branch '{branch}'.")
            return True
        failure("Push failed. No force was used and no history was rewritten.")
        if re.search(r"non-fast-forward|fetch first|\[rejected\]|failed to push", result.combined, re.IGNORECASE):
            info("The remote has commits you do not have locally. Use option 7 (scenario D) to compare histories.")
        else:
            info("Check SSH agent/key and gh authentication. Example: eval \"$(ssh-agent -s)\" && ssh-add ~/.ssh/<key>")
        return False

    # -- rename -------------------------------------------------------------

    def rename_action(self) -> None:
        heading("Rename project")
        path = self.require_project()
        if path is None:
            return
        old_folder = path.name
        remotes = remote_urls(path)
        origin_url = remotes.get("origin", "")
        github = parse_github_url(origin_url) if origin_url else None
        print("Current local folder: " + old_folder)
        print("Origin: " + (origin_url or "(none)"))
        print()
        print(col("Git does not track the directory name itself.", "dim"))
        print("This action can rename the local folder and/or the GitHub repository. It never rewrites history.")
        explain(
            "A local rename is just mv (or git worktree move for a linked worktree). A "
            "GitHub rename is gh repo rename, followed by a check of the origin URL.",
            "The folder name and the repository name are separate things. Changing them "
            "keeps your history but makes the names match what you intend.",
            "No commits are rewritten. GitHub redirects the old repository name, and the "
            "app repairs origin if gh did not update it.",
        )
        new_folder = ask("New local folder name", default=old_folder)
        if "/" in new_folder or new_folder in (".", "..") or not new_folder:
            failure("Folder name must not contain '/' and cannot be '.' or '..'.")
            return
        rename_local = new_folder != old_folder and confirm(f"Rename local folder to '{new_folder}'?", True)
        rename_github = False
        new_github_name = ""
        if github:
            owner, repo = github
            print(f"GitHub repository: {owner}/{repo}")
            new_github_name = ask_repo_name("New GitHub repository name", default=repo)
            rename_github = new_github_name != repo and confirm(
                f"Rename GitHub repository {owner}/{repo} to {owner}/{new_github_name}?", False
            )
            if rename_github and not ensure_gh(require_auth=True, offer_login=True):
                warning("GitHub rename skipped. Any selected local folder rename will continue.")
                rename_github = False
        if not rename_local and not rename_github:
            info("Nothing to rename.")
            return

        old_path = path
        if rename_local:
            destination = path.parent / new_folder
            if destination.exists():
                failure(f"Destination already exists: {destination}")
                return
            linked = is_linked_worktree(path)
            if linked:
                command = ["git", "worktree", "move", str(path), str(destination)]
                warning("This is a linked worktree; using 'git worktree move' so Git's metadata stays consistent.")
            else:
                command = ["mv", str(path), str(destination)]
            print("Command: " + col(shlex.join(command), "dim"))
            if not confirm("Proceed with local folder rename?", True):
                return
            if linked:
                result = run_cmd(command, cwd=path, timeout=30)
                if result.returncode != 0:
                    failure("Local worktree move failed: " + one_line(result.combined))
                    return
            else:
                try:
                    os.rename(path, destination)
                except OSError as exc:
                    failure(f"Local rename failed: {exc}")
                    return
            self.project = destination
            path = destination
            success(f"Local folder renamed to {destination}")
            print(col(f"Your shell is still in the old path if you launched from it. Run: cd {shlex.quote(str(destination))}", "dim"))

        if rename_github and github:
            owner, repo = github
            gh = which_gh() or "gh"
            command = [gh, "repo", "rename", new_github_name, "--yes"]
            explain(
                "Runs gh repo rename to rename the repository on GitHub. The app then "
                "checks that origin points at the new name and repairs it if necessary.",
                "GitHub repository names are part of clone URLs and web links. Renaming "
                "keeps them consistent with the new project name.",
                "The commit history is unchanged. GitHub redirects the old name for now, "
                "but other clones and external links still need updating.",
            )
            print("Command: " + col(shlex.join(command), "dim"))
            if not confirm("Rename the GitHub repository now? Old URLs will redirect.", True):
                return
            result = run_cmd(command, cwd=path, timeout=60)
            if result.combined:
                print(result.combined)
            if result.returncode != 0:
                failure("GitHub repository rename failed. The local folder rename (if any) was kept.")
                return
            success(f"GitHub repository renamed to {owner}/{new_github_name}.")
            current_url = git_out(path, "remote", "get-url", "origin")
            expected_url = ""
            if current_url.startswith("git@github.com:"):
                expected_url = f"git@github.com:{owner}/{new_github_name}.git"
            elif current_url.startswith("ssh://git@github.com/"):
                expected_url = f"ssh://git@github.com/{owner}/{new_github_name}.git"
            elif current_url.startswith("https://github.com/"):
                expected_url = f"https://github.com/{owner}/{new_github_name}.git"
            if expected_url and current_url != expected_url:
                fix = git(path, "remote", "set-url", "origin", expected_url, timeout=10)
                if fix.returncode == 0:
                    success(f"Updated origin to {expected_url}")
                else:
                    warning("Could not update origin automatically: " + one_line(fix.combined))
            info("The old GitHub name redirects for now, but update any external links and local clones.")
        entries = status_entries(path)
        if entries and confirm("Working tree has changes. Commit and push them now?", False):
            self.commit_and_push_action()

