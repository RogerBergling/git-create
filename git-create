            "A secret removed in a later commit still exists in the old commit. Working-tree "
            "scanning cannot see it, and deleting the file does not remove it from history.",
            "This is read-only. It is bounded by commit/blob/size limits, skips binary and "
            "large blobs, and cannot prove that every possible custom secret is absent.",
        )
        if not confirm("Scan reachable Git history now?", True):
            return
        print(col("Scanning history (this can take a while on large repositories)...", "dim"))
        sys.stdout.flush()
        result = scan_history_secrets(path)
        heading("History secret scan")
        print(
            f"  Commits scanned: {result['commits_scanned']}/{result['commits_total']}  "
            f"Blobs scanned: {result['blobs_scanned']}/{result['blobs_total']}  "
            f"Bytes: {format_size(int(result['bytes_scanned']))}"
        )
        findings = result.get("findings") or []
        if findings:
            high_risk = any(bool(item.get("high_risk")) for item in findings if isinstance(item, dict))
            failure(f"Potential secrets found in {len(findings)} history location(s).")
            for item in findings[:20]:
                if not isinstance(item, dict):
                    continue
                line = int(item.get("line") or 0)
                location = str(item.get("path")) + (f":{line}" if line else "")
                print(
                    f"  - {location} "
                    f"({item.get('kind')}, blob {item.get('object')})"
                )
            print()
            info("Rotate any real credential first. Then remove it from history with a dedicated tool such as git filter-repo.")
            if high_risk:
                info("A private-key header or sensitive filename was found; treat any associated credential as exposed until proven otherwise.")
        else:
            success("No common secret patterns found in the scanned history.")
        if result.get("truncated"):
            warning("History scan limits were reached; older or larger blobs were not fully scanned.")
            print("  Limits: " + f"{result['max_commits']} commits, {result['max_blobs']} blobs, 2 MiB per blob.")

