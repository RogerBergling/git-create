def build_global_report(config: Optional[Dict[str, List[str]]] = None, deep: bool = False) -> Report:
    config = config if config is not None else read_global_config()
    report = Report("Global configuration")
    report.meta["deep"] = deep

    tools = report.section("Global tools")
    git_version = run_cmd(["git", "--version"], timeout=5)
    if git_version.returncode == 0:
        tools.checks.append(Check("PASS", "git", one_line(git_version.out, 80)))
    else:
        tools.checks.append(Check("FAIL", "git", "not installed", "Install git before using this tool."))

    gh = which_gh()
    if gh:
        gh_version = run_cmd([gh, "--version"], timeout=5)
        tools.checks.append(Check("PASS", "GitHub CLI (gh)", one_line(gh_version.out, 80)))
    else:
        tools.checks.append(
            Check("WARN", "GitHub CLI (gh)", "not installed", "Install gh for GitHub scenarios A-D and signing-key management.")
        )

    if shutil.which("ssh-keygen"):
        tools.checks.append(Check("PASS", "ssh-keygen", "available"))
    else:
        tools.checks.append(Check("WARN", "ssh-keygen", "not found", "Install OpenSSH client tools for SSH signing."))
    if shutil.which("ssh"):
        tools.checks.append(Check("PASS", "ssh", "available"))
    else:
        tools.checks.append(Check("WARN", "ssh", "not found", "Install OpenSSH client."))

    identity = report.section("Global identity")
    name = cfg_get(config, "user.name")
    email = cfg_get(config, "user.email")
    if name.strip():
        identity.checks.append(Check("PASS", "user.name", name))
    else:
        identity.checks.append(
            Check("FAIL", "user.name", "not set", 'Run: git config --global user.name "Your Name"')
        )
    if email.strip() and EMAIL_RE.match(email.strip()):
        identity.checks.append(Check("PASS", "user.email", email))
    elif email.strip():
        identity.checks.append(
            Check("FAIL", "user.email", f"invalid address: {email}", 'Run: git config --global user.email "you@example.com"')
        )
    else:
        identity.checks.append(
            Check("FAIL", "user.email", "not set", 'Run: git config --global user.email "you@example.com"')
        )

    defaults = report.section("Global defaults")
    default_branch = cfg_get(config, "init.defaultbranch")
    if default_branch.lower() == "main":
        defaults.checks.append(Check("PASS", "init.defaultBranch", "main"))
    else:
        defaults.checks.append(
            Check(
                "WARN",
                "init.defaultBranch",
                default_branch or "not set (git may use master)",
                "Recommended: git config --global init.defaultBranch main",
            )
        )

    pull_ff = cfg_get(config, "pull.ff").lower()
    if pull_ff == "only":
        defaults.checks.append(Check("PASS", "pull.ff", "only"))
    else:
        defaults.checks.append(
            Check(
                "WARN",
                "pull.ff",
                pull_ff or "not set",
                "Recommended: git config --global pull.ff only (prevents accidental merge commits on pull)",
            )
        )

    push_default = cfg_get(config, "push.default").lower()
    if push_default == "simple":
        defaults.checks.append(Check("PASS", "push.default", "simple"))
    elif not push_default:
        defaults.checks.append(
            Check("INFO", "push.default", "not set (modern Git defaults to simple)", "Optional: git config --global push.default simple")
        )
    else:
        defaults.checks.append(
            Check("WARN", "push.default", push_default, "Recommended: git config --global push.default simple")
        )

    fetch_prune = cfg_get(config, "fetch.prune").lower()
    if fetch_prune == "true":
        defaults.checks.append(Check("PASS", "fetch.prune", "true"))
    elif not fetch_prune:
        defaults.checks.append(
            Check("INFO", "fetch.prune", "not set", "Optional: git config --global fetch.prune true")
        )
    else:
        defaults.checks.append(Check("WARN", "fetch.prune", fetch_prune, "Recommended: git config --global fetch.prune true"))

    editor = cfg_get(config, "core.editor")
    if editor.strip():
        defaults.checks.append(Check("PASS", "core.editor", editor))
    else:
        defaults.checks.append(
            Check("WARN", "core.editor", "not set", "Recommended: git config --global core.editor nano")
        )

    signing = report.section("Global SSH signing")
    gpg_format = cfg_get(config, "gpg.format").lower()
    if gpg_format == "ssh":
        signing.checks.append(Check("PASS", "gpg.format", "ssh"))
    else:
        signing.checks.append(
            Check("WARN", "gpg.format", gpg_format or "not set", "Recommended: git config --global gpg.format ssh")
        )

    signing_key_value = cfg_get(config, "user.signingkey")
    if signing_key_value:
        key_path, key_text, error = resolve_public_key(signing_key_value)
        if error:
            signing.checks.append(
                Check("WARN", "user.signingkey", error, "Point user.signingkey at your SSH public key, e.g. ~/.ssh/id_ed25519.pub")
            )
        else:
            fingerprint = key_fingerprint(key_path)
            detail = str(key_path) if key_path else "inline public key"
            if fingerprint:
                detail += f" ({fingerprint})"
            signing.checks.append(Check("PASS", "user.signingkey", detail))
            level, private_detail, private_hint = private_key_state(key_path)
            if level != "SKIP":
                signing.checks.append(Check(level, "SSH private key", private_detail, private_hint))
    else:
        signing.checks.append(
            Check(
                "WARN",
                "user.signingkey",
                "not set",
                "Recommended: git config --global user.signingkey ~/.ssh/id_ed25519.pub",
            )
        )

    commit_sign = cfg_get(config, "commit.gpgsign").lower()
    if commit_sign == "true":
        signing.checks.append(Check("PASS", "commit.gpgsign", "true"))
    else:
        signing.checks.append(
            Check(
                "WARN",
                "commit.gpgsign",
                commit_sign or "not set",
                "Recommended: git config --global commit.gpgsign true",
            )
        )

    tag_sign = cfg_get(config, "tag.gpgsign").lower()
    signing.checks.append(
        Check(
            "PASS" if tag_sign == "true" else "INFO",
            "tag.gpgsign",
            tag_sign or "not set",
            "Optional: git config --global tag.gpgsign true (signs annotated tags)",
        )
    )

    allowed = cfg_get(config, "gpg.ssh.allowedSignersFile")
    if allowed:
        allowed_path = find_existing_path(allowed)
        if allowed_path and allowed_path.is_file():
            _, configured_key_text, _ = resolve_public_key(signing_key_value) if signing_key_value else (None, None, "")
            if configured_key_text:
                wanted = key_data(configured_key_text)
                present = any(
                    allowed_signers_key_data(line) == wanted
                    for line in read_text(allowed_path).splitlines()
                    if line.strip() and not line.strip().startswith("#")
                )
                if present:
                    signing.checks.append(
                        Check("PASS", "gpg.ssh.allowedSignersFile", f"{allowed_path} (signing key present)")
                    )
                else:
                    signing.checks.append(
                        Check(
                            "WARN",
                            "gpg.ssh.allowedSignersFile",
                            f"{allowed_path} exists but the configured signing key is not listed",
                            "Use option 10 to append the configured public key.",
                        )
                    )
            else:
                signing.checks.append(Check("PASS", "gpg.ssh.allowedSignersFile", str(allowed_path)))
        else:
            signing.checks.append(
                Check(
                    "WARN",
                    "gpg.ssh.allowedSignersFile",
                    f"file not found: {allowed}",
                    "Create an allowed-signers file and set gpg.ssh.allowedSignersFile to verify SSH-signed commits locally.",
                )
            )
    else:
        signing.checks.append(
            Check(
                "WARN",
                "gpg.ssh.allowedSignersFile",
                "not set; SSH signatures will show as unknown locally",
                "Recommended: configure gpg.ssh.allowedSignersFile so 'git log --show-signature' can verify commits.",
            )
        )

    github = report.section("GitHub access")
    if signing_url_rewrite(config):
        github.checks.append(Check("PASS", "GitHub HTTPS rewrite", "https://github.com/ -> git@github.com:"))
    else:
        github.checks.append(
            Check(
                "WARN",
                "GitHub HTTPS rewrite",
                "not configured",
                'Recommended: git config --global url."git@github.com:".insteadOf "https://github.com/"',
            )
        )

    gh = which_gh()
    if not gh:
        github.checks.append(Check("WARN", "GitHub CLI authentication", "gh not installed", "Install gh and run gh auth login."))
    else:
        ok, account, text = gh_auth_status()
        if ok:
            github.checks.append(Check("PASS", "GitHub CLI authentication", account or "authenticated for github.com"))
        else:
            github.checks.append(
                Check(
                    "WARN",
                    "GitHub CLI authentication",
                    one_line(text, 120) or "not authenticated",
                    "Run: gh auth login --hostname github.com --git-protocol ssh",
                )
            )

        if deep:
            key_path, key_text, key_error = resolve_public_key(signing_key_value) if signing_key_value else (None, None, "no key")
            if not key_text:
                github.checks.append(
                    Check("SKIP", "Signing key registered on GitHub", key_error or "no signing key configured")
                )
            elif not ok:
                github.checks.append(Check("SKIP", "Signing key registered on GitHub", "gh is not authenticated"))
            else:
                keys, error = fetch_github_signing_keys()
                if error:
                    github.checks.append(
                        Check(
                            "WARN",
                            "Signing key registered on GitHub",
                            error,
                            "Try: gh auth refresh -h github.com -s admin:ssh_signing_key",
                        )
                    )
                else:
                    wanted = key_data(key_text)
                    found = None
                    for item in keys or []:
                        if key_data(str(item.get("key", ""))) == wanted:
                            found = item
                            break
                    if found:
                        github.checks.append(
                            Check("PASS", "Signing key registered on GitHub", str(found.get("title") or "registered"))
                        )
                    else:
                        target = str(key_path) if key_path else "~/.ssh/id_ed25519.pub"
                        github.checks.append(
                            Check(
                                "WARN",
                                "Signing key registered on GitHub",
                                "configured signing key is not registered",
                                f"Run: gh ssh-key add {target} --type signing (may require: gh auth refresh -h github.com -s admin:ssh_signing_key)",
                            )
                        )

    return report


