class App:
    def __init__(self) -> None:
        # The current directory is the source of truth. This makes the tool
        # automatic when it is copied into a project root and run from there.
        # It also avoids silently selecting the tool's own repository when the
        # script is installed elsewhere and started from an unrelated folder.
        self.project = detect_git_root(Path.cwd())

    # -- menu ---------------------------------------------------------------

    def run(self) -> int:
        print()
        print(col(f"{APP} {VERSION}", "bold") + col(" - safe Git/GitHub project assistant", "dim"))
        if self.project:
            print("Active project: " + col(str(self.project), "cyan"))
        else:
            print(col("No Git repository detected in the current directory.", "yellow"))
        print(col("New to Git? Option 12 explains the concepts, commands, and why they are used.", "dim"))
        print_quick_check(self.project)
        while True:
            try:
                self.refresh_project()
                self.print_menu()
                choice = ask("Choose an option", default="0", allow_empty=True)
                if choice in ("0", "q", "quit", "exit"):
                    print("Bye.")
                    return 0
                actions = {
                    "1": self.verify_current,
                    "2": self.scan_action,
                    "3": self.select_project,
                    "4": self.scenario_a,
                    "5": self.scenario_b,
                    "6": self.scenario_c,
                    "7": self.scenario_d,
                    "8": self.commit_and_push_action,
                    "9": self.rename_action,
                    "10": self.settings_action,
                    "11": self.files_action,
                    "12": self.help_action,
                }
                action = actions.get(choice)
                if action is None:
                    warning("Unknown option.")
                else:
                    action()
            except KeyboardInterrupt:
                print("\nCancelled.")
                continue
            except EOFError:
                print("\nInput closed; exiting.")
                return 0

    def refresh_project(self) -> None:
        if self.project is None:
            return
        root = detect_git_root(self.project)
        if root is None:
            warning(f"Active project is no longer a Git repository: {self.project}")
            self.project = None
        else:
            self.project = root

    def project_summary(self) -> str:
        if not self.project:
            return "none"
        branch = git_out(self.project, "symbolic-ref", "--short", "-q", "HEAD") or "detached"
        entries = status_entries(self.project)
        state = "clean" if not entries else f"{len(entries)} change(s)"
        return f"{self.project} ({branch}, {state})"

    def print_menu(self) -> None:
        print()
        print(col("Active project", "bold") + ": " + self.project_summary())
        print(col("-" * 78, "dim"))
        items = [
            ("1", "Verify active project (full check)"),
            ("2", "Scan a folder for Git repositories"),
            ("3", "Select active project"),
            ("4", "Scenario A: create a new GitHub repo and clone it"),
            ("5", "Scenario B: clone an existing GitHub repo"),
            ("6", "Scenario C: publish an existing local project"),
            ("7", "Scenario D: diagnose local/remote history (no force)"),
            ("8", "Commit and push changes"),
            ("9", "Rename local folder and/or GitHub repository"),
            ("10", "Check/fix global Git and GitHub settings"),
            ("11", "Check/add important project files"),
            ("12", "Help: Git concepts, commands, scenarios, safety"),
            ("0", "Exit"),
        ]
        for number, label in items:
            print(f"  {number:>2}) {label}")

    def require_project(self) -> Optional[Path]:
        self.refresh_project()
        if self.project is None:
            warning("No active project. Use option 3 to select one, or options 4-6 to create/clone/publish.")
            return None
        return self.project

    def help_action(self) -> None:
        heading("Git in plain English")
        print(
            textwrap.dedent(
                """\
                Repository      The .git folder that stores history and settings.
                Working tree    The files you see and edit.
                Staging area    A waiting room: git add puts changes here.
                Commit          A saved snapshot of the staging area.
                Branch          A movable name pointing at a line of commits.
                Remote          A copy of the repository elsewhere, usually origin on GitHub.
                Upstream        The remote branch your current branch tracks.
                Fetch           Downloads remote information without changing your files.
                Pull            Fetches and moves your branch forward; --ff-only forbids a merge commit.
                Push            Uploads your local commits to the remote branch.

                working tree --git add--> staging area --git commit--> local repo --git push--> remote

                A commit records the staging area, not automatically every file in the
                folder. That is why the app shows what is staged, scans it for secrets,
                and asks before committing.

                If local and remote both have commits the other lacks, the histories are
                diverged. That is not a reason to force-push. It is a reason to compare
                the graph, keep a backup, and merge or rebase deliberately.
                """
            )
        )
        heading("What the commands do and why")
        print(
            textwrap.dedent(
                """\
                git config --global       Read/write your personal Git settings.
                                          Why: identity, safer defaults, and SSH signing
