def ensure_gitattributes(root: Path, ask_first: bool = True) -> bool:
    path = root / ".gitattributes"
    if path.exists():
        info(f".gitattributes already exists: {path}")
        return False
    if ask_first and not confirm("Create a .gitattributes template?", True):
        return False
    return write_new_file(path, GITATTRIBUTES_TEMPLATE, ".gitattributes")


def precommit_hook_path(root: Path) -> Path:
    return git_path(root, "hooks/pre-commit")


PRE_COMMIT_HOOK = """\
#!/bin/sh
# Managed by git-create. Configure with:
#   git config --local gitcreate.precommit 'command ...'
command=$(git config --local --get gitcreate.precommit) || exit 0
[ -z "$command" ] && exit 0
exec sh -c "$command"
"""


def is_managed_precommit_hook(root: Path) -> bool:
    hook = precommit_hook_path(root)
    if not hook.is_file():
        return False
    try:
        return "Managed by git-create" in hook.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def install_precommit_hook(root: Path) -> bool:
    hook = precommit_hook_path(root)
    if not git_out(root, "config", "--local", "--get", "gitcreate.precommit"):
        failure("Set a local gitcreate.precommit command first.")
        return False
    if hook.exists():
        try:
            existing = hook.read_text(encoding="utf-8", errors="replace")
        except OSError as exc:
            failure(f"Could not read existing hook: {exc}")
            return False
        if "Managed by git-create" not in existing:
            failure(f"Refusing to overwrite an existing unrelated hook: {hook}")
            return False
        info("The managed pre-commit hook already exists.")
        return False
    try:
        hook.parent.mkdir(parents=True, exist_ok=True)
        hook.write_text(PRE_COMMIT_HOOK, encoding="utf-8")
        os.chmod(hook, 0o755)
    except OSError as exc:
        failure(f"Could not install hook: {exc}")
        return False
    success(f"Installed pre-commit hook: {hook}")
    return True


def remove_precommit_hook(root: Path) -> bool:
    hook = precommit_hook_path(root)
    if not hook.exists():
        info("No pre-commit hook is installed.")
        return False
    try:
        existing = hook.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        failure(f"Could not read hook: {exc}")
        return False
    if "Managed by git-create" not in existing:
        failure(f"Refusing to remove a hook not managed by git-create: {hook}")
        return False
    try:
        hook.unlink()
    except OSError as exc:
        failure(f"Could not remove hook: {exc}")
        return False
    success("Removed the git-create pre-commit hook.")
    return True


def ensure_license(root: Path, ask_first: bool = True) -> bool:
    existing = find_license(root)
    if existing:
        info(f"LICENSE already exists: {existing}")
        return False
    choice = ask("License [m]it/[i]sc/[b]sd-3 or [c]ancel", default="m").lower()
    keys = {"m": "mit", "mit": "mit", "i": "isc", "isc": "isc", "b": "bsd-3", "bsd": "bsd-3", "bsd-3": "bsd-3"}
    key = keys.get(choice)
    if not key:
        info("License creation cancelled.")
        return False
    holder = ask("Copyright holder", default=cfg_get(read_global_config(), "user.name") or root.name)
    year = ask("Copyright year", default=time.strftime("%Y"))
    content = LICENSE_TEMPLATES[key].format(year=year, holder=holder)
    if ask_first and not confirm(f"Create a {key.upper()} LICENSE for {holder} ({year})?", True):
        return False
    return write_new_file(root / "LICENSE", content, "LICENSE")


def ensure_env_example(root: Path, ask_first: bool = True, confirm_changes: bool = True) -> bool:
    target = root / ".env.example"
    source = root / ".env"
    if target.exists():
        if is_ignored(root, ".env.example"):
            warning(".env.example exists but is ignored; repairing .gitignore.")
            ensure_gitignore(root, ask_first=False, confirm_changes=confirm_changes)
        info(f".env.example already exists: {target}")
        return False
    if not source.exists():
        info("No .env file found, so there is nothing to derive.")
        return False
    if not is_ignored(root, ".env"):
        warning(".env is not ignored; repairing .gitignore before creating .env.example.")
        ensure_gitignore(root, ask_first=False, confirm_changes=confirm_changes)
        if not is_ignored(root, ".env"):
            failure(".env is still not ignored. Add .env to .gitignore manually, then try again.")
            return False
    keys: List[str] = []
    try:
        for line in source.read_text(encoding="utf-8", errors="replace").splitlines():
            match = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=", line)
            if match and match.group(1) not in keys:
                keys.append(match.group(1))
    except OSError as exc:
        failure(f"could not read .env: {exc}")
        return False
    if not keys:
        warning("No variable names found in .env.")
        if confirm_changes and not confirm("Create a header-only .env.example?", True):
            return False
    if is_ignored(root, ".env.example"):
        warning("The current .gitignore would hide .env.example; adding an explicit exception.")
        ensure_gitignore(root, ask_first=False, confirm_changes=confirm_changes)
        if is_ignored(root, ".env.example"):
            failure(".env.example is still ignored. Add '!.env.example' after the .env.* rule, then retry.")
            return False
    if ask_first and confirm_changes and not confirm(f"Create .env.example with {len(keys)} blank key(s)?", True):
        return False
    lines = [
        "# Generated by git-create from .env.",
        "# Values are intentionally blank; fill in local values in .env.",
        "",
    ]
    lines.extend(f"{key}=" for key in keys)
    return write_new_file(target, "\n".join(lines) + "\n", ".env.example")


def print_file_checklist(root: Path) -> None:
    readme = find_readme(root)
    checks = [
        ("README", "yes" if readme else "missing"),
        (".gitignore", "yes" if (root / ".gitignore").exists() else "MISSING"),
        (".dockerignore", "yes" if (root / ".dockerignore").exists() else "missing"),
        ("LICENSE", "yes" if find_license(root) else "missing"),
        (".env.example", "yes" if (root / ".env.example").exists() else "not present"),
        (".editorconfig", "yes" if (root / ".editorconfig").exists() else "missing"),
        (".gitattributes", "yes" if (root / ".gitattributes").exists() else "missing"),
        ("Dockerfile", "yes" if (root / "Dockerfile").exists() else "missing"),
        ("GHCR workflow", "yes" if (root / ".github" / "workflows" / "ghcr.yml").exists() else "missing"),
    ]
    for label, value in checks:
        print(f"  {label:16} {value}")


def safe_file_fix_plan(root: Path) -> List[str]:
    """List additive file fixes that can be applied without destroying data."""
    actions: List[str] = []
    if not (root / ".gitignore").exists():
        actions.append(".gitignore")
    elif missing_ignore_rules(root):
        actions.append(".gitignore rules")
    if not (root / ".dockerignore").exists():
        actions.append(".dockerignore")
    elif dockerignore_missing(root):
        actions.append(".dockerignore rules")
    if find_readme(root) is None:
        actions.append("README.md")
    if not (root / ".editorconfig").exists():
        actions.append(".editorconfig")
    if not (root / ".gitattributes").exists():
        actions.append(".gitattributes")
    if (root / ".env").exists() and not (root / ".env.example").exists():
        actions.append(".env.example")
    return actions


def apply_safe_file_fixes(root: Path) -> List[str]:
    """Apply only additive project-file fixes and return the changed labels."""
    changed: List[str] = []
    if not (root / ".gitignore").exists():
        if ensure_gitignore(root, ask_first=False, confirm_changes=False):
            changed.append(".gitignore")
    elif missing_ignore_rules(root):
        if ensure_gitignore(root, ask_first=False, confirm_changes=False):
            changed.append(".gitignore")
    if not (root / ".dockerignore").exists():
        if ensure_dockerignore(root, ask_first=False):
            changed.append(".dockerignore")
    elif dockerignore_missing(root):
        if ensure_dockerignore(root, ask_first=False, confirm_changes=False):
            changed.append(".dockerignore")
    if find_readme(root) is None:
        if ensure_readme(root, ask_first=False, description="A short description of the project."):
            changed.append("README.md")
    if not (root / ".editorconfig").exists():
        if ensure_editorconfig(root, ask_first=False):
            changed.append(".editorconfig")
    if not (root / ".gitattributes").exists():
        if ensure_gitattributes(root, ask_first=False):
            changed.append(".gitattributes")
    if (root / ".env").exists() and not (root / ".env.example").exists():
        if ensure_env_example(root, ask_first=False, confirm_changes=False):
            changed.append(".env.example")
    return changed


