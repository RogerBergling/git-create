def ensure_env_example(root: Path, ask_first: bool = True) -> bool:
    target = root / ".env.example"
    source = root / ".env"
    if target.exists():
        if is_ignored(root, ".env.example"):
            warning(".env.example exists but is ignored; repairing .gitignore.")
            ensure_gitignore(root)
        info(f".env.example already exists: {target}")
        return False
    if not source.exists():
        info("No .env file found, so there is nothing to derive.")
        return False
    if not is_ignored(root, ".env"):
        warning(".env is not ignored; repairing .gitignore before creating .env.example.")
        ensure_gitignore(root)
        if not is_ignored(root, ".env"):
            failure(".env is still not ignored. Add .env to .gitignore manually, then try again.")
            return False
    keys: List[str] = []
    try:
        for line in source.read_text(encoding="utf-8", errors="replace").splitlines():
            match = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=", line)
            if match and match.group(1) not in keys:
                keys.append(match.group(1))
    except OSError as exc:
        failure(f"could not read .env: {exc}")
        return False
    if not keys:
        warning("No variable names found in .env.")
        if not confirm("Create a header-only .env.example?", True):
            return False
    if is_ignored(root, ".env.example"):
        warning("The current .gitignore would hide .env.example; adding an explicit exception.")
        ensure_gitignore(root)
        if is_ignored(root, ".env.example"):
            failure(".env.example is still ignored. Add '!.env.example' after the .env.* rule, then retry.")
            return False
    if ask_first and not confirm(f"Create .env.example with {len(keys)} blank key(s)?", True):
        return False
    lines = [
        "# Generated by git-create from .env.",
        "# Values are intentionally blank; fill in local values in .env.",
        "",
    ]
    lines.extend(f"{key}=" for key in keys)
    return write_new_file(target, "\n".join(lines) + "\n", ".env.example")


def print_file_checklist(root: Path) -> None:
    readme = find_readme(root)
    checks = [
        ("README", "yes" if readme else "missing"),
        (".gitignore", "yes" if (root / ".gitignore").exists() else "MISSING"),
        (".dockerignore", "yes" if (root / ".dockerignore").exists() else "missing"),
        ("LICENSE", "yes" if find_license(root) else "missing"),
        (".env.example", "yes" if (root / ".env.example").exists() else "not present"),
        (".editorconfig", "yes" if (root / ".editorconfig").exists() else "missing"),
    ]
    for label, value in checks:
        print(f"  {label:16} {value}")


