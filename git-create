def build_project_report(
    path: Path,
    deep: bool = False,
    scan_content: bool = True,
    global_config: Optional[Dict[str, List[str]]] = None,
) -> Report:
    global_config = global_config if global_config is not None else read_global_config()
    root = detect_git_root(path)
    report = Report(f"Project: {root.name if root else path}")
    report.meta.update({"path": str(root or path), "deep": deep, "scan_content": scan_content})
    if root is None:
        report.add(
            "Repository",
            "FAIL",
            "Git repository",
            f"not a repository: {path}",
            "Choose the repository root, or use scenario C to initialize and publish it.",
        )
        return report

    report.meta["root"] = str(root)
    entries = status_entries(root)
    counts = status_counts(entries)
    tracked = tracked_files(root)
    remotes = remote_urls(root)
    origin_url = remotes.get("origin", "")
    github_remote = parse_github_url(origin_url) if origin_url else None
    branch = git_out(root, "symbolic-ref", "--short", "-q", "HEAD")
    detached = not branch
    if detached:
        branch = git_out(root, "rev-parse", "--short", "HEAD")

    repository = report.section("Repository")
    repository.checks.append(Check("PASS", "Path", str(root)))
    if detached:
        repository.checks.append(
            Check(
                "WARN",
                "Branch",
                f"detached HEAD at {branch or '(unknown)'}",
                "Check out a branch before committing or pushing.",
            )
        )
    else:
        repository.checks.append(Check("PASS", "Branch", branch))

    head_result = git(
        root,
        "log",
        "-1",
        "--date=short",
        "--format=%h%x00%an%x00%ae%x00%ad%x00%s",
        timeout=10,
    )
    has_commit = head_result.returncode == 0 and head_result.out.strip()
    if has_commit:
        parts = head_result.out.rstrip("\n").split("\0")
        if len(parts) >= 5:
            repository.checks.append(
                Check(
                    "INFO",
                    "HEAD",
                    f"{parts[0]} {one_line(parts[4], 80)} ({parts[1]} <{parts[2]}>, {parts[3]})",
                )
            )
    else:
        repository.checks.append(Check("INFO", "HEAD", "no commits yet"))

    if counts["conflicts"]:
        repository.checks.append(
            Check(
                "FAIL",
                "Merge conflicts",
                f"{counts['conflicts']} conflicted path(s)",
                "Resolve conflicts, then commit. Do not force or discard work.",
            )
        )
    if entries:
        repository.checks.append(
            Check(
                "WARN",
                "Working tree",
                f"{len(entries)} changed path(s): {counts['staged']} staged, "
                f"{counts['unstaged']} unstaged, {counts['untracked']} untracked",
                "Review changes and use option 8 (commit and push) when ready.",
            )
        )
    else:
        repository.checks.append(Check("PASS", "Working tree", "clean"))

    operations = in_progress_operations(root)
    if operations:
        repository.checks.append(
            Check(
                "FAIL",
                "Git operation in progress",
                ", ".join(operations),
                "Finish or safely abort the operation before creating, renaming, or pushing.",
            )
        )
    else:
        repository.checks.append(Check("PASS", "Git operation", "none in progress"))

    if is_linked_worktree(root):
        repository.checks.append(
            Check(
                "INFO",
                "Linked worktree",
                "this checkout shares a .git directory with another worktree",
                "Rename it with 'git worktree move' (option 9 does this automatically), not with mv.",
            )
        )

    if deep:
        fsck = git(root, "fsck", "--no-progress", "--connectivity-only", timeout=90)
        if fsck.returncode == 0:
            repository.checks.append(Check("PASS", "Object database", "git fsck connectivity check passed"))
        else:
            repository.checks.append(
                Check(
                    "WARN",
                    "Object database",
                    one_line(fsck.combined, 200) or "git fsck reported a problem",
                    "Inspect the output manually. Do not delete objects until you have a backup.",
                )
            )

    if not remotes:
        repository.checks.append(
            Check(
                "WARN",
                "Remotes",
                "none (local-only repository)",
                "Publish it with scenario C, or add a remote manually.",
            )
        )
    elif "origin" not in remotes:
        repository.checks.append(
            Check(
                "WARN",
                "Remotes",
                f"no origin; found: {', '.join(remotes)}",
                "The scenarios in this tool expect a remote named origin.",
            )
        )
    else:
        repository.checks.append(Check("PASS", "Remotes", f"origin = {origin_url}"))

    if origin_url:
        if origin_url.startswith(("http://", "git://")):
            repository.checks.append(
                Check(
                    "WARN",
                    "Remote URL",
                    origin_url,
                    "Use SSH (git@github.com:...) or HTTPS with the recommended insteadOf rewrite.",
                )
            )
        elif origin_url.startswith("https://github.com/"):
            if signing_url_rewrite(global_config):
                repository.checks.append(
                    Check("PASS", "Remote URL", "HTTPS GitHub URL will be rewritten to SSH by insteadOf")
                )
            else:
                repository.checks.append(
                    Check("INFO", "Remote URL", "HTTPS GitHub URL (gh/git credential helper handles authentication)")
                )
        elif origin_url.startswith(("git@github.com:", "ssh://git@github.com/")):
            repository.checks.append(Check("PASS", "Remote URL", "SSH"))
        else:
            repository.checks.append(Check("INFO", "Remote URL", one_line(origin_url, 120)))

    upstream = git_out(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if not upstream:
        repository.checks.append(
            Check(
                "WARN",
                "Upstream branch",
                "not set",
                f"Set it with: git push -u origin {branch}" if not detached else "Check out a branch first.",
            )
        )
    else:
        repository.checks.append(Check("PASS", "Upstream branch", upstream))
        count_result = git(root, "rev-list", "--left-right", "--count", f"HEAD...{upstream}", timeout=15)
        if count_result.returncode == 0:
            values = count_result.out.strip().split()
            if len(values) == 2:
                ahead, behind = int(values[0]), int(values[1])
                if ahead and behind:
                    repository.checks.append(
                        Check(
                            "WARN",
                            "Ahead/behind",
                            f"{ahead} ahead, {behind} behind (based on last fetch)",
                            "Histories have diverged. Do not force. Use option 7 (scenario D) to compare them safely.",
                        )
                    )
                elif behind:
                    repository.checks.append(
                        Check(
                            "WARN",
                            "Ahead/behind",
                            f"0 ahead, {behind} behind (based on last fetch)",
                            "A fast-forward pull is safe from a clean worktree: git pull --ff-only",
                        )
                    )
                elif ahead:
                    repository.checks.append(
                        Check("INFO", "Ahead/behind", f"{ahead} ahead, 0 behind (based on last fetch)", "Push when ready.")
                    )
                else:
                    repository.checks.append(Check("PASS", "Ahead/behind", "in sync with upstream (based on last fetch)"))

    remote_default: Optional[str] = None
    if deep and origin_url:
        reachable, remote_default, error = check_remote_access(root)
        if reachable:
            repository.checks.append(Check("PASS", "Remote reachable", "origin responded"))
        else:
            repository.checks.append(
                Check(
                    "WARN",
                    "Remote reachable",
                    error or "could not contact origin",
                    "Check network, SSH agent/key, and gh authentication. Offline verification can use --offline.",
                )
            )
    if origin_url:
        local_default = git_out(root, "symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD")
        if local_default:
            remote_default = remote_default or local_default.split("/", 1)[-1]

    if remote_default:
        if not detached and branch == remote_default:
            repository.checks.append(Check("PASS", "Default branch", remote_default))
        else:
            repository.checks.append(
                Check(
                    "INFO",
                    "Default branch",
                    f"remote default is {remote_default}; current branch is {branch}",
                )
            )

    if deep and github_remote:
        gh_info, gh_error = gh_repo_info(root)
        if gh_info:
            visibility = str(gh_info.get("visibility") or ("private" if gh_info.get("isPrivate") else "unknown"))
            repository.checks.append(
                Check("PASS", "GitHub repository", f"{gh_info.get('nameWithOwner')} ({visibility})")
            )
            github_name = str(gh_info.get("nameWithOwner", "")).split("/")[-1]
            if github_name and github_name != root.name:
                repository.checks.append(
                    Check(
                        "INFO",
                        "Folder/repository name",
                        f"local folder '{root.name}' differs from GitHub repository '{github_name}'",
                        "Use option 9 to rename the local folder and/or the GitHub repository.",
                    )
                )
            default_ref = gh_info.get("defaultBranchRef") or {}
            if isinstance(default_ref, dict) and default_ref.get("name"):
                gh_default = str(default_ref["name"])
                if not detached and branch != gh_default:
                    repository.checks.append(
                        Check("INFO", "GitHub default branch", f"{gh_default}; current branch is {branch}")
                    )
        else:
            repository.checks.append(
                Check(
                    "WARN",
                    "GitHub repository",
                    gh_error or "could not read repository metadata",
                    "Check: gh auth status && gh repo view",
                )
            )

    if has_commit:
        signature_result = git(root, "log", "-1", "--format=%G?%x00%GS%x00%h%x00%s", timeout=10)
        if signature_result.returncode == 0:
            sig_parts = signature_result.out.rstrip("\n").split("\0")
            status_code = sig_parts[0].strip() if sig_parts else ""
            signer = sig_parts[1] if len(sig_parts) > 1 else ""
            short_hash = sig_parts[2] if len(sig_parts) > 2 else ""
            subject = one_line(sig_parts[3], 70) if len(sig_parts) > 3 else ""
            if status_code == "G":
                repository.checks.append(
                    Check("PASS", "HEAD signature", f"good signature by {signer or 'unknown signer'} ({short_hash} {subject})")
                )
            elif status_code == "U":
                repository.checks.append(
                    Check(
                        "WARN",
                        "HEAD signature",
                        "good signature, but signer is not trusted locally",
                        "Configure gpg.ssh.allowedSignersFile and add your public key.",
                    )
                )
            elif status_code == "B":
                repository.checks.append(
                    Check("FAIL", "HEAD signature", "BAD signature", "Investigate before trusting or pushing this commit.")
                )
            elif status_code in ("X", "Y", "R"):
                repository.checks.append(
                    Check("FAIL", "HEAD signature", f"signature problem ({status_code})", "The signing key may be expired or revoked.")
                )
            elif status_code == "E":
                repository.checks.append(
                    Check(
                        "WARN",
                        "HEAD signature",
                        "signature could not be verified",
                        "Check gpg.format, user.signingkey, and gpg.ssh.allowedSignersFile.",
                    )
                )
            else:
                raw_commit = git(root, "cat-file", "commit", "HEAD", timeout=10)
                signed_but_unknown = raw_commit.returncode == 0 and bool(
                    re.search(r"(?m)^gpgsig(?:-sha256)? ", raw_commit.out)
                )
                if signed_but_unknown:
                    repository.checks.append(
                        Check(
                            "WARN",
                            "HEAD signature",
                            "HEAD is signed, but Git cannot verify the signer locally",
                            "Configure gpg.ssh.allowedSignersFile with the signing key so verification can succeed.",
                        )
                    )
                else:
                    repository.checks.append(
                        Check(
                            "INFO",
                            "HEAD signature",
                            "HEAD is not signed",
                            "New commits are signed when commit.gpgsign=true and the SSH key is configured.",
                        )
                    )

    settings = report.section("Project settings")
    effective_name = git_out(root, "config", "--get", "user.name")
    effective_email = git_out(root, "config", "--get", "user.email")
    if effective_name and effective_email and EMAIL_RE.match(effective_email):
        settings.checks.append(Check("PASS", "Effective identity", f"{effective_name} <{effective_email}>"))
    else:
        settings.checks.append(
            Check(
                "FAIL",
                "Effective identity",
                f"name={effective_name or '(missing)'}, email={effective_email or '(missing)'}",
                "Set a global or local Git identity before committing.",
            )
        )

    local_config = read_local_config(root)
    overrides = [
        key
        for key in ("user.name", "user.email", "user.signingkey", "commit.gpgsign", "gpg.format", "core.sshcommand")
        if key in local_config
    ]
    if overrides:
        settings.checks.append(
            Check(
                "INFO",
                "Local overrides",
                ", ".join(overrides),
                "Local .git/config values override global settings in this repository.",
            )
        )
        local_email = cfg_get(local_config, "user.email")
        global_email = cfg_get(global_config, "user.email")
        if local_email and global_email and local_email != global_email:
            settings.checks.append(
                Check(
                    "WARN",
                    "Local email override",
                    f"local={local_email}, global={global_email}",
                    "Make sure this address is the one you intend to use for this repository.",
                )
            )

    effective_signing = git_out(root, "config", "--get", "commit.gpgsign").lower() == "true"
    effective_format = git_out(root, "config", "--get", "gpg.format").lower()
    effective_key = git_out(root, "config", "--get", "user.signingkey")
    key_path, key_text, key_error = resolve_public_key(effective_key) if effective_key else (None, None, "not set")
    if effective_signing and effective_format == "ssh" and key_text and not key_error:
        settings.checks.append(
            Check("PASS", "Effective commit signing", f"SSH key: {key_path or 'inline key'}")
        )
    else:
        settings.checks.append(
            Check(
                "WARN",
                "Effective commit signing",
                f"commit.gpgsign={'true' if effective_signing else 'false/not set'}, "
                f"gpg.format={effective_format or 'not set'}, "
                f"signing key={key_error or 'configured'}",
                "Configure SSH commit signing (option 10) so commits are verifiable.",
            )
        )

    allowed_effective = git_out(root, "config", "--get", "gpg.ssh.allowedSignersFile")
    if allowed_effective:
        allowed_path = find_existing_path(allowed_effective)
        if allowed_path and allowed_path.is_file():
            settings.checks.append(Check("PASS", "Local signature verification", str(allowed_path)))
        else:
            settings.checks.append(
                Check(
                    "WARN",
                    "Local signature verification",
                    f"allowedSignersFile missing: {allowed_effective}",
                    "Run option 10 to create/configure it.",
                )
            )

    files = report.section("Important files")
    readme = find_readme(root)
    files.checks.append(
        Check("PASS", "README", str(readme.name)) if readme else Check("WARN", "README", "missing", "Add a README.md describing the project.")
    )
    gitignore = root / ".gitignore"
    files.checks.append(
        Check("FAIL", ".gitignore", "missing", "Create it before staging files. Use option 11.")
        if not gitignore.exists()
        else Check("PASS", ".gitignore", "present")
    )
    dockerfile_path = root / "Dockerfile"
    files.checks.append(
        Check("PASS", "Dockerfile", "present")
        if dockerfile_path.exists()
        else Check("INFO", "Dockerfile", "not present", "Optional; option 16 can generate a starter Dockerfile.")
    )
    ghcr_workflow = root / ".github" / "workflows" / "ghcr.yml"
    files.checks.append(
        Check("PASS", "GHCR workflow", "present")
        if ghcr_workflow.exists()
        else Check("INFO", "GHCR workflow", "not present", "Optional; option 16 can generate a GHCR publishing workflow.")
    )
    dockerignore = root / ".dockerignore"
    docker = dockerfile_present(root)
    if dockerignore.exists():
        files.checks.append(Check("PASS", ".dockerignore", "present"))
    elif docker:
        files.checks.append(
            Check("WARN", ".dockerignore", "missing (Dockerfile detected)", "Create it with option 11 to keep secrets and .git out of images.")
        )
    else:
        files.checks.append(
            Check(
                "WARN",
                ".dockerignore",
                "missing (no Dockerfile detected yet)",
                "Create it with option 11 when containerizing; the template keeps .git, secrets, dependencies, and build output out of the context.",
            )
        )

    license_file = find_license(root)
    files.checks.append(
        Check("PASS", "LICENSE", license_file.name)
        if license_file
        else Check("INFO", "LICENSE", "not found", "Choose a license if you plan to publish the project.")
    )
    env_file = root / ".env"
    env_example = root / ".env.example"
    if env_file.exists():
        if env_example.exists():
            files.checks.append(Check("PASS", ".env.example", "present"))
        else:
            files.checks.append(
                Check("WARN", ".env.example", "missing while .env exists", "Generate a blank-key template with option 11.")
            )
    elif env_example.exists():
        files.checks.append(Check("PASS", ".env.example", "present"))
    else:
        files.checks.append(Check("INFO", ".env.example", "not present", "Optional until the project uses environment variables."))
    files.checks.append(
        Check("PASS", ".editorconfig", "present")
        if (root / ".editorconfig").exists()
        else Check("INFO", ".editorconfig", "not present", "Optional; option 11 can add one.")
    )
    files.checks.append(
        Check("PASS", ".gitattributes", "present")
        if (root / ".gitattributes").exists()
        else Check("INFO", ".gitattributes", "not present", "Optional; useful for line endings and Git LFS rules.")
    )
    security_file = root / "SECURITY.md"
    files.checks.append(
        Check("PASS", "SECURITY.md", "present")
        if security_file.exists()
        else Check("INFO", "SECURITY.md", "not present", "Optional; useful for public repositories.")
    )
    workflows_dir = root / ".github" / "workflows"
    workflows = list(workflows_dir.glob("*.yml")) + list(workflows_dir.glob("*.yaml")) if workflows_dir.is_dir() else []
    files.checks.append(
        Check("PASS", "CI workflows", f"{len(workflows)} workflow file(s)")
        if workflows
        else Check("INFO", "CI workflows", "none found", "Optional; add CI for tests and secret scanning.")
    )

    if has_commit and gitignore.exists() and ".gitignore" not in tracked:
        files.checks.append(Check("WARN", ".gitignore tracked", "file exists but is not committed", "Commit it so collaborators get the same rules."))
    if has_commit and readme and readme.name not in tracked:
        files.checks.append(Check("WARN", "README tracked", "file exists but is not committed", "Commit it so the repository has project documentation."))

    ignore_rules = report.section("Ignore rules")
    missing_patterns = gitignore_missing(root)
    if not gitignore.exists():
        ignore_rules.checks.append(
            Check("FAIL", ".gitignore coverage", "no .gitignore file", "Create one with option 11 before committing secrets by accident.")
        )
    elif missing_patterns:
        ignore_rules.checks.append(
            Check(
                "WARN",
                ".gitignore coverage",
                "missing rules for: " + ", ".join(missing_patterns),
                "Use option 11 to append missing secret rules. Review build-directory rules manually.",
            )
        )
    else:
        ignore_rules.checks.append(Check("PASS", ".gitignore coverage", "secret and common build patterns covered"))

    if env_file.exists() and not is_ignored(root, ".env"):
        ignore_rules.checks.append(
            Check("FAIL", ".env ignored", ".env exists but is not ignored", "Add .env to .gitignore before staging anything.")
        )
    elif env_file.exists():
        ignore_rules.checks.append(Check("PASS", ".env ignored", "yes"))
    if env_example.exists() and is_ignored(root, ".env.example"):
        ignore_rules.checks.append(
            Check("FAIL", ".env.example ignored", "the example file is ignored", "Add !.env.example after the .env.* rule.")
        )

    if docker and dockerignore.exists():
        docker_text = read_text(dockerignore)
        candidates = [".git/config", ".env", "node_modules/x", ".venv/x", "secret.pem", "secret.key"]
        missing_docker = [candidate for candidate in candidates if not dockerignore_covers(docker_text, candidate)]
        if missing_docker:
            ignore_rules.checks.append(
                Check(
                    "WARN",
                    ".dockerignore coverage",
                    "missing: " + ", ".join(missing_docker),
                    "Keep .git, environment files, keys, dependencies, and build output out of the Docker context.",
                )
            )
        else:
            ignore_rules.checks.append(Check("PASS", ".dockerignore coverage", "core secrets and build directories covered"))

    safety = report.section("Safety")
    sensitive_tracked = [path for path in tracked if is_sensitive_name(path)]
    if sensitive_tracked:
        safety.checks.append(
            Check(
                "FAIL",
                "Sensitive files tracked",
                ", ".join(sensitive_tracked[:8]) + (" ..." if len(sensitive_tracked) > 8 else ""),
                "Remove them from the index, rotate any exposed credentials, and add ignore rules. If already pushed, history rewriting is required.",
            )
        )
    else:
        safety.checks.append(Check("PASS", "Sensitive files tracked", "none detected"))

    sensitive_untracked = [
        entry.path for entry in entries if entry.code == "??" and is_sensitive_name(entry.path)
    ]
    if sensitive_untracked:
        safety.checks.append(
            Check(
                "WARN",
                "Sensitive files untracked",
                ", ".join(sensitive_untracked[:8]),
                "These are not committed, but make sure they are ignored. Option 11 can repair .gitignore.",
            )
        )
    else:
        safety.checks.append(Check("PASS", "Sensitive files untracked", "none detected"))

    if env_file.exists():
        try:
            env_mode = stat.S_IMODE(env_file.stat().st_mode)
        except OSError:
            env_mode = 0
        if env_mode & 0o077:
            safety.checks.append(
                Check(
                    "WARN",
                    ".env permissions",
                    f"too open ({oct(env_mode)})",
                    f"Run: chmod 600 {env_file}",
                )
            )
        else:
            safety.checks.append(Check("PASS", ".env permissions", oct(env_mode)))

    if scan_content:
        findings, truncated = scan_secret_content(root, tracked)
        if findings:
            high_risk = any(item[3] for item in findings)
            detail = ", ".join(f"{path}:{line} ({kind})" for path, line, kind, _ in findings[:8])
            if len(findings) > 8:
                detail += " ..."
            safety.checks.append(
                Check(
                    "FAIL" if high_risk else "WARN",
                    "Potential secrets in tracked files",
                    detail,
                    "Review these findings. Remove real secrets, rotate them, and use an ignored .env or a secret manager. "
                    "If content was already pushed, rotate first and then consider git filter-repo.",
                )
            )
        else:
            safety.checks.append(Check("PASS", "Secret content scan (tracked)", "no common secret patterns found"))
        if truncated:
            safety.checks.append(Check("INFO", "Secret content scan (tracked)", "scan limit reached; review large/binary files manually"))

        untracked = untracked_files(root)
        untracked_findings, untracked_truncated = scan_secret_content(root, untracked)
        if untracked_findings:
            detail = ", ".join(f"{path}:{line} ({kind})" for path, line, kind, _ in untracked_findings[:8])
            if len(untracked_findings) > 8:
                detail += " ..."
            safety.checks.append(
                Check(
                    "WARN",
                    "Potential secrets in untracked files",
                    detail,
                    "Untracked files are not committed yet, but they could be staged later. "
                    "Move real secrets into an ignored .env or a secret manager, and repair .gitignore.",
                )
            )
        else:
            safety.checks.append(
                Check("PASS", "Secret content scan (untracked)", "no common secret patterns found")
            )
        if untracked_truncated:
            safety.checks.append(
                Check("INFO", "Secret content scan (untracked)", "scan limit reached; review large/binary files manually")
            )

    large_files = large_tracked_files(root, tracked)
    large = [(name, size) for name, size in large_files if size >= 50 * 1024 * 1024]
    if large:
        safety.checks.append(
            Check(
                "INFO",
                "Large tracked files",
                ", ".join(f"{name} ({format_size(size)})" for name, size in large[:5]),
                "The app imposes no file or Git-push size limit. The remote may still reject "
                "large files; GitHub commonly warns above 50 MiB and rejects files near 100 MiB.",
            )
        )
    else:
        safety.checks.append(Check("PASS", "Large tracked files", "none above 50 MiB"))

    lock_path = git_path(root, "index.lock")
    if lock_path.exists():
        safety.checks.append(
            Check(
                "WARN",
                "index.lock",
                str(lock_path),
                "Another Git process may be running. Do not delete the lock until you are sure no Git process is active.",
            )
        )
    else:
        safety.checks.append(Check("PASS", "index.lock", "none"))

    return report


def combined_report(
    path: Path,
    deep: bool,
    scan_content: bool,
    config: Optional[Dict[str, List[str]]] = None,
) -> Report:
    config = config if config is not None else read_global_config()
    report = Report(f"Verification: {path.name}")
    report.meta.update({"path": str(path), "deep": deep, "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    report.extend(build_global_report(config, deep=deep))
    report.extend(build_project_report(path, deep=deep, scan_content=scan_content, global_config=config))
    return report


def print_quick_check(project: Optional[Path]) -> None:
    config = read_global_config()
    report = Report("Quick check")
    report.extend(build_global_report(config, deep=False))
    if project:
        report.extend(build_project_report(project, deep=False, scan_content=False, global_config=config))
    problems = [check for check in report.checks() if check.level in ("FAIL", "WARN")]
    print()
    print(col("Quick check", "bold") + col(" (local, no network)", "dim"))
    if not problems:
        success("No blocking issues found. Run option 1 for a full verification including network checks.")
        return
    for check in problems[:12]:
        print_check(check, show_hint=check.level == "FAIL")
    if len(problems) > 12:
        print(col(f"  ... and {len(problems) - 12} more. Run option 1 for the full report.", "dim"))
    counts = report.counts()
    print(
        "  "
        + col(f"{counts['FAIL']} failure(s)", "red")
        + ", "
        + col(f"{counts['WARN']} warning(s)", "yellow")
        + col(" - select option 1 for details and fixes.", "dim")
    )


