def write_exclusive_text(path: Path, content: str, mode: int = 0o644) -> bool:
    """Create a new file without following symlinks or overwriting anything."""
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(str(path), flags, mode)
    except OSError:
        return False
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
        os.chmod(path, mode)
    except OSError:
        try:
            path.unlink()
        except OSError:
            pass
        return False
    return True


def write_new_file(path: Path, content: str, label: str) -> bool:
    if path.exists():
        info(f"{label} already exists: {path}")
        return False
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        failure(f"could not create {path.parent}: {exc}")
        return False
    if not write_exclusive_text(path, content if content.endswith("\n") else content + "\n"):
        failure(f"could not create {path}; it may already exist or be a symlink")
        return False
    success(f"created {path}")
    return True


def missing_ignore_rules(root: Path) -> List[str]:
    additions: List[str] = []
    if (root / ".gitignore").exists():
        additions.extend(gitignore_missing(root))
    for line in SECRET_APPEND_LINES:
        if not is_ignored(root, SECRET_TEST_PATH[line]) and line not in additions:
            additions.append(line)
    if is_ignored(root, ".env.example") and "!.env.example" not in additions:
        additions.append("!.env.example")
    return additions


def ensure_gitignore(root: Path, ask_first: bool = True, confirm_changes: bool = True) -> bool:
    path = root / ".gitignore"
    if not path.exists():
        if ask_first and not confirm("Create a new .gitignore with secret/build rules?", True):
            return False
        return write_new_file(path, GITIGNORE_TEMPLATE, ".gitignore")
    if path.is_symlink():
        failure(f"Refusing to modify a symlinked .gitignore: {path}")
        return False

    additions = missing_ignore_rules(root)
    if not additions:
        success(".gitignore already covers the important ignore patterns.")
        return False
    print("Missing ignore rules: " + ", ".join(additions))
    if confirm_changes and not confirm("Append these rules to .gitignore?", True):
        return False
    try:
        existing = path.read_text(encoding="utf-8", errors="replace")
        prefix = "" if not existing or existing.endswith("\n") else "\n"
        block = prefix + "\n# git-create: secret and safety patterns\n" + "\n".join(additions) + "\n"
        with path.open("a", encoding="utf-8") as handle:
            handle.write(block)
    except OSError as exc:
        failure(f"could not update .gitignore: {exc}")
        return False
    success(f"updated {path}")
    return True


