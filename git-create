    def resolve_conflicts_action(self, path: Path) -> None:
        operation = git_operation_kind(path)
        if not operation:
            info("No merge or rebase is in progress.")
            return
        result = git(path, "diff", "--name-only", "--diff-filter=U", "-z", timeout=20)
        conflicts = [item for item in result.out.split("\0") if item] if result.returncode == 0 else []
        if not conflicts:
            success("No unmerged paths remain. Use option 3 to continue the operation.")
            return
        explain(
            "Lists unmerged files and helps resolve them one at a time.",
            "Conflict resolution requires a human decision: keep your side, take the other side, "
            "or edit the file manually.",
            "Choosing ours/theirs discards the other side for that file. The app confirms each "
            "choice, stages the file, and never continues the merge/rebase automatically.",
        )
        editor = git_out(path, "config", "--get", "core.editor") or os.environ.get("EDITOR") or "nano"
        while True:
            heading(f"Conflicts in {operation}")
            for index, conflict in enumerate(conflicts, 1):
                print(f"  {index:>2}) {conflict}")
            print("  0) Back")
            choice = ask("Number to resolve (or 0)", default="0", allow_empty=True)
            if choice in ("0", ""):
                return
            try:
                index = int(choice)
            except ValueError:
                warning("Enter a number.")
                continue
            if not 1 <= index <= len(conflicts):
                warning("Invalid selection.")
                continue
            conflict = conflicts[index - 1]
            print("  1) Open in editor")
            print("  2) Keep our version (git --ours)")
            print("  3) Keep their version (git --theirs)")
            print("  4) Mark resolved (file already edited)")
            print("  0) Skip")
            action = ask("Resolution", default="0", allow_empty=True)
            if action == "1":
                code = run_interactive(shlex.split(editor) + [str(path / conflict)], cwd=path)
                if code != 0:
                    warning("Editor exited nonzero; file not staged.")
                    continue
                staged = run_cmd(["git", "add", "--", conflict], cwd=path, timeout=30)
                if staged.returncode == 0:
                    success(f"Staged {conflict}.")
                else:
                    failure("Could not stage the file.")
            elif action in ("2", "3"):
                side = "--ours" if action == "2" else "--theirs"
                if not confirm(f"Keep {side[2:]} for {conflict} and stage it?", False):
                    continue
                checkout = run_cmd(["git", "checkout", side, "--", conflict], cwd=path, timeout=30)
                if checkout.returncode != 0:
                    failure("Could not select that side.")
                    continue
                staged = run_cmd(["git", "add", "--", conflict], cwd=path, timeout=30)
                if staged.returncode == 0:
                    success(f"Staged {conflict} using {side[2:]}.")
                else:
                    failure("Could not stage the file.")
            elif action == "4":
                staged = run_cmd(["git", "add", "--", conflict], cwd=path, timeout=30)
                if staged.returncode == 0:
                    success(f"Staged {conflict}.")
                else:
                    failure("Could not stage the file.")
            result = git(path, "diff", "--name-only", "--diff-filter=U", "-z", timeout=20)
            conflicts = [item for item in result.out.split("\0") if item] if result.returncode == 0 else []
            if not conflicts:
                success("All conflicts are staged. Use option 3 to continue.")
                return

    def merge_branch(self, path: Path) -> None:
        if git_operation_kind(path) or in_progress_operations(path):
            failure("A Git operation is already in progress; continue or abort it first.")
            return
        current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        if not current:
            failure("Detached HEAD; check out a branch before merging.")
            return
        if status_entries(path):
            failure("Working tree is not clean. Commit or stash changes before merging.")
            return
        local = local_branch_names(path)
        remote = remote_branch_names(path)
        candidates = [item for item in local + remote if item != current]
        if not candidates:
            warning("No other branches are available to merge.")
            return
        print("  Merge candidates: " + ", ".join(candidates))
        target = ask("Branch to merge into current branch")
        if target == current or target not in candidates:
            failure("Choose a different local or remote branch from the list.")
            return
        backup = create_backup_ref(path, f"before-merge-{current}")
        if not backup:
            failure("Could not create a safety ref; merge cancelled.")
            return
        info(f"Safety ref: {backup}")
        explain(
            f"Runs git merge --no-edit {target}. Git combines the target history into '{current}'.",
            "Merging preserves both histories and is safe when other people already have the "
            "branch. A fast-forward may occur if the current branch has no unique commits.",
            "Conflicts are left in the working tree. The app does not auto-resolve them or "
            "force-push anything.",
        )
        command = ["git", "merge", "--no-edit", target]
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm(f"Merge '{target}' into '{current}'?", True):
            return
        result = run_cmd(command, cwd=path, timeout=180)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Merge did not complete. Check for conflicts.")
            info("Use option 3 to continue after resolving, or option 4 to abort.")
            return
        success("Merge completed.")
        if "origin" in remote_urls(path) and confirm("Push the merged branch now (normal push)?", False):
            self.push_current(path)

    def rebase_branch(self, path: Path) -> None:
        if git_operation_kind(path) or in_progress_operations(path):
            failure("A Git operation is already in progress; continue or abort it first.")
            return
        current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        if not current:
            failure("Detached HEAD; check out a branch before rebasing.")
            return
        if status_entries(path):
            failure("Working tree is not clean. Commit or stash changes before rebasing.")
            return
        local = local_branch_names(path)
        remote = remote_branch_names(path)
        candidates = [item for item in local + remote if item != current]
        if not candidates:
            warning("No other branches are available as a rebase base.")
            return
        print("  Rebase bases: " + ", ".join(candidates))
        target = ask("Rebase current branch onto")
        if target == current or target not in candidates:
            failure("Choose a different local or remote branch from the list.")
            return
        if remote_urls(path):
            if not confirm("Fetch remotes before checking whether history is shared?", True):
                return
            fetch = run_cmd(
                ["git", "fetch", "--all", "--prune"],
                cwd=path,
                timeout=120,
                env_extra=remote_env(),
            )
            if fetch.returncode != 0:
                failure("Fetch failed; rebase was cancelled because shared history cannot be checked safely.")
                return
        shared, count = shared_commit_in_range(path, target)
        if shared == "LIMIT":
            failure(f"More than {count} commits would be considered; rebase cancelled for safety.")
            info("Use a merge, or inspect the range manually before rebasing.")
            return
        if shared:
            failure(f"Commit {shared[:12]} is already contained in a remote branch or tag.")
            info("Rebasing would rewrite shared history and require a force push. Use merge or git revert instead.")
            return
        if count == 0:
            info(f"'{current}' has no commits beyond '{target}'; nothing to rebase.")
            return
        backup = create_backup_ref(path, f"before-rebase-{current}")
        if not backup:
            failure("Could not create a safety ref; rebase cancelled.")
            return
        info(f"Safety ref: {backup}")
        explain(
            f"Runs git rebase {target}. Git replays the {count} local commit(s) on top of "
            f"'{target}'.",
            "Rebase gives a linear local history. It is allowed here only when none of those "
            "commits are contained in a remote branch or tag.",
            "Conflicts stop the rebase. Resolve them and use option 3, or abort with option 4. "
            "The app never force-pushes the rewritten branch.",
        )
        command = ["git", "rebase", target]
        print("Command: " + col(shlex.join(command), "dim"))
        if not confirm(f"Rebase '{current}' onto '{target}'?", True):
            return
        result = run_cmd(command, cwd=path, timeout=300)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Rebase did not complete. Check for conflicts.")
            info("Use option 3 to continue after resolving, or option 4 to abort.")
            return
        success("Rebase completed.")
        if "origin" in remote_urls(path) and confirm("Push the rebased branch now (normal push)?", False):
            self.push_current(path)

    def continue_merge_rebase(self, path: Path) -> None:
        operation = git_operation_kind(path)
