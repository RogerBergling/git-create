def ask(prompt: str, default: Optional[str] = None, allow_empty: bool = False) -> str:
    suffix = f" [{default}]" if default not in (None, "") else ""
    while True:
        try:
            value = input(f"{prompt}{suffix}: ").strip()
        except EOFError:
            raise
        if value:
            return value
        if default is not None:
            return default
        if allow_empty:
            return ""
        print("A value is required.")


def ask_email(prompt: str, default: Optional[str] = None) -> str:
    while True:
        value = ask(prompt, default=default)
        if EMAIL_RE.match(value):
            return value
        warning("That does not look like a valid email address.")


def ask_path(prompt: str, default: Optional[Path] = None) -> Path:
    default_text = str(default) if default else None
    raw = ask(prompt, default=default_text)
    path = Path(os.path.expanduser(os.path.expandvars(raw)))
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.resolve()


def confirm(prompt: str, default: bool = False) -> bool:
    suffix = "[Y/n]" if default else "[y/N]"
    try:
        value = input(f"{prompt} {suffix}: ").strip().lower()
    except EOFError:
        raise
    if not value:
        return default
    return value in ("y", "yes", "j", "ja")


def validate_repo_name(name: str) -> bool:
    return bool(REPO_NAME_RE.match(name)) and name not in (".", "..") and not name.startswith("-")


def ask_repo_name(prompt: str, default: str) -> str:
    while True:
        name = ask(prompt, default=default)
        if validate_repo_name(name):
            return name
        warning("Use 1-100 characters: letters, numbers, dot, dash, underscore. No spaces or slashes.")


def ask_visibility(default: str = "private") -> str:
    while True:
        value = ask("Visibility [private/public]", default=default).lower()
        if value in ("private", "public"):
            return value
        warning("Choose private or public.")


def ask_path_selection(paths: Sequence[str], prompt: str = "Select paths") -> List[str]:
    if not paths:
        return []
    for index, path in enumerate(paths, 1):
        print(f"  {index:>3}) {path}")
    selection = ask(f"{prompt} ('all' or numbers/ranges)", default="all").strip()
    if selection.lower() in ("all", "a", ""):
        return list(paths)
    chosen: List[str] = []
    for part in selection.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            start_text, end_text = part.split("-", 1)
            try:
                start, end = int(start_text), int(end_text)
            except ValueError:
                warning(f"Invalid range: {part}")
                return []
            for index in range(start, end + 1):
                if 1 <= index <= len(paths):
                    chosen.append(paths[index - 1])
        else:
            try:
                index = int(part)
            except ValueError:
                warning(f"Invalid number: {part}")
                return []
            if 1 <= index <= len(paths):
                chosen.append(paths[index - 1])
    return list(dict.fromkeys(chosen))


