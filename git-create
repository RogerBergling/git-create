def write_new_file(path: Path, content: str, label: str) -> bool:
    if path.exists():
        info(f"{label} already exists: {path}")
        return False
    try:
        path.write_text(content if content.endswith("\n") else content + "\n", encoding="utf-8")
    except OSError as exc:
        failure(f"could not write {path}: {exc}")
        return False
    success(f"created {path}")
    return True


def ensure_gitignore(root: Path, ask_first: bool = True) -> bool:
    path = root / ".gitignore"
    if not path.exists():
        if ask_first and not confirm("Create a new .gitignore with secret/build rules?", True):
            return False
        return write_new_file(path, GITIGNORE_TEMPLATE, ".gitignore")

    # Check the example path even when it does not exist yet. A broad .env.*
    # rule would otherwise hide a future .env.example.
    example_ignored = is_ignored(root, ".env.example")
    additions = [
        line
        for line in SECRET_APPEND_LINES
        if not is_ignored(root, SECRET_TEST_PATH[line])
    ]
    if example_ignored or ".env.*" in additions:
        if "!.env.example" not in additions:
            additions.append("!.env.example")
    if not additions:
        success(".gitignore already covers the important secret patterns.")
        return False
    print("Missing secret rules: " + ", ".join(additions))
    if not confirm("Append these rules to .gitignore?", True):
        return False
    try:
        existing = path.read_text(encoding="utf-8", errors="replace")
        prefix = "" if not existing or existing.endswith("\n") else "\n"
        block = prefix + "\n# git-create: secret and safety patterns\n" + "\n".join(additions) + "\n"
        with path.open("a", encoding="utf-8") as handle:
            handle.write(block)
    except OSError as exc:
        failure(f"could not update .gitignore: {exc}")
        return False
    success(f"updated {path}")
    return True


def ensure_dockerignore(root: Path, ask_first: bool = True) -> bool:
