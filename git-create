    # -- verification -------------------------------------------------------

    def verify_path(self, path: Path, deep: Optional[bool] = None) -> Report:
        root = detect_git_root(path)
        if root is None:
            failure(f"Not a Git repository: {path}")
            return Report("Verification")
        if deep is None:
            deep = confirm("Include network checks (remote, GitHub, signing-key registration)?", True)
        info("Verification is read-only: it does not change config, files, commits, or remotes.")
        if deep:
            info("Deep checks also contact the remote and GitHub, run git fsck, and verify signing-key registration.")
        print(col("Running verification...", "dim"))
        sys.stdout.flush()
        report = combined_report(root, deep=deep, scan_content=True)
        print_report(report)
        self.offer_fixes(report)
        return report

    def verify_current(self) -> None:
        project = self.require_project()
        if project:
            self.verify_path(project)

    def offer_fixes(self, report: Report) -> None:
        checks = report.checks()
        if any(check.level in ("FAIL", "WARN") for check in checks if "tracked files" in check.label and "Sensitive" in check.label):
            failure("Sensitive files are already tracked. Fix this before making another commit; if they were pushed, rotate the credentials.")
        global_problem = any(
            check.level in ("FAIL", "WARN")
            for section in report.sections
            if section.title.startswith("Global")
            for check in section.checks
        )
        files_problem = any(
            check.level in ("FAIL", "WARN")
            for section in report.sections
            if section.title in ("Important files", "Ignore rules")
            for check in section.checks
        )
        if global_problem and confirm("Open the global settings wizard now?", False):
            self.settings_action()
        if files_problem and confirm("Open the project-files wizard now?", False):
            self.files_action()

    # -- project selection and scanning ------------------------------------

    def select_project(self) -> None:
        default = self.project
        if default is None:
            default = DEFAULT_PROJECTS if DEFAULT_PROJECTS.exists() else Path.cwd()
        path = ask_path("Project directory", default=default)
        root = detect_git_root(path)
        if root is None:
            failure(f"No Git repository found at or above {path}.")
            info("Use option 2 to scan a folder, or option 6 to publish a local project.")
            return
        self.project = root
        success(f"Active project: {root}")

    def scan_action(self) -> None:
        if self.project:
            default = self.project.parent
        elif DEFAULT_PROJECTS.exists():
            default = DEFAULT_PROJECTS
        else:
            default = Path.cwd()
        path = ask_path("Folder to scan", default=default)
        if not path.exists() or not path.is_dir():
            failure(f"Not a directory: {path}")
            return
        depth_text = ask("Maximum depth", default=str(DEFAULT_DEPTH))
        try:
            depth = max(1, min(int(depth_text), 10))
        except ValueError:
            depth = DEFAULT_DEPTH
        explain(
            "Walks the selected folder down to the requested depth and looks for .git "
            "repositories, then reads their branch, status, upstream, and last commit.",
            "A quick overview helps you find projects, notice dirty worktrees, and choose "
            "the right repository before running dangerous or remote-changing actions.",
            "Scanning is read-only. It does not fetch, commit, modify, or push anything.",
        )
        repos = scan_repositories(path, depth)
        print_scan_results(path, repos, depth)
        if not repos:
            return
        choice = ask(
            "Number to activate, 'a' verify all, 'f' fix safe files, 'p' pull all, "
            "'u' push all, or Enter to return",
            allow_empty=True,
        )
        if not choice:
            return
        action = choice.strip().lower()
        if action in ("a", "all"):
            self.batch_verify_repos(repos)
            return
        if action in ("f", "fix"):
            self.batch_fix_repos(repos)
            return
        if action in ("p", "pull"):
            self.batch_pull_repos(repos)
            return
        if action in ("u", "push"):
            self.batch_push_repos(repos)
            return
        try:
            index = int(choice)
            if not 1 <= index <= len(repos):
                raise IndexError
            selected = repos[index - 1]
        except (ValueError, IndexError):
            warning("Invalid selection.")
            return
        self.project = Path(selected["path"])
        success(f"Active project: {self.project}")
        if confirm("Run verification now?", True):
            self.verify_path(self.project)

    def batch_verify_repos(self, repos: Sequence[Dict[str, object]]) -> None:
        if not repos:
            info("No repositories to verify.")
            return
        if not confirm(f"Run local verification on {len(repos)} repositories?", True):
            return
        config = read_global_config()
        global_report = build_global_report(config, deep=False)
        global_problems = [
            check
            for section in global_report.sections
            for check in section.checks
            if check.level in ("FAIL", "WARN")
        ]
        repo_word = "repository" if len(repos) == 1 else "repositories"
        heading(f"Batch local verification: {len(repos)} {repo_word}")
        if global_problems:
            warning(f"{len(global_problems)} global issue(s); they affect every repository.")
            for check in global_problems[:8]:
                print_check(check, show_hint=False)
            if len(global_problems) > 8:
                print(f"      ... and {len(global_problems) - 8} more global issue(s).")
            print()
        else:
            success("Global checks have no warnings or failures.")
        total_fail = total_warn = 0
        results: List[Tuple[Dict[str, object], int, int, List[Check]]] = []
        for repo in repos:
            repo_path = Path(str(repo["path"]))
            report = build_project_report(
                repo_path,
                deep=False,
                scan_content=True,
                global_config=config,
            )
            checks = report.checks()
            failures = [check for check in checks if check.level == "FAIL"]
            warnings = [check for check in checks if check.level == "WARN"]
            total_fail += len(failures)
            total_warn += len(warnings)
            results.append((repo, len(failures), len(warnings), failures + warnings))
            marker = "FAIL" if failures else ("WARN" if warnings else "PASS")
            print(
                f"  {col(LEVEL_MARKER[marker], *LEVEL_STYLE[marker])} "
                f"{repo['name']}: {len(checks)} checks, "
                f"{len(failures)} failure(s), {len(warnings)} warning(s)"
            )
            for check in (failures + warnings)[:4]:
                print(
                    f"      {LEVEL_MARKER[check.level]} {check.label}"
                    + (f" - {one_line(check.detail, 100)}" if check.detail else "")
                )
        dirty = [repo for repo, _, _, _ in results if repo.get("dirty")]
        print()
        global_failures = sum(1 for check in global_problems if check.level == "FAIL")
        print(
            f"Batch summary: {len(repos)} {repo_word}, "
            f"{col(str(total_fail), 'red')} project failure(s), "
            f"{col(str(total_warn), 'yellow')} project warning(s), "
            f"{len(global_problems)} global issue(s), "
            f"{len(dirty)} dirty working tree(s)."
        )
        if total_fail == 0 and global_failures == 0:
            success("No blocking local issues found across the scanned repositories.")
        else:
            warning("Review failures before making commits or pushing any repository.")

    def batch_fix_repos(self, repos: Sequence[Dict[str, object]]) -> None:
        if not repos:
            info("No repositories to fix.")
            return
        heading("Batch safe file fixes")
        explain(
            "Creates missing project-hygiene files and appends missing ignore rules across "
            "the scanned repositories.",
            "These are the safe, additive fixes that clear the common file and ignore-rule "
            "warnings without touching history, remotes, or tracked secrets.",
            "Existing files are never overwritten. Licenses, remotes, commits, and history "
            "changes are not automated by this batch action.",
        )
        plan: List[Tuple[Dict[str, object], Path, List[str]]] = []
        skipped: List[Tuple[str, str]] = []
        for repo in repos:
            root = Path(str(repo["path"]))
            name = str(repo.get("name") or root.name)
            if in_progress_operations(root):
                skipped.append((name, "Git operation in progress"))
                continue
            fixes = safe_file_fix_plan(root)
            if fixes:
                plan.append((repo, root, fixes))
        if skipped:
            print(col("Skipped:", "bold"))
            for name, reason in skipped:
                print(f"  - {name}: {reason}")
            print()
        if not plan:
            success("No safe automatic file fixes are needed.")
            info("Remaining warnings may require decisions about licenses, remotes, secrets, signing, or history.")
            info("Use 'a' to verify all and see the remaining checks.")
            return
        for repo, root, fixes in plan:
            name = str(repo.get("name") or root.name)
            print(f"  {col(name, 'bold')}: " + ", ".join(fixes))
        print()
        info("Only missing files are created; an existing .gitignore may receive missing rules.")
        info("Licenses, Dockerfiles, remotes, tracked secrets, and history are left alone.")
        if self.dry_run:
            warning(f"DRY RUN: would apply safe file fixes to {len(plan)} repositories.")
            return
        if not confirm(f"Apply these safe fixes to {len(plan)} repositories?", False):
            return
        changed_repos = 0
        for repo, root, _fixes in plan:
            name = str(repo.get("name") or root.name)
            changed = apply_safe_file_fixes(root)
            if changed:
                changed_repos += 1
                success(f"{name}: " + ", ".join(changed))
            else:
                info(f"{name}: no changes were needed.")
        if changed_repos:
            info("Review and commit the new files in each repository; batch fix does not commit.")
            info("Use 'a' to verify all again and see any warnings that still need manual action.")
        else:
            warning("No files were changed.")

    def batch_pull_repos(self, repos: Sequence[Dict[str, object]]) -> None:
        if not repos:
            info("No repositories to pull.")
            return
        heading("Batch pull (fast-forward only)")
        explain(
            "Runs git pull --ff-only --no-rebase for each clean repository with an upstream.",
            "Fast-forward pulls receive remote commits without merging or rewriting local history.",
            "Dirty repositories, detached HEADs, missing upstreams, and in-progress operations "
            "are skipped. No force and no automatic merge/rebase is used.",
        )
        ready: List[Tuple[Dict[str, object], Path, str, str]] = []
        skipped: List[Tuple[str, str]] = []
        for repo in repos:
            root = Path(str(repo["path"]))
            name = str(repo.get("name") or root.name)
            branch = git_out(root, "symbolic-ref", "--short", "-q", "HEAD")
            if not branch:
                skipped.append((name, "detached HEAD"))
                continue
            if in_progress_operations(root):
                skipped.append((name, "Git operation in progress"))
                continue
            if status_entries(root):
                skipped.append((name, "dirty working tree"))
                continue
            upstream = git_out(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
            if not upstream:
                skipped.append((name, "no upstream"))
                continue
            remote_name = upstream.split("/", 1)[0]
            if remote_name not in remote_urls(root):
                skipped.append((name, "upstream remote missing"))
                continue
            ready.append((repo, root, branch, upstream))
        if skipped:
            print(col("Skipped:", "bold"))
            for name, reason in skipped:
                print(f"  - {name}: {reason}")
            print()
        if not ready:
            warning("No repositories are ready for a fast-forward pull.")
            return
        for repo, root, branch, upstream in ready:
            name = str(repo.get("name") or root.name)
            print(f"  {col(name, 'bold')}: {branch} <- {upstream}")
        print()
        if self.dry_run:
            warning(f"DRY RUN: would fast-forward pull {len(ready)} repositories.")
            for _repo, root, _branch, _upstream in ready:
                print(f"  {root}: " + col(shlex.join(["git", "pull", "--ff-only", "--no-rebase"]), "dim"))
            return
        if not confirm(f"Fast-forward pull {len(ready)} repositories?", False):
            return
        succeeded = failed = 0
        for repo, root, branch, upstream in ready:
            name = str(repo.get("name") or root.name)
            print()
            print(col(f"{name}: pulling {branch} <- {upstream}", "bold"))
            result = run_cmd(
                ["git", "pull", "--ff-only", "--no-rebase"],
                cwd=root,
                timeout=120,
                env_extra=remote_env(),
            )
            if result.combined:
                print(result.combined)
            if result.returncode == 0:
                succeeded += 1
                success(f"{name}: fast-forward pull complete.")
            else:
                failed += 1
                failure(f"{name}: pull failed; no force was used.")
                info("If histories diverged, use option 7 (scenario D) for that repository.")
        print()
        print(f"Batch pull summary: {succeeded} succeeded, {failed} failed, {len(skipped)} skipped.")

    def batch_push_repos(self, repos: Sequence[Dict[str, object]]) -> None:
        if not repos:
            info("No repositories to push.")
            return
        heading("Batch push (normal, no force)")
        explain(
            "Fetches each repository, then pushes the current branch normally when it has an "
            "upstream and local commits to send.",
            "Batch push is convenient for many independent projects, but it still contacts each "
            "remote and can publish commits under your account.",
            "No force is used. Repositories with no upstream, a missing upstream remote, "
            "detached HEAD, an in-progress operation, or a diverged history are skipped.",
        )
        ready: List[Tuple[Dict[str, object], Path, str, str, int, bool]] = []
        skipped: List[Tuple[str, str]] = []
        for repo in repos:
            root = Path(str(repo["path"]))
            name = str(repo.get("name") or root.name)
            branch = git_out(root, "symbolic-ref", "--short", "-q", "HEAD")
            if not branch:
                skipped.append((name, "detached HEAD"))
                continue
            if in_progress_operations(root):
                skipped.append((name, "Git operation in progress"))
                continue
            upstream = git_out(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
            if not upstream:
                skipped.append((name, "no upstream"))
                continue
            remote_name, _, remote_branch = upstream.partition("/")
            if not remote_name or not remote_branch:
                skipped.append((name, "malformed upstream"))
                continue
            if remote_name not in remote_urls(root):
                skipped.append((name, "upstream remote missing"))
                continue
            if remote_branch != branch:
                skipped.append((name, f"upstream branch name differs ({upstream})"))
                continue
            if not self.dry_run:
                fetch = run_cmd(
                    ["git", "fetch", "--prune", remote_name],
                    cwd=root,
                    timeout=120,
                    env_extra=remote_env(),
                )
                if fetch.returncode != 0:
                    skipped.append((name, "fetch failed"))
                    continue
            state = quick_repo_info(root)
            if state is None:
                skipped.append((name, "could not read repository state"))
                continue
            ahead = int(state.get("ahead") or 0)
            behind = int(state.get("behind") or 0)
            if behind:
                skipped.append((name, f"diverged ({ahead} ahead, {behind} behind)"))
                continue
            if ahead == 0:
                skipped.append((name, "nothing to push"))
                continue
            ready.append((repo, root, branch, upstream, ahead, bool(state.get("dirty"))))
        if skipped:
            print(col("Skipped:", "bold"))
            for name, reason in skipped:
                print(f"  - {name}: {reason}")
            print()
        if not ready:
            warning("No repositories have commits ready to push.")
            return
        for repo, root, branch, upstream, ahead, dirty in ready:
            name = str(repo.get("name") or root.name)
            suffix = " (dirty working tree; uncommitted changes are not pushed)" if dirty else ""
            print(f"  {col(name, 'bold')}: {branch} -> {upstream}, {ahead} commit(s) ahead{suffix}")
        print()
        if self.dry_run:
            warning(f"DRY RUN: would push {len(ready)} repositories.")
            for _repo, root, branch, upstream, ahead, _dirty in ready:
                remote_name, remote_branch = upstream.split("/", 1)
                command = ["git", "push", remote_name, f"{branch}:{remote_branch}"]
                print(f"  {root}: {ahead} commit(s) ahead; " + col(shlex.join(command), "dim"))
            return
        phrase = "PUSH ALL"
        typed = ask(f'Type "{phrase}" to push {len(ready)} repositories', allow_empty=True)
        if typed != phrase:
            info("Batch push cancelled.")
            return
        succeeded = failed = 0
        for repo, root, branch, upstream, ahead, dirty in ready:
            name = str(repo.get("name") or root.name)
            print()
            dirty_note = "; dirty working tree" if dirty else ""
            print(col(f"{name}: pushing {branch} -> {upstream} ({ahead} ahead{dirty_note})", "bold"))
            remote_name, remote_branch = upstream.split("/", 1)
            command = ["git", "push", remote_name, f"{branch}:{remote_branch}"]
            result = run_cmd(command, cwd=root, timeout=300, env_extra=remote_env())
            if result.combined:
                print(result.combined)
            if result.returncode == 0:
                succeeded += 1
                success(f"{name}: push complete.")
            else:
                failed += 1
                failure(f"{name}: push failed; no force was used.")
                info("Fetch and compare with option 7 (scenario D) if the remote moved.")
        print()
        print(f"Batch push summary: {succeeded} succeeded, {failed} failed, {len(skipped)} skipped.")

    def revert_action(self) -> None:
        path = self.require_project()
        if path is None:
            return
        explain(
            "This menu distinguishes local file changes from Git history. It can discard "
            "working-tree edits, unstage changes, create a revert commit, or undo an "
            "unpublished local commit.",
            "Reverting a pushed commit must create a new commit so other clones stay "
            "compatible. Rewriting shared history would require a force push, which this "
            "app never does.",
            "Destructive local discards require a typed confirmation and save a patch under "
            ".git/git-create-backups first. Remote history is only changed by a normal revert "
            "commit push.",
        )
        while True:
            status = git_out(path, "status", "--short")
            staged = git_out(path, "diff", "--cached", "--stat")
            unstaged = git_out(path, "diff", "--stat")
            heading("Undo / revert helpers")
            if status:
                print(status)
            else:
                success("Working tree is clean.")
            if staged:
                print(col("Staged:", "bold"))
                print(staged)
            if unstaged:
                print(col("Unstaged:", "bold"))
                print(unstaged)
            print()
            print("  1) Show full staged diff")
            print("  2) Unstage all changes (safe; files stay)")
            print("  3) Discard unstaged changes to selected tracked files (backup first)")
            print("  4) Revert a commit with a new commit (safe for shared history)")
            print("  5) Undo the last local commit, keep changes (only if never pushed)")
            print("  6) Amend the last local commit (never if already pushed)")
            print("  7) Manage git-create safety backups")
            print("  0) Back")
            choice = ask("Choose an option", default="0", allow_empty=True)
            if choice in ("0", ""):
                return
            if choice == "1":
                show_staged_diff(path)
            elif choice in ("2", "3") and in_progress_operations(path):
                failure("A Git operation is in progress; finish or abort it before changing the index or files.")
            elif choice == "2":
                staged_paths_list = staged_paths(path, added_only=False)
                if not staged_paths_list:
                    info("There are no staged changes.")
                    continue
                explain(
                    "Removes files from the staging area with git restore --staged (or "
                    "git rm --cached on an unborn branch).",
                    "The working-tree files stay exactly as they are. You can review and "
                    "stage them again.",
                    "This is an index-only operation, not a data-loss operation.",
                )
                if confirm(f"Unstage {len(staged_paths_list)} path(s)?", True):
                    if unstage_paths(path, staged_paths_list):
                        success("All staged paths were unstaged.")
            elif choice == "3":
                result = git(path, "diff", "--name-only", "-z", "--", timeout=20)
                paths = [item for item in result.out.split("\0") if item] if result.returncode == 0 else []
                if not paths:
                    info("There are no unstaged changes in tracked files.")
                    info("Untracked files are not discarded by this action.")
                    continue
                selected = ask_path_selection(paths, "Discard which paths")
                if not selected:
                    continue
                backup = create_worktree_backup(path, "discard-unstaged")
                if backup:
                    info(f"Backup patch: {backup}")
                else:
                    warning("Could not create a backup patch; proceeding would be riskier.")
                explain(
                    "Runs git restore --worktree on the selected tracked paths.",
                    "This permanently removes their unstaged edits from the working tree, "
                    "but leaves staged content and untracked files alone.",
                    "The operation is destructive. A backup patch is written first when "
                    "possible, and a typed confirmation is required.",
                )
                phrase = "DISCARD"
                typed = ask(f'Type "{phrase}" to discard the selected changes', allow_empty=True)
                if typed != phrase:
                    info("Discard cancelled.")
                    continue
                restore = run_cmd(["git", "restore", "--worktree", "--", *selected], cwd=path, timeout=60)
                if restore.combined:
                    print(restore.combined)
                if restore.returncode == 0:
                    success("Selected unstaged changes were discarded.")
                else:
                    failure("Could not restore the selected paths.")
            elif choice == "4":
                self.revert_commit(path)
            elif choice == "5":
                self.undo_last_local_commit(path)
            elif choice == "6":
                self.amend_last_commit(path)
            elif choice == "7":
                self.backup_cleanup_action(path)
            else:
                warning("Unknown option.")

    def backup_cleanup_action(self, path: Path) -> None:
        git_dir_raw = git_out(path, "rev-parse", "--git-dir")
        if not git_dir_raw:
            failure("Could not locate the Git directory.")
            return
        git_dir = Path(git_dir_raw)
        if not git_dir.is_absolute():
            git_dir = path / git_dir
        patches = sorted((git_dir / "git-create-backups").glob("*.patch")) if (git_dir / "git-create-backups").is_dir() else []
        refs = [
            line.strip()
            for line in git_out(path, "for-each-ref", "--format=%(refname)", "refs/git-create-backups").splitlines()
            if line.strip()
        ]
        if self.dry_run:
            warning("Dry-run mode is ON: backup deletions will only be reported.")
        explain(
            "git-create keeps recovery patches and hidden safety refs under .git/git-create-backups/ "
            "and refs/git-create-backups/.",
            "These preserve discarded work, old branches/tags, and pre-merge commits. They are not "
            "pushed, but they can accumulate over time.",
            "Deleting them may make old objects unreachable. Only remove backups you no longer need.",
        )
        heading("git-create safety backups")
        print(f"  Patches: {len(patches)}  Safety refs: {len(refs)}")
        for patch in patches[-10:]:
            print(f"    patch {patch.name}")
        for ref in refs[-10:]:
            print(f"    ref   {ref}")
        print()
        print("  1) Delete all backup patches")
        print("  2) Delete all safety refs")
        print("  3) Delete patches and safety refs")
        print("  0) Back")
        choice = ask("Choose an option", default="0", allow_empty=True)
        if choice in ("0", ""):
            return
        if choice not in ("1", "2", "3"):
            warning("Unknown option.")
            return
        phrase = "DELETE BACKUPS"
        typed = ask(f'Type "{phrase}" to confirm cleanup', allow_empty=True)
        if typed != phrase:
            info("Backup cleanup cancelled.")
            return
        if self.dry_run:
            info(
                f"DRY RUN: would remove {len(patches) if choice in ('1', '3') else 0} "
                f"patch(es) and {len(refs) if choice in ('2', '3') else 0} safety ref(s)."
            )
            return
        removed_patches = 0
        removed_refs = 0
        if choice in ("1", "3"):
            for patch in patches:
                try:
                    patch.unlink()
                    removed_patches += 1
                except OSError as exc:
                    warning(f"Could not remove {patch}: {exc}")
        if choice in ("2", "3"):
            for ref in refs:
                result = git(path, "update-ref", "-d", ref, timeout=10)
                if result.returncode == 0:
                    removed_refs += 1
                else:
                    warning(f"Could not remove {ref}")
        success(f"Removed {removed_patches} patch(es) and {removed_refs} safety ref(s).")

    def amend_last_commit(self, path: Path) -> None:
        if not git_out(path, "symbolic-ref", "--short", "-q", "HEAD"):
            failure("Detached HEAD; check out a branch before amending.")
            return
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        if git(path, "rev-parse", "--verify", "--quiet", "HEAD").returncode != 0:
            failure("There is no commit to amend.")
            return
        if remote_urls(path):
            if not confirm("Fetch remotes first to verify this commit was never pushed?", True):
                return
            fetch = run_cmd(
                ["git", "fetch", "--all", "--prune"],
                cwd=path,
                timeout=120,
                env_extra=remote_env(),
            )
            if fetch.returncode != 0:
                failure("Fetch failed; cannot prove the commit is unpublished, so amend was cancelled.")
                return
        remote_contains = git_out(path, "branch", "-r", "--contains", "HEAD")
        tag_contains = git_out(path, "tag", "--contains", "HEAD")
        if remote_contains or tag_contains:
            failure("HEAD is contained in a remote branch or tag; amending would rewrite shared history.")
            info("Create a new commit instead, or use a revert commit for pushed history.")
            return
        staged = git_out(path, "diff", "--cached", "--name-only")
        current_subject = git_out(path, "log", "-1", "--format=%s")
        explain(
            "Runs git commit --amend. The last local commit is replaced by a new commit.",
            "Amending fixes the last commit message or adds staged changes to it without creating "
            "a second commit.",
            "It is refused if HEAD exists on a remote branch or tag. Unstaged changes are not "
            "included; only staged content and the message are amended.",
        )
        backup = create_backup_ref(path, f"before-amend-{git_out(path, 'symbolic-ref', '--short', '-q', 'HEAD')}")
        if not backup:
            failure("Could not create a safety ref; amend cancelled.")
            return
        info(f"Safety ref: {backup}")
        if staged:
            info(f"Staged paths that will be added: {staged}")
        else:
            info("No staged changes; only the commit message will change.")
        message = ask(
            "Amended commit message (leave empty to open editor)",
            default=current_subject,
            allow_empty=True,
        )
        if not message and not sys.stdin.isatty():
            failure("A message or interactive editor is required.")
            return
        print("Command: " + col("git commit --amend" + (f" -m {shlex.quote(message)}" if message else ""), "dim"))
        if not confirm("Amend the last commit?", True):
            return
        if message:
            result = run_cmd(["git", "commit", "--amend", "-m", message], cwd=path, timeout=180)
            if result.combined:
                print(result.combined)
            code = result.returncode
        else:
            code = run_interactive(["git", "commit", "--amend"], cwd=path)
        if code == 0:
            success("Last commit amended.")
            info("No push was attempted. A normal push may be rejected if the old commit exists on the remote.")
        else:
            failure("Amend failed; the original commit remains as HEAD.")

    def revert_commit(self, path: Path) -> None:
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        revision = ask("Commit to revert (hash, branch, or HEAD)", default="HEAD")
        verify = git(path, "rev-parse", "--verify", "--quiet", f"{revision}^{{commit}}", timeout=15)
        if verify.returncode != 0:
            failure(f"Unknown commit: {revision}")
            return
        parents = git_out(path, "rev-list", "--parents", "-n", "1", revision).split()
        if len(parents) > 2:
            warning("This is a merge commit; a mainline parent would be required.")
            info("Use git revert -m 1 <commit> manually after reviewing the merge.")
            return
        explain(
            f"Runs git revert --no-edit {revision}. Git creates a new commit that applies "
            "the inverse of the selected commit.",
            "This is the safe way to undo a commit that may already be on the remote: other "
            "clones keep a compatible history because nothing is rewritten.",
            "If the revert conflicts, Git stops and leaves the operation in progress. "
            "Resolve the files, then run git revert --continue, or abort deliberately.",
        )
        if not confirm(f"Create a revert commit for {revision}?", True):
            return
        result = run_cmd(["git", "revert", "--no-edit", revision], cwd=path, timeout=180)
        if result.combined:
            print(result.combined)
        if result.returncode != 0:
            failure("Revert did not complete. No force was used.")
            info("A conflict or merge commit may need manual resolution. Check git status.")
            return
        success("Revert commit created.")
        if "origin" in remote_urls(path) and confirm("Push the revert commit now?", True):
            self.push_current(path)

    def undo_last_local_commit(self, path: Path) -> None:
        current = git_out(path, "symbolic-ref", "--short", "-q", "HEAD")
        if not current:
            failure("Detached HEAD; check out a branch first.")
            return
        if in_progress_operations(path):
            failure("A Git operation is in progress; finish or abort it first.")
            return
        if git(path, "rev-parse", "--verify", "--quiet", "HEAD^").returncode != 0:
            failure("HEAD has no parent commit; there is nothing to undo with a soft reset.")
            return
        if remote_urls(path):
            if not confirm("Fetch remotes first to verify this commit was never pushed?", True):
                return
            fetch = run_cmd(
                ["git", "fetch", "--all", "--prune"],
                cwd=path,
                timeout=120,
                env_extra=remote_env(),
            )
            if fetch.returncode != 0:
                failure("Fetch failed; cannot prove the commit is unpublished, so undo was cancelled.")
                return
        remote_contains = git_out(path, "branch", "-r", "--contains", "HEAD")
        tag_contains = git_out(path, "tag", "--contains", "HEAD")
        if remote_contains or tag_contains:
            failure("HEAD is contained in a remote branch or tag; undoing it would rewrite shared history.")
            info("Use option 4 to create a safe revert commit and push it normally.")
            return
        backup = create_backup_ref(path, f"before-soft-undo-{current}")
        if not backup:
            failure("Could not create a safety ref; undo cancelled.")
            return
        explain(
            "Runs git reset --soft HEAD^ and keeps all changes staged.",
            "This removes the last local commit from history while preserving its files in "
            "the index, so you can edit and commit again.",
            "It is refused when HEAD exists on a remote branch or tag. Local history is rewritten, "
            "but no remote history is changed. The safety ref preserves the old commit.",
        )
        print("Command: " + col("git reset --soft HEAD^", "dim"))
        phrase = "UNDO LAST COMMIT"
        typed = ask(f'Type "{phrase}" to continue', allow_empty=True)
        if typed != phrase:
            info("Undo cancelled.")
            return
        result = run_cmd(["git", "reset", "--soft", "HEAD^"], cwd=path, timeout=30)
        if result.combined:
            print(result.combined)
        if result.returncode == 0:
            success(f"Last commit removed from history; changes are staged. Safety ref: {backup}")
        else:
            failure("Soft reset failed; no history was changed.")

    def stash_action(self) -> None:
