            elif choice == "7":
                if not (path / ".gitmodules").exists():
                    info("No .gitmodules file found.")
                    continue
                explain(
                    "Runs git submodule sync --recursive.",
                    "Copies URL changes from .gitmodules into the local submodule configuration.",
                    "This does not fetch or update submodule commits.",
