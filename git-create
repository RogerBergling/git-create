    "reset": "\033[0m",
    "bold": "\033[1m",
    "dim": "\033[2m",
    "red": "\033[31m",
    "green": "\033[32m",
    "yellow": "\033[33m",
    "blue": "\033[34m",
    "magenta": "\033[35m",
    "cyan": "\033[36m",
}


def col(text: str, *styles: str) -> str:
    if not COLOR_ENABLED or not styles:
        return text
    prefix = "".join(ANSI.get(style, "") for style in styles)
    return f"{prefix}{text}{ANSI['reset']}"


def term_width() -> int:
    try:
        width = shutil.get_terminal_size((100, 24)).columns
    except OSError:
        width = 100
    return max(60, min(width, 118))


def one_line(text: str, limit: int = 160) -> str:
    value = " ".join((text or "").split())
    if len(value) > limit:
        return value[: limit - 3] + "..."
    return value


def wrap(text: str, indent: str = "        ") -> str:
    return textwrap.fill(
        text,
        width=term_width(),
        subsequent_indent=indent,
        break_long_words=False,
        break_on_hyphens=False,
    )


@dataclass
class Check:
    level: str
    label: str
    detail: str = ""
    hint: str = ""

    def as_dict(self) -> Dict[str, str]:
        return {
            "level": self.level,
            "label": self.label,
            "detail": self.detail,
            "hint": self.hint,
        }


@dataclass
class Section:
    title: str
    checks: List[Check] = field(default_factory=list)


@dataclass
class Report:
    title: str
    sections: List[Section] = field(default_factory=list)
    meta: Dict[str, object] = field(default_factory=dict)

    def section(self, title: str) -> Section:
        for section in self.sections:
            if section.title == title:
                return section
        section = Section(title)
        self.sections.append(section)
        return section

    def add(self, title: str, level: str, label: str, detail: str = "", hint: str = "") -> None:
        self.section(title).checks.append(Check(level, label, detail, hint))

    def extend(self, other: "Report") -> None:
        for section in other.sections:
            ours = self.section(section.title)
            ours.checks.extend(section.checks)

    def checks(self) -> List[Check]:
        return [check for section in self.sections for check in section.checks]

    def counts(self) -> Dict[str, int]:
        counts = {"PASS": 0, "WARN": 0, "FAIL": 0, "INFO": 0, "SKIP": 0}
        for check in self.checks():
            counts[check.level] = counts.get(check.level, 0) + 1
        return counts

    def has_failures(self) -> bool:
        return any(check.level == "FAIL" for check in self.checks())

    def as_dict(self) -> Dict[str, object]:
        return {
            "app": APP,
            "version": VERSION,
            "title": self.title,
            "meta": self.meta,
            "summary": self.counts(),
            "sections": [
                {
                    "title": section.title,
                    "checks": [check.as_dict() for check in section.checks],
                }
                for section in self.sections
            ],
        }


LEVEL_MARKER = {
    "PASS": "[OK]",
    "WARN": "[!]",
    "FAIL": "[X]",
    "INFO": "[i]",
    "SKIP": "[-]",
}

LEVEL_STYLE = {
    "PASS": ("green",),
    "WARN": ("yellow",),
    "FAIL": ("red", "bold"),
    "INFO": ("cyan",),
    "SKIP": ("dim",),
}


def print_check(check: Check, show_hint: bool = True) -> None:
    marker = col(LEVEL_MARKER.get(check.level, "[?]"), *LEVEL_STYLE.get(check.level, ()))
    line = f"  {marker} {check.label}"
    if check.detail:
        line += f" - {check.detail}"
    print(wrap(line))
    if check.hint and show_hint:
        print(col(wrap(f"-> {check.hint}", indent="       "), "dim"))


def print_report(report: Report, only_problems: bool = False) -> None:
    print()
    print(col(report.title, "bold"))
    for section in report.sections:
        visible = [
            check
            for check in section.checks
            if not only_problems or check.level in ("FAIL", "WARN")
        ]
        if not visible:
            continue
        print()
        print(col(section.title, "bold", "blue"))
        for check in visible:
            print_check(check)
    counts = report.counts()
    print()
    print(
        "Summary: "
        + col(f"{counts['PASS']} passed", "green")
        + ", "
        + col(f"{counts['WARN']} warning(s)", "yellow")
        + ", "
        + col(f"{counts['FAIL']} failure(s)", "red")
    )


def heading(title: str) -> None:
    print()
    print(col(title, "bold"))
    print(col("-" * min(len(title), term_width()), "dim"))


def success(message: str) -> None:
    print(col("[OK] ", "green") + message)


def warning(message: str) -> None:
    print(col("[!] ", "yellow") + message)


def failure(message: str) -> None:
    print(col("[X] ", "red") + message)


def info(message: str) -> None:
    print(col("[i] ", "cyan") + message)


def explain(what: str, why: str, safety: str = "") -> None:
    """Show a beginner-friendly explanation before an action or command."""
    print()
    print(col("What this does:", "bold"))
    print(wrap("  " + what, indent="  "))
    print(col("Why:", "bold"))
    print(wrap("  " + why, indent="  "))
    if safety:
        print(col("Safety:", "yellow"))
        print(wrap("  " + safety, indent="  "))


