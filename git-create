def scan_repositories(root: Path, max_depth: int = DEFAULT_DEPTH) -> List[Dict[str, object]]:
    root = root.resolve()
    results: List[Dict[str, object]] = []
    skip_dirs = {
        ".git",
        "node_modules",
        ".venv",
        "venv",
        "__pycache__",
        "dist",
        "build",
        "target",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".cache",
        "vendor",
    }
    for dirpath, dirnames, filenames in os.walk(root):
        current = Path(dirpath)
        try:
            relative = current.relative_to(root)
            depth = 0 if str(relative) == "." else len(relative.parts)
        except ValueError:
            depth = 0
        if depth >= max_depth:
            dirnames[:] = []
        if ".git" in dirnames or ".git" in filenames:
            info = quick_repo_info(current)
            if info is not None:
                results.append(info)
        dirnames[:] = sorted(name for name in dirnames if name not in skip_dirs)
    results.sort(key=lambda item: str(item["path"]).lower())
    return results


def collect_repo_info(root: Path) -> Dict[str, object]:
    entries = status_entries(root)
    counts = status_counts(entries)
    branch = git_out(root, "symbolic-ref", "--short", "-q", "HEAD")
    upstream = git_out(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    worktrees: List[Dict[str, object]] = []
    current: Dict[str, object] = {}
    for line in git_out(root, "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if current.get("path"):
                worktrees.append(current)
            current = {}
        elif " " in line:
            key, value = line.split(" ", 1)
            if key in ("worktree", "HEAD", "branch"):
                current["path" if key == "worktree" else key] = value
            elif key in ("bare", "detached", "locked", "prunable"):
                current[key] = True
    submodules = [
        line
        for line in git_out(root, "submodule", "status", "--recursive").splitlines()
        if line.strip()
    ]
    stashes = [
        line
        for line in git_out(root, "stash", "list").splitlines()
        if line.strip()
    ]
    return {
        "path": str(root),
        "branch": branch or None,
        "detached": not bool(branch),
        "upstream": upstream or None,
        "status": {
            "staged": counts["staged"],
            "unstaged": counts["unstaged"],
            "untracked": counts["untracked"],
            "conflicts": counts["conflicts"],
            "clean": not bool(entries),
        },
        "remotes": remote_urls(root),
        "local_branches": local_branch_names(root),
        "remote_branches": remote_branch_names(root),
        "tags": tag_names(root),
        "stashes": stashes,
        "worktrees": worktrees,
        "submodules": submodules,
        "last_commit": git_out(root, "log", "-1", "--format=%h %s"),
    }


def quick_repo_info(path: Path) -> Optional[Dict[str, object]]:
    root = detect_git_root(path)
    if root is None or root != path.resolve():
        return None
    branch = git_out(path, "symbolic-ref", "--short", "-q", "HEAD") or "detached"
    entries = status_entries(path)
    counts = status_counts(entries)
    ahead = behind = 0
    upstream = git_out(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream:
        result = git(path, "rev-list", "--left-right", "--count", f"HEAD...{upstream}", timeout=10)
        if result.returncode == 0:
            values = result.out.split()
            if len(values) == 2:
                ahead, behind = int(values[0]), int(values[1])
    last = git_out(path, "log", "-1", "--format=%h %s")
    remotes = remote_urls(path)
    return {
        "path": str(root),
        "name": root.name,
        "branch": branch,
        "dirty": bool(entries),
        "changed": len(entries),
        "staged": counts["staged"],
        "unstaged": counts["unstaged"],
        "untracked": counts["untracked"],
        "ahead": ahead,
        "behind": behind,
        "upstream": upstream,
        "origin": remotes.get("origin", ""),
        "last_commit": last,
    }


def print_scan_results(root: Path, repos: Sequence[Dict[str, object]], depth: int) -> None:
    heading(f"Repositories under {root}")
    if not repos:
        info("No Git repositories found. Increase depth or choose another folder.")
        return
    print(f"Found {len(repos)} repository/repositories (depth {depth}).")
    print(
        col(
            "Legend: branch = current branch; clean/dirty = uncommitted changes; "
            "ahead/behind = local commits vs the tracked remote branch; origin = remote URL.",
            "dim",
        )
    )
    for index, repo in enumerate(repos, 1):
        state = "dirty" if repo["dirty"] else "clean"
        print()
        print(f"  [{index:>2}] {col(str(repo['name']), 'bold')}  ({repo['branch']}, {state})")
        print(f"       {repo['path']}")
        print(
            f"       changed={repo['changed']} untracked={repo['untracked']} "
            f"ahead={repo['ahead']} behind={repo['behind']}"
        )
        if repo["origin"]:
            print(f"       origin={one_line(str(repo['origin']), 100)}")
        if repo["last_commit"]:
            print(f"       last={one_line(str(repo['last_commit']), 100)}")


