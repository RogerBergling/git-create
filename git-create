@dataclass
class CmdResult:
    args: List[str]
    returncode: int
    out: str
    err: str
    timed_out: bool = False

    @property
    def combined(self) -> str:
        return (self.out + ("\n" if self.out and self.err else "") + self.err).strip()


def run_cmd(
    args: Sequence[object],
    cwd: Optional[Path] = None,
    timeout: int = 30,
    env_extra: Optional[Dict[str, str]] = None,
    input_text: Optional[str] = None,
) -> CmdResult:
    cmd = [str(arg) for arg in args]
    env = os.environ.copy()
    env.setdefault("GIT_TERMINAL_PROMPT", "0")
    if env_extra:
        env.update(env_extra)
    try:
        result = subprocess.run(
            cmd,
            cwd=str(cwd) if cwd else None,
            env=env,
            input=input_text,
            stdin=None if input_text is not None else subprocess.DEVNULL,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=timeout,
        )
        return CmdResult(cmd, result.returncode, result.stdout or "", result.stderr or "")
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout or ""
        err = exc.stderr or ""
        if isinstance(out, bytes):
            out = out.decode("utf-8", "replace")
        if isinstance(err, bytes):
            err = err.decode("utf-8", "replace")
        return CmdResult(cmd, 124, out, (err + "\ncommand timed out").strip(), True)
    except FileNotFoundError:
        return CmdResult(cmd, 127, "", f"command not found: {cmd[0]}")
    except OSError as exc:
        return CmdResult(cmd, 126, "", str(exc))


def run_cmd_bytes(args: Sequence[object], cwd: Optional[Path] = None, timeout: int = 30) -> Optional[bytes]:
    """Run a command and return stdout bytes, or None on failure."""
    try:
        result = subprocess.run(
            [str(arg) for arg in args],
            cwd=str(cwd) if cwd else None,
            env=os.environ.copy(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout if result.returncode == 0 else None


def run_interactive(args: Sequence[object], cwd: Optional[Path] = None) -> int:
    cmd = [str(arg) for arg in args]
    try:
        return subprocess.run(cmd, cwd=str(cwd) if cwd else None, env=os.environ.copy()).returncode
    except FileNotFoundError:
        failure(f"Command not found: {cmd[0]}")
        return 127
    except OSError as exc:
        failure(str(exc))
        return 126


def git(path: Path, *args: object, timeout: int = 30, env_extra: Optional[Dict[str, str]] = None) -> CmdResult:
    return run_cmd(["git", "-C", str(path), *args], timeout=timeout, env_extra=env_extra)


def git_out(path: Path, *args: object) -> str:
    result = git(path, *args)
    return result.out.strip() if result.returncode == 0 else ""


def remote_env() -> Dict[str, str]:
    ssh_command = os.environ.get("GIT_SSH_COMMAND", "ssh")
    return {"GIT_SSH_COMMAND": f"{ssh_command} -o BatchMode=yes -o ConnectTimeout=10"}


def which_gh() -> Optional[str]:
    return shutil.which("gh")


# ---------------------------------------------------------------------------
# Config and key helpers
# ---------------------------------------------------------------------------


def parse_config_entries(raw: str) -> Dict[str, List[str]]:
    entries: Dict[str, List[str]] = {}
    for item in raw.split("\0"):
        if not item:
            continue
        key, separator, value = item.partition("\n")
        if not separator:
            key, value = item, ""
        entries.setdefault(key.lower(), []).append(value)
    return entries


def read_global_config() -> Dict[str, List[str]]:
    result = run_cmd(["git", "config", "--global", "--null", "--list"], timeout=10)
    if result.returncode != 0:
        return {}
    return parse_config_entries(result.out)


def read_local_config(root: Path) -> Dict[str, List[str]]:
    result = git(root, "config", "--local", "--null", "--list", timeout=10)
    if result.returncode != 0:
        return {}
    return parse_config_entries(result.out)


def cfg_get(config: Dict[str, List[str]], key: str, default: str = "") -> str:
    values = config.get(key.lower())
    if not values:
        return default
    return values[0]


def find_existing_path(value: str) -> Optional[Path]:
    expanded = os.path.expanduser(os.path.expandvars(value))
    path = Path(expanded)
    candidates = [path] if path.is_absolute() else [Path.cwd() / path, HOME / path]
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return None


def resolve_public_key(value: str) -> Tuple[Optional[Path], Optional[str], str]:
    """Return (path, public key text, error)."""
    if not value or not value.strip():
        return None, None, "not configured"
    value = value.strip()
    if value.startswith(KEY_TYPES):
        return None, value, ""
    path = find_existing_path(value)
    if path is None:
        return None, None, f"file not found: {value}"
    if not path.is_file():
        return None, None, f"not a file: {value}"
    try:
        text = path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError as exc:
        return None, None, str(exc)
    if "PRIVATE KEY" in text:
        return path, None, "this is a private key; configure the .pub file instead"
    if not text.startswith(KEY_TYPES):
        return path, None, "file does not contain an SSH public key"
    return path, text, ""


def key_data(text: str) -> str:
    parts = text.split()
    return " ".join(parts[:2]) if len(parts) >= 2 else text


def allowed_signers_key_data(line: str) -> str:
    """Extract 'ssh-type key-data' from an allowed_signers line."""
    tokens = line.split()
    for index, token in enumerate(tokens):
        if token.startswith(KEY_TYPES) and index + 1 < len(tokens):
            return " ".join(tokens[index : index + 2])
    return ""


def key_fingerprint(path: Optional[Path]) -> str:
    if path is None or not shutil.which("ssh-keygen"):
        return ""
    result = run_cmd(["ssh-keygen", "-lf", str(path)], timeout=5)
    if result.returncode != 0:
        return ""
    return one_line(result.out, 90)


def private_key_state(public_path: Optional[Path]) -> Tuple[str, str, str]:
    if public_path is None or public_path.suffix != ".pub":
        return "SKIP", "", ""
    private_path = public_path.with_suffix("")
    if not private_path.exists():
        return (
            "WARN",
            f"private key not found next to {public_path.name}",
            "Git needs the private key for SSH signing. It may be held by ssh-agent, but usually the matching private key must exist.",
        )
    try:
        mode = stat.S_IMODE(private_path.stat().st_mode)
    except OSError:
        mode = 0
    if mode & 0o077:
        return (
            "WARN",
            f"private key permissions are too open ({oct(mode)})",
            f"Run: chmod 600 {private_path}",
        )
    return "PASS", f"private key present ({oct(mode)})", ""


def signing_url_rewrite(config: Dict[str, List[str]]) -> bool:
    for key, values in config.items():
        if key.startswith("url.") and key.endswith(".insteadof"):
            base = key[4 : -len(".insteadof")]
            if base.rstrip("/") != "git@github.com:":
                continue
            for value in values:
                if value.rstrip("/").startswith("https://github.com"):
                    return True
    return False


def set_global_config(key: str, value: str, add: bool = False) -> bool:
    args = ["git", "config", "--global"]
    args.append("--add" if add else "--replace-all")
    args.extend([key, value])
    result = run_cmd(args, timeout=10)
    if result.returncode == 0:
        success(f"set {key} = {value}")
        return True
    failure(f"could not set {key}: {one_line(result.combined)}")
    return False


def set_local_config(root: Path, key: str, value: str) -> bool:
    result = run_cmd(
        ["git", "-C", str(root), "config", "--local", "--replace-all", key, value],
        timeout=10,
    )
    if result.returncode == 0:
        success(f"set local {key} = {value}")
        return True
    failure(f"could not set local {key}: {one_line(result.combined)}")
    return False


def unset_local_config(root: Path, key: str) -> bool:
    result = run_cmd(
        ["git", "-C", str(root), "config", "--local", "--unset-all", key],
        timeout=10,
    )
    if result.returncode in (0, 5):
        success(f"removed local {key}")
        return True
    failure(f"could not remove local {key}: {one_line(result.combined)}")
    return False


