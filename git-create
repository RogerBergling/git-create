def cli_scan(args: argparse.Namespace) -> int:
    root = ask_path_from_arg(args.path)
    if not root.exists() or not root.is_dir():
        failure(f"Not a directory: {root}")
        return 2
    depth = max(1, min(int(args.depth), 10))
    repos = scan_repositories(root, depth)
    if args.json:
        print(
            json.dumps(
                {
                    "app": APP,
                    "version": VERSION,
                    "root": str(root),
                    "depth": depth,
                    "repositories": repos,
                },
                indent=2,
                ensure_ascii=False,
            )
        )
    else:
        print_scan_results(root, repos, depth)
    return 0


def cli_secrets(args: argparse.Namespace) -> int:
    path = ask_path_from_arg(args.path)
    root = detect_git_root(path)
    if root is None:
        message = f"Not a Git repository: {path}"
        if args.json:
            print(json.dumps({"error": message}, indent=2))
        else:
            failure(message)
        return 2
    result = scan_history_secrets(
        root,
        max_commits=args.max_commits,
        max_blobs=args.max_blobs,
    )
    result.update({"app": APP, "version": VERSION, "path": str(root), "command": "secrets"})
    findings = result.get("findings") or []
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        heading(f"History secret scan: {root}")
        print(
            f"  Commits scanned: {result['commits_scanned']}/{result['commits_total']}  "
            f"Blobs scanned: {result['blobs_scanned']}/{result['blobs_total']}  "
            f"Bytes: {format_size(int(result['bytes_scanned']))}"
        )
        if findings:
            failure(f"Potential secrets found in {len(findings)} history location(s).")
            for item in findings[:50]:
                if isinstance(item, dict):
                    line = int(item.get("line") or 0)
                    location = str(item.get("path")) + (f":{line}" if line else "")
                    print(
                        f"  - {location} "
                        f"({item.get('kind')}, blob {item.get('object')})"
                    )
            info("Rotate any real credential first; then consider history rewriting with git filter-repo.")
        else:
            success("No common secret patterns found in the scanned history.")
        if result.get("truncated"):
            warning("History scan limits were reached; older or larger blobs were not fully scanned.")
    return 1 if findings else 0


def ask_path_from_arg(value: str) -> Path:
    path = Path(os.path.expanduser(os.path.expandvars(value)))
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.resolve()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Safe menu-driven Git/GitHub project assistant. Run without arguments for the menu.",
        epilog="Examples: git-create check --offline; git-create info --json; git-create audit --json; git-create scan ~/Projects --depth 3; git-create secrets .",
    )
    parser.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    parser.add_argument("--no-color", action="store_true", help="disable ANSI colors")
    parser.add_argument("--dry-run", action="store_true", help="show worktree/submodule/remote/backup commands without executing them")
    parser.add_argument("--debug", action="store_true", help="show Python tracebacks on unexpected errors")
    subparsers = parser.add_subparsers(dest="command")

    check_parser = subparsers.add_parser("check", help="verify a repository non-interactively")
    check_parser.add_argument("path", nargs="?", default=".", help="repository path (default: current directory)")
    check_parser.add_argument("--offline", action="store_true", help="skip network checks")
    check_parser.add_argument("--json", action="store_true", help="machine-readable output")
    check_parser.add_argument("--strict", action="store_true", help="exit non-zero on warnings too")
    check_parser.set_defaults(func=cli_check)

    audit_parser = subparsers.add_parser("audit", help="read-only GitHub protection/secret/workflow audit")
    audit_parser.add_argument("path", nargs="?", default=".", help="repository path (default: current directory)")
    audit_parser.add_argument("--json", action="store_true", help="machine-readable output")
    audit_parser.set_defaults(func=cli_audit)

    info_parser = subparsers.add_parser("info", help="show repository state as text or JSON")
    info_parser.add_argument("path", nargs="?", default=".", help="repository path (default: current directory)")
    info_parser.add_argument("--json", action="store_true", help="machine-readable output")
    info_parser.set_defaults(func=cli_info)

    scan_parser = subparsers.add_parser("scan", help="find Git repositories under a folder")
    scan_parser.add_argument("path", nargs="?", default=".", help="folder to scan (default: current directory)")
    scan_parser.add_argument("--depth", type=int, default=DEFAULT_DEPTH, help="maximum depth (default: 3)")
    scan_parser.add_argument("--json", action="store_true", help="machine-readable output")
    scan_parser.set_defaults(func=cli_scan)

    secrets_parser = subparsers.add_parser("secrets", help="scan reachable Git history for common secrets")
    secrets_parser.add_argument("path", nargs="?", default=".", help="repository path (default: current directory)")
    secrets_parser.add_argument("--json", action="store_true", help="machine-readable output")
    secrets_parser.add_argument("--max-commits", type=int, default=500, help="maximum commits to inspect (default: 500)")
    secrets_parser.add_argument("--max-blobs", type=int, default=2000, help="maximum unique blobs to scan (default: 2000)")
    secrets_parser.set_defaults(func=cli_secrets)

    for subparser in (check_parser, audit_parser, info_parser, scan_parser, secrets_parser):
        subparser.add_argument(
            "--no-color",
            action="store_true",
            default=argparse.SUPPRESS,
            help="disable ANSI colors (also accepted before the subcommand)",
        )
        subparser.add_argument(
            "--debug",
            action="store_true",
            default=argparse.SUPPRESS,
            help="show Python tracebacks on unexpected errors",
        )
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    global COLOR_ENABLED
    if getattr(args, "no_color", False):
        COLOR_ENABLED = False
    try:
        if getattr(args, "func", None):
            return int(args.func(args))
        return App(dry_run=getattr(args, "dry_run", False)).run()
    except KeyboardInterrupt:
        print("\nCancelled.")
        return 130
    except BrokenPipeError:
        return 0
    except Exception as exc:  # noqa: BLE001 - top-level safety net
        failure(f"Unexpected error: {exc}")
        if getattr(args, "debug", False):
            import traceback

            traceback.print_exc()
        else:
            info("Run with --debug for a traceback.")
        return 1


if __name__ == "__main__":
    sys.exit(main())
